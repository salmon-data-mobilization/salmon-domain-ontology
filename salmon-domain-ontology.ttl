    owl:inverseOf smn:hasDeme .

smn:fusiform a owl:Class ;
    rdfs:label "Fusiform"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:BodyShape .

smn:hasCycleLine a owl:ObjectProperty ;
    rdfs:label "has cycle line"@en ;
    obo:IAO_0000115 "Relates a Conservation Unit, population, or stock whose age at return is invariant to the cycle line that constitutes it as a reproductive lineage."@en ;
    rdfs:comment "This property makes the strong claim: the year series is closed under reproduction, so the line is a lineage and not merely a stratification. It is valid only where age at return is invariant — Pink Salmon, which return at age 2. Assigning a line to an individual fish is likewise only valid under that same invariance. Where age at return varies, as in Fraser Sockeye, use smn:stratifiedByCycleLine on the return-year record instead; a fish spawned on one line can return on another, so the class is not closed and the claim would be false."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso smn:CycleLineScheme .

smn:hasEventType a owl:ObjectProperty ;
    rdfs:label "has event type"@en ;
    rdfs:domain smn:SamplingEvent ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range smn:EventType .

smn:hasJuvenileFreshwaterResidenceDuration a owl:ObjectProperty ;
    rdfs:label "has juvenile freshwater residence duration"@en ;
    obo:IAO_0000115 "Relates a named life-history type to its value on the juvenile freshwater residence duration axis: how long juveniles remain in fresh water between emergence and seaward migration."@en ;
    rdfs:comment "A vocabulary-structure property: its subject is a concept in smn:LifeHistoryTypeScheme, and it records the decomposition that defines that named type rather than an observation about any fish. Domain is omitted rather than asserted as skos:Concept, which would be true of every concept in module 07 and therefore say nothing. The name carries \"duration\" because without it the property reads as whether the group has a freshwater residence at all, which is true of every anadromous salmon and therefore says nothing; it carries \"juvenile\" because adults also reside in fresh water, on a migration this axis does not measure."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso smn:JuvenileFreshwaterResidenceDurationScheme .

smn:hasJuvenileRearingHabitat a owl:ObjectProperty ;
    rdfs:label "has juvenile rearing habitat"@en ;
    obo:IAO_0000115 "Relates a named life-history type to its value on the juvenile rearing habitat axis: the kind of fresh water in which juveniles rear before migrating to sea."@en ;
    rdfs:comment "A vocabulary-structure property, like smn:hasJuvenileFreshwaterResidenceDuration. The value is a kind of water, never a named water body: smn:hasJuvenileRearingHabitat asserts lake-versus-flowing-water, and the unqualified name a future property relating a population to an actual lake or river would want is deliberately left free. \"Rearing\" rather than \"nursery\" because rearing habitat is the settled term for the juvenile freshwater growth phase in the Pacific salmon literature, while nursery area carries a distinct, largely marine and estuarine sense. A named type may carry no value on this axis: smn:SockeyeSeaTypeLifeHistory does not."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso smn:JuvenileRearingHabitatScheme .

smn:hasLifeHistory a owl:ObjectProperty ;
    rdfs:label "has life history"@en ;
    obo:IAO_0000115 "Relates a Conservation Unit, population, or stock to a named life-history type from smn:LifeHistoryTypeScheme."@en ;
    rdfs:comment "One of the three life-history properties (Brett Johnson, 2026-08-24): this one assigns a named type, and smn:hasJuvenileFreshwaterResidenceDuration and smn:hasJuvenileRearingHabitat decompose what that type means. No generic axis-value property is minted. Assertion is at Conservation Unit, population, or stock level, not for an individual fish (Brett Johnson, 2026-08-17). The range is skos:Concept because the values are SKOS concepts; take them from smn:LifeHistoryTypeScheme, whose members are species-scoped."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso smn:LifeHistoryTypeScheme .

smn:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "has measurement"@en ;
    rdfs:domain sosa:FeatureOfInterest ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range smn:Measurement .

smn:observedTaxonFamily a owl:ObjectProperty ;
    rdfs:label "observed taxon family"@en ;
    rdfs:domain sosa:Observation ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range obo:NCBITaxon_8015 .

smn:observedTaxonSpecies a owl:ObjectProperty ;
    rdfs:label "observed taxon species"@en ;
    rdfs:domain sosa:Observation ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range obo:NCBITaxon_8018 .

smn:orbitalLength a owl:Class ;
    rdfs:label "Orbital length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:FishLength .

smn:populationOf a owl:ObjectProperty ;
    rdfs:label "population of"@en ;
    obo:IAO_0000115 "Relates a population to the reporting or management stratum it belongs to."@en ;
    rdfs:domain smn:Population ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range smn:ReportingOrManagementStratum ;
    owl:inverseOf smn:hasPopulation .

smn:seiningEvent a owl:Class ;
    rdfs:label "Seining event"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:FishingType .

smn:standardLength a owl:Class ;
    rdfs:label "Standard length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:FishLength .

smn:stratifiedByCycleLine a owl:ObjectProperty ;
    rdfs:label "stratified by cycle line"@en ;
    obo:IAO_0000115 "Relates a data record or observation carrying a return year to the cycle line that year falls in, as a stratification of the year series only."@en ;
    rdfs:comment "The weak, always-safe claim: the subject year belongs to that residue class under the declared year basis. It asserts nothing about reproductive independence and nothing about the fish, which is why it is the correct property for a population with variable age at return such as Fraser Sockeye. Use smn:hasCycleLine, on the population rather than the record, where age at return is invariant and the line really is a lineage. Domain is deliberately omitted for the same reason as on smn:broodYear: the subject may be an observation or a table row."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso smn:CycleLineScheme,
        smn:ReturnYearBasis .

smn:totalLength a owl:Class ;
    rdfs:label "Total length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:FishLength .

sosa:Sample skos:closeMatch dwc:MaterialEntity,
        dwc:MaterialSample .

<https://w3id.org/iadopt/ont/Entity> skos:closeMatch sosa:FeatureOfInterest .

smn:AggregatedMeasurement a owl:Class ;
    rdfs:label "Aggregated measurement"@en ;
    rdfs:comment "The based-on restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration. The specific constraint — values must be method concepts at or below smn:EnumerationMethod in smn:MethodScheme — is normative and lives in ontology/shapes/method-shapes.ttl (smn:AggregatedMeasurementShape), expressed as a skos:broader* path, since someValuesFrom cannot range over concept individuals."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty smn:basedOn ;
            owl:someValuesFrom sosa:Procedure ],
        smn:Measurement .

smn:BodyShape a owl:Class ;
    rdfs:label "Body shape"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:Characteristic .

smn:CountStatisticalModifier a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "The reported value is the number of summarized observations or individuals, as counted rather than estimated."@en ;
    skos:inScheme smn:StatisticalModifierScheme ;
    skos:prefLabel "Count"@en ;
    skos:topConceptOf smn:StatisticalModifierScheme .

smn:EnumerationMethod a skos:Concept,
        sosa:Procedure ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:EnumerationMethod."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "A method used to enumerate or count salmon in the field."@en ;
    skos:inScheme smn:MethodScheme ;
    skos:prefLabel "Enumeration method"@en ;
    skos:topConceptOf smn:MethodScheme .

smn:ExploitationRate a owl:Class ;
    rdfs:label "Exploitation rate"@en ;
    obo:IAO_0000115 "The proportion of returning adult salmon removed by fishing activity over a defined period."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html."@en ;
    dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:TargetOrLimitRateOrAbundance .

smn:FishForkLengthMeasurementMethod a skos:Concept,
        sosa:Procedure ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader smn:FishLengthMeasurementMethod ;
    skos:inScheme smn:MethodScheme ;
    skos:prefLabel "Fish fork-length measurement method"@en .

smn:FishingType a owl:Class ;
    rdfs:label "Fishing type"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:EventType .

smn:GeographicFeature a owl:Class ;
    rdfs:label "Geographic feature"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf geo:Feature .

smn:LakeRearingHabitat a skos:Concept ;
    obo:IAO_0000119 "Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, whose lake-type Sockeye Salmon rear in nursery lakes."@en ;
    dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader smn:JuvenileRearingHabitat ;
    skos:definition "Rearing habitat in which juveniles grow in a lake, typically a nursery lake associated with the spawning tributary."@en ;
    skos:inScheme smn:JuvenileRearingHabitatScheme ;
    skos:prefLabel "Lake rearing habitat"@en .

smn:Life-HistoryCharacteristic a owl:Class ;
    rdfs:label "Life-history characteristic"@en ;
    rdfs:comment "A characteristic that can be observed, not a controlled value. Do not use this IRI as the vocabulary identifier for a coded life-history column: the values belong to module 07's smn:LifeHistoryTypeScheme and its two axis schemes, smn:JuvenileFreshwaterResidenceDurationScheme and smn:JuvenileRearingHabitatScheme, and a code list needs a skos:ConceptScheme, not an owl:Class (CONVENTIONS sections 3 and 4)."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:Characteristic .

smn:MaximumStatisticalModifier a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/maximum> ;
    skos:definition "The reported value is the maximum of the summarized observations."@en ;
    skos:inScheme smn:StatisticalModifierScheme ;
    skos:prefLabel "Maximum"@en ;
    skos:topConceptOf smn:StatisticalModifierScheme .

smn:MeanStatisticalModifier a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/average> ;
    skos:definition "The reported value is the arithmetic mean of the summarized observations."@en ;
    skos:inScheme smn:StatisticalModifierScheme ;
    skos:prefLabel "Mean"@en ;
    skos:topConceptOf smn:StatisticalModifierScheme .

smn:MedianStatisticalModifier a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/median> ;
    skos:definition "The reported value is the median of the summarized observations."@en ;
    skos:inScheme smn:StatisticalModifierScheme ;
    skos:prefLabel "Median"@en ;
    skos:topConceptOf smn:StatisticalModifierScheme .

smn:MinimumStatisticalModifier a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/minimum> ;
    skos:definition "The reported value is the minimum of the summarized observations."@en ;
    skos:inScheme smn:StatisticalModifierScheme ;
    skos:prefLabel "Minimum"@en ;
    skos:topConceptOf smn:StatisticalModifierScheme .

smn:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf sosa:Observation .

smn:PeakStatisticalModifier a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "The reported value is the peak (highest single observation event) across the summarized series, such as a peak live count in a spawner survey."@en ;
    skos:inScheme smn:StatisticalModifierScheme ;
    skos:prefLabel "Peak"@en ;
    skos:topConceptOf smn:StatisticalModifierScheme .

smn:ReferencePoint a owl:Class ;
    rdfs:label "Reference point"@en ;
    obo:IAO_0000115 "A target or limit used to guide management actions."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. Introduction to Stock Assessment - Glossary. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000030 ;
    skos:closeMatch <https://w3id.org/iadopt/ont/Constraint> .

smn:SalmonLifeStage a owl:Class ;
    rdfs:label "Salmon life stage"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:Characteristic .

smn:SamplingEvent a owl:Class ;
    rdfs:label "Sampling event"@en ;
    obo:IAO_0000115 "A sampling activity that targets a geographic feature, yields a sample, and records a time."@en ;
    rdfs:comment "A sampling activity that targets a geographic feature, yields a sample, and records a time."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:hasFeatureOfInterest ;
            owl:someValuesFrom geo:Feature ],
        [ a owl:Restriction ;
            owl:onProperty sosa:hasResult ;
            owl:someValuesFrom sosa:Sample ],
        [ a owl:Restriction ;
            owl:onProperty sosa:resultTime ;
            owl:someValuesFrom time:Instant ],
        sosa:Sampling .

smn:SubyearlingFreshwaterResidence a skos:Concept ;
    obo:IAO_0000119 "Beacham, T.D. and Withler, R.E. 2017, Population structure of sea-type and lake-type sockeye salmon and kokanee in the Fraser River and Columbia River drainages, PLOS ONE 12(9):e0183713, which states that sea-type juveniles do not spend a winter in fresh water and thus lack a freshwater annulus."@en ;
    dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:altLabel "Subyearling migrant"@en ;
    skos:broader smn:JuvenileFreshwaterResidenceDuration ;
    skos:definition "Juvenile freshwater residence of less than one year: juveniles migrate seaward during their first year, without overwintering in fresh water, and therefore carry no freshwater annulus on the scale."@en ;
    skos:inScheme smn:JuvenileFreshwaterResidenceDurationScheme ;
    skos:prefLabel "Subyearling freshwater residence"@en ;
    skos:scopeNote "The freshwater annulus is the operational test, and it is the reason this axis is cut here rather than at some other duration. Two boundaries are easy to get wrong. The incubation winter spent in the gravel as egg and alevin lays down no annulus and does not count against this value. And this value means no freshwater WINTER, not no freshwater rearing: a subyearling migrant may spend weeks or months in flowing water, sloughs, or the estuary first, which is why it can and does carry a value on the rearing habitat axis. A dataset that keys its equivalent category on residency duration rather than on the annulus is therefore measuring something adjacent, not the same thing, and the two usually but not always agree."@en .

smn:SurveyEvent a owl:Class ;
    rdfs:label "Survey event"@en ;
    obo:IAO_0000115 "A field event that collects information about fish populations to evaluate status and support management decisions."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. About the Sustainability Survey for Fisheries. https://www.dfo-mpo.gc.ca/reports-rapports/regs/sff-cpd/survey-sondage/about-propos-en.html."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/reports-rapports/regs/sff-cpd/survey-sondage/about-propos-en.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf dwc:Event ;
    skos:closeMatch sosa:Sampling .

smn:TargetOrLimitRateOrAbundance a owl:Class ;
    rdfs:label "Target or limit rate or abundance"@en ;
    obo:IAO_0000115 "A value specification representing a policy- or model-defined target or limit, such as TAC, UMSY, or reference points."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:TargetOrLimitRateOrAbundance."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000109 .

smn:TotalStatisticalModifier a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/cumulative> ;
    skos:definition "The reported value is the sum or cumulative total of the summarized observations, such as an annual total catch or cumulative escapement."@en ;
    skos:inScheme smn:StatisticalModifierScheme ;
    skos:prefLabel "Total"@en ;
    skos:topConceptOf smn:StatisticalModifierScheme .

smn:basedOn a owl:ObjectProperty ;
    rdfs:label "based on"@en ;
    rdfs:domain smn:AggregatedMeasurement ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range sosa:Procedure .

smn:broodYear a qb:DimensionProperty,
        owl:DatatypeProperty ;
    rdfs:label "brood year"@en ;
    obo:IAO_0000115 "Relates a data record or observation to the calendar year that identifies a salmon cohort by the spawning year of its parents."@en ;
    obo:IAO_0000119 "Adapted from the Government of Canada Pacific Salmon Glossary definition of brood year."@en ;
    dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
    qb:concept smn:BroodYearBasis ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range xsd:gYear ;
    rdfs:seeAlso time:inXSDgYear,
        smn:BroodYearBasis .

smn:catchYear a qb:DimensionProperty,
        owl:DatatypeProperty ;
    rdfs:label "catch year"@en ;
    obo:IAO_0000115 "Relates a data record or observation to the calendar year in which the represented fishery catch occurred."@en ;
    obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology term gcdfo:CatchYear."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    qb:concept smn:CatchYearBasis ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range xsd:gYear ;
    rdfs:seeAlso time:inXSDgYear,
        smn:CatchYearBasis .

smn:forkLength a owl:Class ;
    rdfs:label "Fork length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:FishLength .

smn:hasDeme a owl:ObjectProperty ;
    rdfs:label "has deme"@en ;
    obo:IAO_0000115 "Relates a population to one of its constituent demes."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:hasDeme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:domain smn:Population ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range smn:Deme ;
    rdfs:subPropertyOf obo:RO_0002351 .

smn:hasPopulation a owl:ObjectProperty ;
    rdfs:label "has population"@en ;
    obo:IAO_0000115 "Relates a reporting or management stratum to one of its constituent populations."@en ;
    rdfs:domain smn:ReportingOrManagementStratum ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range smn:Population ;
    rdfs:subPropertyOf obo:RO_0002351 .

smn:returnYear a qb:DimensionProperty,
        owl:DatatypeProperty ;
    rdfs:label "return year"@en ;
    obo:IAO_0000115 "Relates a data record or observation to the calendar year in which members of a salmon cohort make the adult return relevant to the dataset's declared location or event."@en ;
    obo:IAO_0000119 "Pacific Salmon Commission Fraser River Sockeye Salmon Stock-Recruitment Data."@en ;
    dcterms:source <https://www.psc.org/publications/data/fraser-sockeye-stock-recruit-dataset/> ;
    qb:concept smn:ReturnYearBasis ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range xsd:gYear ;
    rdfs:seeAlso time:inXSDgYear,
        smn:ReturnYearBasis .

obo:NCBITaxon_8018 rdfs:subClassOf obo:NCBITaxon_8015 .

geo:Feature rdfs:subClassOf sosa:FeatureOfInterest .

smn:Abundance a owl:Class ;
    rdfs:label "Abundance"@en ;
    obo:IAO_0000115 "A characteristic representing the quantity of salmon or other organisms associated with a defined entity, place, and time."@en ;
    dcterms:source <http://qudt.org/vocab/quantitykind/Population> ;
    rdfs:comment "Use units, statistical modifiers, measurement context, and procedures to distinguish absolute counts, relative indices, estimates, expansions, and other representations. Those qualifiers do not change the reusable characteristic into a compound OWL class."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso dwc:individualCount ;
    rdfs:subClassOf smn:Characteristic ;
    skos:broadMatch <http://qudt.org/vocab/quantitykind/Count> ;
    skos:closeMatch <http://qudt.org/vocab/quantitykind/Population> .

smn:Deme a owl:Class ;
    rdfs:label "Deme"@en ;
    obo:IAO_0000115 "A local interbreeding group of organisms within a species. In salmon, a deme typically corresponds to a spawning population at a specific site. Demes are the finest biological unit and make up populations."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:Deme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf dwc:Organism .

smn:EventType a owl:Class ;
    rdfs:label "Event type"@en ;
    obo:IAO_0000115 "A class used to categorize fisheries or survey event instances by operational type."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> .

smn:FishLengthMeasurementMethod a skos:Concept,
        sosa:Procedure ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:inScheme smn:MethodScheme ;
    skos:prefLabel "Fish length measurement method"@en ;
    skos:topConceptOf smn:MethodScheme .

smn:ForkLengthMeasurementMethod a skos:Concept,
        sosa:Procedure ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader smn:FishForkLengthMeasurementMethod ;
    skos:inScheme smn:MethodScheme ;
    skos:prefLabel "Fork-length measurement method"@en .

smn:MorphologicalCharacteristic a owl:Class ;
    rdfs:label "Morphological characteristic"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:Characteristic .

smn:ObservedRateOrAbundance a owl:Class ;
    rdfs:label "Observed rate or abundance"@en ;
    obo:IAO_0000115 "A measurement datum representing an empirically observed rate, count, or abundance derived from monitoring or survey data."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:ObservedRateOrAbundance."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000109 .

smn:RiverineRearingHabitat a skos:Concept ;
    obo:IAO_0000119 "Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, whose sea-type and river-type Sockeye Salmon both rear in river habitats, with sea-type juveniles rearing for several months in estuarine waters."@en ;
    dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader smn:JuvenileRearingHabitat ;
    skos:definition "Rearing habitat in which juveniles grow in flowing water, or in an associated slough or estuary, rather than in a lake."@en ;
    skos:inScheme smn:JuvenileRearingHabitatScheme ;
    skos:prefLabel "Riverine rearing habitat"@en ;
    skos:scopeNote "Deliberately spans the river-slough-estuary continuum rather than cutting it, because the Sockeye Salmon groups that use it are reported across that whole range and the distinction that separates those groups is duration, not position along the continuum. Where an estuarine-versus-fluvial distinction is itself the subject, model it as a narrower concept rather than by reinterpreting this one."@en .

smn:SalmonGroup a owl:Class ;
    rdfs:label "Salmon group"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:Entity .

smn:YearlingFreshwaterResidence a skos:Concept ;
    obo:IAO_0000119 "Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, whose lake-type juveniles rear in nursery lakes for at least one year and whose river-type juveniles rear in riverine habitat for one to two years."@en ;
    dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:altLabel "Yearling migrant"@en ;
    skos:broader smn:JuvenileFreshwaterResidenceDuration ;
    skos:definition "Juvenile freshwater residence of one year or more: juveniles overwinter at least once in fresh water before migrating seaward, and therefore carry at least one freshwater annulus on the scale."@en ;
    skos:inScheme smn:JuvenileFreshwaterResidenceDurationScheme ;
    skos:prefLabel "Yearling or older freshwater residence"@en .

sosa:Observation skos:closeMatch dwc:Occurrence .

sosa:Sampling skos:broadMatch dwc:Event .

smn:AgeNotation a skos:Concept ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeNotation."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeNotation> ;
    skos:definition "A notation system used to encode salmon age values in stock-assessment data."@en ;
    skos:inScheme smn:AgeNotationScheme ;
    skos:prefLabel "Age notation"@en .

smn:AgeNotationScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeNotationScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/gcdfo/salmon#AgeNotationScheme> ;
    skos:definition "Controlled vocabulary for notation systems used to encode salmon age values."@en ;
    skos:hasTopConcept smn:AgeNotation ;
    skos:prefLabel "Age notation scheme"@en .

smn:BroodYearBasis a skos:Concept ;
    obo:IAO_0000119 "Adapted from the Government of Canada Pacific Salmon Glossary definition of brood year."@en ;
    dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader smn:YearBasis ;
    skos:closeMatch <http://purl.dataone.org/odo/SALMON_00000520>,
        <https://w3id.org/gcdfo/salmon#BroodYear> ;
    skos:definition "A year-reference basis in which a calendar year identifies a salmon cohort by the spawning year of its parents."@en ;
    skos:inScheme smn:YearBasisScheme ;
    skos:prefLabel "Brood-year basis"@en ;
    skos:scopeNote "Use smn:broodYear for the xsd:gYear coordinate. The basis concept is not the coordinate value."@en .

smn:CatchYearBasis a skos:Concept ;
    obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology release 0.0.8 term gcdfo:CatchYear, modeled there as a SKOS concept."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader smn:YearBasis ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#CatchYear> ;
    skos:definition "A year-reference basis in which a calendar year identifies when the represented fishery catch occurred."@en ;
    skos:inScheme smn:YearBasisScheme ;
    skos:prefLabel "Catch-year basis"@en ;
    skos:scopeNote "Use smn:catchYear for the xsd:gYear coordinate. A catch year is not interchangeable with the return year of the fish."@en .

smn:CycleLine a skos:Concept ;
    obo:IAO_0000119 "The construct, and the invariance condition it depends on, are the broodline of Holtby, L.B. and Ciruna, K.A. 2007, Conservation Units for Pacific Salmon under the Wild Salmon Policy, DFO Canadian Science Advisory Secretariat Research Document 2007/070, glossary: in a semelparous species, if the age of reproduction is fixed or nearly so, the fish spawning in sequential generations are called broodlines, and in Pink Salmon there are even-year and odd-year broodlines in most rivers. That document treats the two as separate races for establishing Conservation Units. The name cycle line is this vocabulary's, not that document's, which uses broodline throughout; see the scope note on smn:CycleLine."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:altLabel "Broodline"@en ;
    skos:definition "One year series of a salmon population's returns, comprising the years congruent to one another modulo the population's cycle period under a declared year basis."@en ;
    skos:inScheme smn:CycleLineScheme ;
    skos:prefLabel "Cycle line"@en ;
    skos:scopeNote "Naming caution, recorded because it is unresolved: cycle line is this vocabulary's coinage. Holtby and Ciruna (2007), the framework this scheme draws on, says broodline and never says cycle line, and in Fraser Sockeye practice a cycle line is one of the four lines of the cyclic-dominance model — which is the model this concept defers. The term therefore currently names a construct in a scheme that excludes it. Cyclic dominance is a separate, deferred model and is not represented here: whether a line is dominant, subdominant, or off-cycle is a time-scoped status a line holds in one system, not the identity of the line. Its successor is named rather than left open — DFO's three Conservation Unit fields Cyclic (a boolean of the CU), Cyc_Dom, and Cyc_Dom_Year (which line, for that CU, in that period), whose values are dominant, subdominant, and off-cycle. Modelling those retires this deferral. Note that the fields cut across this scheme rather than along it: DFO records Fraser Pink as Cyclic = FALSE while still assigning it a cycle line."@en ;
    skos:topConceptOf smn:CycleLineScheme .

smn:FishLengthMeasurementType a owl:Class ;
    rdfs:label "Fish length measurement type"@en ;
    rdfs:comment "The used-procedure restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration: the specific length-method concepts are individuals in module 07's smn:MethodScheme, and someValuesFrom needs a class."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:observedProperty ;
            owl:someValuesFrom smn:FishLength ],
        [ a owl:Restriction ;
            owl:onProperty sosa:usedProcedure ;
            owl:someValuesFrom sosa:Procedure ],
        smn:Measurement .

smn:JuvenileFreshwaterResidenceDuration a skos:Concept ;
    obo:IAO_0000119 "The duration axis is the original scale-reading distinction of Gilbert, C.H. 1913, Age at maturity of the Pacific coast salmon of the genus Oncorhynchus, Bulletin of the United States Bureau of Fisheries 32:1-22. Its modern statement for Sockeye Salmon, in freshwater-annulus terms, is Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713."@en ;
    dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "The length of time juveniles of a salmon group remain in fresh water between emergence and seaward migration, expressed as a controlled value."@en ;
    skos:inScheme smn:JuvenileFreshwaterResidenceDurationScheme ;
    skos:prefLabel "Juvenile freshwater residence duration"@en ;
    skos:topConceptOf smn:JuvenileFreshwaterResidenceDurationScheme .

smn:JuvenileRearingHabitat a skos:Concept ;
    obo:IAO_0000119 "The lake-versus-riverine rearing distinction in Sockeye Salmon is stated by Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713."@en ;
    dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "The kind of rearing environment in which juveniles of a salmon group grow before migrating to sea, expressed as a controlled value."@en ;
    skos:inScheme smn:JuvenileRearingHabitatScheme ;
    skos:prefLabel "Juvenile rearing habitat"@en ;
    skos:topConceptOf smn:JuvenileRearingHabitatScheme .

smn:ReportingOrManagementStratum a owl:Class ;
    rdfs:label "Reporting or management stratum"@en ;
    obo:IAO_0000115 "An information-defined grouping of fish populations used for reporting, conservation assessment, or management purposes. Examples include Conservation Units (CUs), Stock Management Units (MUs), and Designatable Units (DUs)."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:ReportingOrManagementStratum."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000030 ;
    skos:closeMatch sosa:FeatureOfInterest .

smn:SalmonOrigin a skos:Concept ;
