smn:AgeBasis a skos:Concept ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeBasis."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeBasis> ;
    skos:definition "The reference event or life-history point at which a salmon age value applies."@en ;
    skos:inScheme smn:AgeBasisScheme ;
    skos:prefLabel "Age basis"@en .

smn:AgeBasisScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeBasisScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/gcdfo/salmon#AgeBasisScheme> ;
    skos:definition "Controlled vocabulary for the reference event or life-history point at which a salmon age applies."@en ;
    skos:hasTopConcept smn:AgeBasis ;
    skos:prefLabel "Age basis scheme"@en .

smn:AgeDimension a skos:Concept ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeDimension."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeDimension> ;
    skos:definition "The component of salmon age represented by a value."@en ;
    skos:inScheme smn:AgeDimensionScheme ;
    skos:prefLabel "Age dimension"@en .

smn:AgeDimensionScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeDimensionScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/gcdfo/salmon#AgeDimensionScheme> ;
    skos:definition "Controlled vocabulary for the component of salmon age represented by a value."@en ;
    skos:hasTopConcept smn:AgeDimension ;
    skos:prefLabel "Age dimension scheme"@en .

smn:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf sosa:FeatureOfInterest,
        <https://w3id.org/iadopt/ont/Entity> .

smn:LifeHistoryType a skos:Concept ;
    obo:IAO_0000119 "Life history is one of the three primary characteristics used to delimit Pacific salmon Conservation Units, alongside ecotypology and genetics. Holtby, L.B. and Ciruna, K.A. 2007. Conservation Units for Pacific Salmon under the Wild Salmon Policy. DFO Canadian Science Advisory Secretariat Research Document 2007/070."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "A named, recurring pattern of habitat use and life-cycle timing that distinguishes one group of salmon from another within a single species."@en ;
    skos:inScheme smn:LifeHistoryTypeScheme ;
    skos:prefLabel "Life-history type"@en ;
    skos:scopeNote "An open vocabulary; the minted narrower concepts cover Sockeye Salmon only, and they are asserted as flat siblings pending a ruling on whether the sea-type and river-type forms should instead be grouped against lake-type. Chinook ocean-type and stream-type are deliberately not minted: the bundle they name is not stable across the species range (Waples et al. 2004 report a deep interior-Columbia division alongside within-basin run-type divergence an order of magnitude smaller, and Moran et al. 2013 find the two-race model does not hold coast-wide), and Healey (1991) states he cannot classify the Sacramento winter run, which pairs stream-type adult behaviour with ocean-type juvenile behaviour. The axis schemes exist so that such a group can be described exactly, one axis at a time, without forcing a named type that does not fit. Run timing is modelled separately as the OWL class smn:Run."@en ;
    skos:topConceptOf smn:LifeHistoryTypeScheme .

smn:Population a owl:Class ;
    rdfs:label "Population"@en ;
    obo:IAO_0000115 "A group of organisms of the same species occupying a defined area that interbreed and share a gene pool. In salmon, populations are composed of one or more demes and form the biological basis for Conservation Units."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:Population."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf dwc:Organism .

smn:ReturnYearBasis a skos:Concept ;
    obo:IAO_0000119 "Pacific Salmon Commission Fraser River Sockeye Salmon Stock-Recruitment Data."@en ;
    dcterms:source <https://www.psc.org/publications/data/fraser-sockeye-stock-recruit-dataset/> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader smn:YearBasis ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#ReturnYear> ;
    skos:definition "A year-reference basis in which a calendar year identifies when members of a salmon cohort make the adult return relevant to the dataset's declared location or event."@en ;
    skos:inScheme smn:YearBasisScheme ;
    skos:prefLabel "Return-year basis"@en ;
    skos:scopeNote "Return year and catch year are distinct. Document the location or event at which return is defined separately; use smn:returnYear for the xsd:gYear coordinate."@en .

smn:YearBasis a skos:Concept ;
    obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology release 0.0.8 term gcdfo:YearBasis, modeled there as a SKOS concept."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:comment "A fixed year basis may qualify a standalone I-ADOPT variable, while row-varying year coordinates remain Data Cube dimensions."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#YearBasis> ;
    skos:definition "The biological, assessment, or fishery reference role used to interpret a calendar-year coordinate."@en ;
    skos:inScheme smn:YearBasisScheme ;
    skos:prefLabel "Year basis"@en .

smn:YearBasisScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "Adapted from the GC DFO Salmon Ontology release 0.0.8 SKOS year-basis vocabulary."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for the biological, assessment, or fishery role that gives meaning to a calendar-year coordinate."@en ;
    skos:hasTopConcept smn:YearBasis ;
    skos:prefLabel "Year basis scheme"@en ;
    skos:scopeNote "Calendar representation is not itself a year basis. Use a separate datatype property with an xsd:gYear value for the coordinate."@en .

smn:FishLength a owl:Class ;
    rdfs:label "Fish length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf smn:MorphologicalCharacteristic .

smn:JuvenileFreshwaterResidenceDurationScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "The duration axis is the original scale-reading distinction of Gilbert, C.H. 1913, Age at maturity of the Pacific coast salmon of the genus Oncorhynchus, Bulletin of the United States Bureau of Fisheries 32:1-22, whose sea type and stream type separate fish by whether the scale nucleus records a freshwater winter. Its modern statement for Sockeye Salmon, in freshwater-annulus terms, is Beacham, T.D. and Withler, R.E. 2017, Population structure of sea-type and lake-type sockeye salmon and kokanee in the Fraser River and Columbia River drainages, PLOS ONE 12(9):e0183713."@en ;
    dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for the duration axis of juvenile salmon life history: how long juveniles remain in fresh water between emergence and seaward migration."@en ;
    skos:hasTopConcept smn:JuvenileFreshwaterResidenceDuration ;
    skos:prefLabel "Juvenile freshwater residence duration scheme"@en ;
    skos:scopeNote "Species-neutral by construction. This is an axis a named life-history type is defined from, not a life-history type itself: a value here carries no claim about where juveniles reared, how adults behave, or what genetic structure the group has. It is also not age at maturity, which Healey (1991) treats as tactical variation within a race rather than as race-defining. The scheme is deliberately coarse — a two-valued cut at the first freshwater winter — because that cut is what a scale reader can actually determine: a fish that overwinters in fresh water lays down a freshwater annulus and one that does not, does not."@en .

smn:JuvenileRearingHabitatScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "The lake-versus-riverine rearing distinction in Sockeye Salmon is stated by Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, which groups the river-type and sea-type forms together on the ground that neither rears in lakes. It is also the cut DFO itself makes: the glossary of Holtby, L.B. and Ciruna, K.A. 2007, DFO Can. Sci. Advis. Sec. Res. Doc. 2007/070, defines the river/ocean-types of sockeye as juveniles adapted to rearing in flowing water instead of lakes."@en ;
    dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for the habitat axis of juvenile salmon life history: the kind of rearing environment juveniles occupy between emergence and seaward migration."@en ;
    skos:hasTopConcept smn:JuvenileRearingHabitat ;
    skos:prefLabel "Juvenile rearing habitat scheme"@en ;
    skos:scopeNote "Species-neutral by construction, and independent of the duration axis: the same kind of rearing habitat is used by groups that leave in their first year and by groups that stay a year or more, which is why the two axes cross-classify rather than nest. Values are kinds of water, never named water bodies; a property relating a population to an actual lake or river is a different property and is not minted here. Do not populate this scheme with the potamodromous vocabulary adfluvial / fluvial / lacustrine (Rieman and McIntyre 1993), despite lacustrine resembling lake and fluvial resembling river. That vocabulary classifies migration patterns completed within fresh water and treats anadromy as a separate category alongside them, so calling an anadromous Sockeye population adfluvial is a category error. Applying it to non-anadromous Oncorhynchus nerka (kokanee) is defensible and would be a different scheme."@en .

smn:LifePhase a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:LifePhase."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "A phase or segment used to stratify salmon measurements by where or when they apply (e.g., ocean phase, terminal phase)."@en ;
    skos:inScheme smn:LifePhaseScheme ;
    skos:prefLabel "Life phase"@en .

smn:LifePhaseScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:LifePhaseScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for life-phase or fishery/migration segment qualifiers used to stratify measurements (e.g., ocean, terminal, mainstem)."@en ;
    skos:hasTopConcept smn:LifePhase ;
    skos:prefLabel "Life phase scheme"@en .

smn:Measurement a owl:Class ;
    rdfs:label "Measurement"@en ;
    obo:IAO_0000115 "A salmon-domain observation focused on one feature of interest and one characteristic."@en ;
    rdfs:comment "A salmon-domain observation focused on one feature of interest and one characteristic."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:hasFeatureOfInterest ;
            owl:someValuesFrom smn:Entity ],
        [ a owl:Restriction ;
            owl:onProperty sosa:observedProperty ;
            owl:someValuesFrom smn:Characteristic ],
        smn:Observation .

smn:MeasurementContext a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:MeasurementContext."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "A context qualifier used to disambiguate the interpretation of a measurement column."@en ;
    skos:inScheme smn:MeasurementContextScheme ;
    skos:prefLabel "Measurement context"@en .

smn:MeasurementContextScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:MeasurementContextScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for compositional measurement context qualifiers (for example, catch context, run context)."@en ;
    skos:hasTopConcept smn:MeasurementContext ;
    skos:prefLabel "Measurement context scheme"@en .

smn:Characteristic a owl:Class ;
    rdfs:label "Characteristic"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf sosa:Property .

smn:CycleLineScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "The construct, and the invariance condition it depends on, are the broodline of Holtby, L.B. and Ciruna, K.A. 2007, Conservation Units for Pacific Salmon under the Wild Salmon Policy, DFO Canadian Science Advisory Secretariat Research Document 2007/070, glossary: in a semelparous species, if the age of reproduction is fixed or nearly so, the fish spawning in sequential generations are called broodlines, and in Pink Salmon there are even-year and odd-year broodlines in most rivers. That document treats the two as separate races for establishing Conservation Units. The name cycle line is this vocabulary's, not that document's, which uses broodline throughout; see the scope note on smn:CycleLine."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for cycle lines: the year series a population's returns fall into when the years are partitioned modulo the population's cycle period, under a declared year basis."@en ;
    skos:hasTopConcept smn:CycleLine ;
    skos:prefLabel "Cycle line scheme"@en ;
    skos:scopeNote "The construct is a year series, not a lineage. Reproductive independence is an additional claim that holds only where age at return is invariant, and it is asserted with smn:hasCycleLine rather than built into these definitions. Pink Salmon return at age 2 invariantly, so the brood-year and return-year partitions coincide and each line is closed under reproduction. Fraser Sockeye are the counter-case: roughly 89 to 92 percent return at age 4 but real age-3 and age-5 components exist, so a fish spawned on one line can return on another, the class is not closed, and the brood-year and return-year partitions of the same fish are not equivalent. Declaring a year basis from smn:YearBasisScheme therefore selects which assertion is being made; it does not reconcile the two."@en .

smn:LifeHistoryTypeScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "Life history is one of the three primary characteristics used to delimit Pacific salmon Conservation Units, alongside ecotypology and genetics. Holtby, L.B. and Ciruna, K.A. 2007. Conservation Units for Pacific Salmon under the Wild Salmon Policy. DFO Canadian Science Advisory Secretariat Research Document 2007/070."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary of named salmon life-history types. Each concept is scoped to a single species and is defined as a combination of values from the life-history axis schemes rather than as a primitive."@en ;
    skos:hasTopConcept smn:LifeHistoryType ;
    skos:prefLabel "Life-history type scheme"@en ;
    skos:scopeNote "Every named type in this scheme is species-scoped, and a type from one species is never assumed to mean a type from another: sockeye river-type is not chinook stream-type despite the near-identical English. Species is carried on each concept as a dwc:scientificName literal plus a WoRMS dwc:scientificNameID, not as an smn: species concept, and no smn: species concept or class exists to point at (Brett Johnson, 2026-08-24). A flat cross-species enumeration of these names is the failure mode this scheme is shaped to prevent, because the strings are similar enough to merge automatically and wrong to merge. Assertion is at Conservation Unit, population, or stock level, never for an individual fish (Brett Johnson, 2026-08-17), using smn:hasLifeHistory. Cycle line has its own vocabulary, smn:CycleLineScheme; do not add cycle-line values here."@en .

<https://w3id.org/iadopt/ont/Constraint> a owl:Class .

<https://w3id.org/iadopt/ont/StatisticalModifier> a owl:Class .

smn:AgeClassValue a skos:Concept ;
    obo:IAO_0000119 "Adapted and relabeled from GC DFO Salmon Ontology term gcdfo:AgeClassValue."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeClassValue> ;
    skos:definition "An integer-like coordinate used to represent one declared component of salmon age."@en ;
    skos:inScheme smn:AgeClassValueScheme ;
    skos:prefLabel "Age-class value"@en ;
    skos:scopeNote "This concept and its narrower values do not identify a brood cohort or year class."@en .

smn:AgeClassValueScheme a skos:ConceptScheme ;
    obo:IAO_0000119 "Migrated and relabeled from GC DFO Salmon Ontology term gcdfo:AgeClassValueScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/gcdfo/salmon#AgeClassValueScheme> ;
    skos:definition "Open controlled vocabulary for evidenced integer-like salmon age-component values."@en ;
    skos:hasTopConcept smn:AgeClassValue ;
    skos:prefLabel "Age-class value scheme"@en ;
    skos:scopeNote "An age-class value is an age coordinate, not a cohort or year class. Mint additional values only when supported by a use case."@en .

smn:MethodScheme a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary of shared, policy-neutral salmon observation and measurement methods. Organization- or program-specific method taxonomies remain profile-scoped (CONVENTIONS section 11)."@en ;
    skos:hasTopConcept smn:EnumerationMethod,
        smn:FishLengthMeasurementMethod ;
    skos:prefLabel "Method scheme"@en .

sosa:Procedure skos:closeMatch <https://rs.tdwg.org/dwc/dp/terms/Protocol> .

smn:StatisticalModifierScheme a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary of statistical modifiers stating what a reported value represents across the observations it summarizes (mean, median, minimum, maximum, total, count, peak). A statistical modifier is part of variable identity — daily mean and daily maximum temperature are different variables — unlike a method, which describes the act of measuring."@en ;
    skos:hasTopConcept smn:CountStatisticalModifier,
        smn:MaximumStatisticalModifier,
        smn:MeanStatisticalModifier,
        smn:MedianStatisticalModifier,
        smn:MinimumStatisticalModifier,
        smn:PeakStatisticalModifier,
        smn:TotalStatisticalModifier ;
    skos:prefLabel "Statistical modifier scheme"@en .

<https://w3id.org/smn> a owl:Ontology ;
    rdfs:label "Salmon Domain Ontology (modular build)"@en ;
    dcterms:modified "2026-08-14"^^xsd:date ;
    rdfs:comment "Primary modular import graph for reusable salmon-domain concepts and cross-ontology alignments. Phase-1/2/3 scaffold and migration baseline."@en ;
    owl:priorVersion smn:0.0.3 ;
    owl:versionIRI smn:0.0.3 ;
    owl:versionInfo "0.0.3" .

