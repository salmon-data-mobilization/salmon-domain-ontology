    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/LifePhase> ;
    skos:definition "Freshwater mainstem migration phase in a river system (often corresponding to mainstem in-river fisheries or monitoring segments)."@en ;
    skos:inScheme <https://w3id.org/smn/LifePhaseScheme> ;
    skos:prefLabel "Mainstem phase"@en .

<https://w3id.org/smn/MethodDocumentation> a owl:Class ;
    rdfs:label "Method documentation"@en ;
    obo:IAO_0000115 "A documented method description linked to how a salmon metric or estimate was produced."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000030 .

<https://w3id.org/smn/MetricBenchmark> a owl:Class ;
    rdfs:label "Metric benchmark"@en ;
    obo:IAO_0000115 "Benchmark value for a metric used to delineate status categories."@en ;
    obo:IAO_0000119 "Pestal, G., MacDonald, B.L., Grant, S.C.H., and Holt, C.A. 2023. State of the salmon: rapid status assessment approach for Pacific salmon under Canada's Wild Salmon Policy. Canadian Technical Report of Fisheries and Aquatic Sciences 3570."@en ;
    dcterms:source <https://publications.gc.ca/site/eng/9.928944/publication.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000030 .

<https://w3id.org/smn/ModelMeasurement> a owl:Class ;
    rdfs:label "Model measurement"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/Measurement> .

<https://w3id.org/smn/NCBITaxon_8018> a owl:Class ;
    rdfs:label "Oncorhynchus keta proxy class"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:NCBITaxon_8018 .

<https://w3id.org/smn/NaturalOrigin> a skos:Concept ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. 2018. Review of genetically based targets for enhanced contributions to Canadian Pacific Chinook Salmon populations. DFO Canadian Science Advisory Secretariat Science Advisory Report 2018/001 (Erratum: October 2023)."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/Publications/SAR-AS/2018/2018_001-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/SalmonOrigin> ;
    skos:definition "Individuals that are born and reared in the wild (natural environment)."@en ;
    skos:inScheme <https://w3id.org/smn/SalmonOriginScheme> ;
    skos:prefLabel "Natural-origin"@en .

<https://w3id.org/smn/OceanAgeDimension> a skos:Concept ;
    obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology term gcdfo:OceanAgeDimension."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:altLabel "Marine-age dimension"@en ;
    skos:broader <https://w3id.org/smn/AgeDimension> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#OceanAgeDimension> ;
    skos:definition "Age dimension whose value represents the marine component of salmon age under the declared age convention."@en ;
    skos:inScheme <https://w3id.org/smn/AgeDimensionScheme> ;
    skos:prefLabel "Ocean-age dimension"@en .

<https://w3id.org/smn/OceanPhase> a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:OceanPhase."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:altLabel "Marine phase"@en ;
    skos:broader <https://w3id.org/smn/LifePhase> ;
    skos:definition "Phase of the salmon life cycle or assessment period occurring in the marine environment."@en ;
    skos:inScheme <https://w3id.org/smn/LifePhaseScheme> ;
    skos:prefLabel "Ocean phase"@en .

<https://w3id.org/smn/OddYearCycleLine> a skos:Concept ;
    obo:IAO_0000119 "The construct, and the invariance condition it depends on, are the broodline of Holtby, L.B. and Ciruna, K.A. 2007, Conservation Units for Pacific Salmon under the Wild Salmon Policy, DFO Canadian Science Advisory Secretariat Research Document 2007/070, glossary: in a semelparous species, if the age of reproduction is fixed or nearly so, the fish spawning in sequential generations are called broodlines, and in Pink Salmon there are even-year and odd-year broodlines in most rivers. That document treats the two as separate races for establishing Conservation Units. The name cycle line is this vocabulary's, not that document's, which uses broodline throughout; see the scope note on smn:CycleLine."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:altLabel "Odd Year"@en ;
    skos:broader <https://w3id.org/smn/CycleLine> ;
    skos:definition "The cycle line of a two-year-cycle population whose years, under the declared year basis, are odd-numbered."@en ;
    skos:inScheme <https://w3id.org/smn/CycleLineScheme> ;
    skos:prefLabel "Odd-year cycle line"@en ;
    skos:scopeNote "One half of the composite DFO Conservation Unit species code PKO, Pink-Odd, whose other half is the species. Scoped to two-year-cycle populations because that is the case in which the odd-year series is also closed under reproduction; for a longer or variable cycle period the parity of a year is not a lineage."@en .

<https://w3id.org/smn/RecruitAbundance> a owl:Class ;
    rdfs:label "Recruit abundance"@en ;
    obo:IAO_0000115 "A measurement datum recording the abundance of recruits contributing to a salmon stock, population, or indicator return series."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html."@en ;
    dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
    rdfs:comment "Represent the measured characteristic with smn:Abundance. Use smn:broodYear and smn:returnYear for row-varying xsd:gYear coordinates, and use the separate SKOS basis concepts when a standalone variable description needs the corresponding fixed semantic qualifier."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/smn/Abundance>,
        <https://w3id.org/smn/BroodYearBasis>,
        <https://w3id.org/smn/ReturnYearBasis>,
        <https://w3id.org/smn/broodYear>,
        <https://w3id.org/smn/returnYear> ;
    rdfs:subClassOf <https://w3id.org/smn/ObservedRateOrAbundance> .

<https://w3id.org/smn/Run> a owl:Class ;
    rdfs:label "Run"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/Life-HistoryCharacteristic> .

<https://w3id.org/smn/RunContext> a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:RunContext."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/MeasurementContext> ;
    skos:definition "Measurement context indicating values refer to run size or returning run composition."@en ;
    skos:inScheme <https://w3id.org/smn/MeasurementContextScheme> ;
    skos:prefLabel "Run context"@en .

<https://w3id.org/smn/SalmonIndividual> a owl:Class ;
    rdfs:label "Salmon individual"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/Entity> .

<https://w3id.org/smn/SalmonPopulationGroup> a owl:Class ;
    rdfs:label "Salmon population group"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/SalmonGroup> .

<https://w3id.org/smn/SalmonStockUnit> a owl:Class ;
    rdfs:label "Salmon stock unit"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/SalmonGroup> .

<https://w3id.org/smn/SpawnerStageContext> a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:SpawnerStageContext."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/MeasurementContext> ;
    skos:definition "Measurement context indicating values refer to spawners or spawning-stage fish."@en ;
    skos:inScheme <https://w3id.org/smn/MeasurementContextScheme> ;
    skos:prefLabel "Spawner stage context"@en .

<https://w3id.org/smn/StandardLengthMeasurement> a owl:Class ;
    rdfs:label "Standard length measurement"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/FishLengthMeasurementType> .

<https://w3id.org/smn/Stock> a owl:Class ;
    rdfs:label "Stock"@en ;
    obo:IAO_0000115 "An operationally defined grouping of salmon used for assessment and management purposes."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. Introduction to Stock Assessment - Glossary. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/ReportingOrManagementStratum> ;
    skos:altLabel "Fish stock"@en ;
    skos:closeMatch sosa:FeatureOfInterest .

<https://w3id.org/smn/StockAssessment> a owl:Class ;
    rdfs:label "Stock assessment"@en ;
    obo:IAO_0000115 "The scientific process of analyzing data to estimate abundance and productivity across time."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. Introduction to Stock Assessment. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/module-1/09-eng.html."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/module-1/09-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:BFO_0000015 .

<https://w3id.org/smn/SurvivalOrMortalityContext> a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:SurvivalOrMortalityContext."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/MeasurementContext> ;
    skos:definition "Measurement context indicating values represent survival, mortality, or related rates."@en ;
    skos:inScheme <https://w3id.org/smn/MeasurementContextScheme> ;
    skos:prefLabel "Survival or mortality context"@en .

<https://w3id.org/smn/TerminalPhase> a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:TerminalPhase."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/LifePhase> ;
    skos:definition "Phase occurring in terminal areas near river mouths or spawning areas (often including terminal fisheries and local migration to spawning sites)."@en ;
    skos:inScheme <https://w3id.org/smn/LifePhaseScheme> ;
    skos:prefLabel "Terminal phase"@en .

<https://w3id.org/smn/TotalAgeDimension> a skos:Concept ;
    obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology term gcdfo:TotalAgeDimension."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/AgeDimension> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#TotalAgeDimension> ;
    skos:definition "Age dimension whose value represents total salmon age under the declared age convention."@en ;
    skos:inScheme <https://w3id.org/smn/AgeDimensionScheme> ;
    skos:prefLabel "Total-age dimension"@en .

<https://w3id.org/smn/TotalExploitationRate> a owl:Class ;
    rdfs:label "Total exploitation rate"@en ;
    obo:IAO_0000115 "The overall proportion of the total return of adult salmon removed by all fisheries over a defined period, aggregating across gear or fishery components."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:TotalExploitationRate."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/ExploitationRate> .

<https://w3id.org/smn/TotalLengthMeasurement> a owl:Class ;
    rdfs:label "Total length measurement"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/FishLengthMeasurementType> .

<https://w3id.org/smn/alevin> a owl:Class ;
    rdfs:label "Alevin"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/SalmonLifeStage> .

<https://w3id.org/smn/characteristicFor> a owl:ObjectProperty ;
    rdfs:label "characteristic for"@en ;
    rdfs:domain sosa:Property ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range sosa:FeatureOfInterest .

<https://w3id.org/smn/demeOf> a owl:ObjectProperty ;
    rdfs:label "deme of"@en ;
    obo:IAO_0000115 "Relates a deme to the population it belongs to."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:demeOf."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:domain <https://w3id.org/smn/Deme> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range <https://w3id.org/smn/Population> ;
    owl:inverseOf <https://w3id.org/smn/hasDeme> .

<https://w3id.org/smn/fusiform> a owl:Class ;
    rdfs:label "Fusiform"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/BodyShape> .

<https://w3id.org/smn/hasCycleLine> a owl:ObjectProperty ;
    rdfs:label "has cycle line"@en ;
    obo:IAO_0000115 "Relates a Conservation Unit, population, or stock whose age at return is invariant to the cycle line that constitutes it as a reproductive lineage."@en ;
    rdfs:comment "This property makes the strong claim: the year series is closed under reproduction, so the line is a lineage and not merely a stratification. It is valid only where age at return is invariant — Pink Salmon, which return at age 2. Assigning a line to an individual fish is likewise only valid under that same invariance. Where age at return varies, as in Fraser Sockeye, use smn:stratifiedByCycleLine on the return-year record instead; a fish spawned on one line can return on another, so the class is not closed and the claim would be false."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/smn/CycleLineScheme> .

<https://w3id.org/smn/hasEventType> a owl:ObjectProperty ;
    rdfs:label "has event type"@en ;
    rdfs:domain <https://w3id.org/smn/SamplingEvent> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range <https://w3id.org/smn/EventType> .

<https://w3id.org/smn/hasMeasurement> a owl:ObjectProperty ;
    rdfs:label "has measurement"@en ;
    rdfs:domain sosa:FeatureOfInterest ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range <https://w3id.org/smn/Measurement> .

<https://w3id.org/smn/observedTaxonFamily> a owl:ObjectProperty ;
    rdfs:label "observed taxon family"@en ;
    rdfs:domain sosa:Observation ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range obo:NCBITaxon_8015 .

<https://w3id.org/smn/observedTaxonSpecies> a owl:ObjectProperty ;
    rdfs:label "observed taxon species"@en ;
    rdfs:domain sosa:Observation ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range obo:NCBITaxon_8018 .

<https://w3id.org/smn/orbitalLength> a owl:Class ;
    rdfs:label "Orbital length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/FishLength> .

<https://w3id.org/smn/populationOf> a owl:ObjectProperty ;
    rdfs:label "population of"@en ;
    obo:IAO_0000115 "Relates a population to the reporting or management stratum it belongs to."@en ;
    rdfs:domain <https://w3id.org/smn/Population> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range <https://w3id.org/smn/ReportingOrManagementStratum> ;
    owl:inverseOf <https://w3id.org/smn/hasPopulation> .

<https://w3id.org/smn/seiningEvent> a owl:Class ;
    rdfs:label "Seining event"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/FishingType> .

<https://w3id.org/smn/standardLength> a owl:Class ;
    rdfs:label "Standard length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/FishLength> .

<https://w3id.org/smn/stratifiedByCycleLine> a owl:ObjectProperty ;
    rdfs:label "stratified by cycle line"@en ;
    obo:IAO_0000115 "Relates a data record or observation carrying a return year to the cycle line that year falls in, as a stratification of the year series only."@en ;
    rdfs:comment "The weak, always-safe claim: the subject year belongs to that residue class under the declared year basis. It asserts nothing about reproductive independence and nothing about the fish, which is why it is the correct property for a population with variable age at return such as Fraser Sockeye. Use smn:hasCycleLine, on the population rather than the record, where age at return is invariant and the line really is a lineage. Domain is deliberately omitted for the same reason as on smn:broodYear: the subject may be an observation or a table row."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range skos:Concept ;
    rdfs:seeAlso <https://w3id.org/smn/CycleLineScheme>,
        <https://w3id.org/smn/ReturnYearBasis> .

<https://w3id.org/smn/totalLength> a owl:Class ;
    rdfs:label "Total length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/FishLength> .

sosa:Sample skos:closeMatch <http://rs.tdwg.org/dwc/terms/MaterialEntity>,
        <http://rs.tdwg.org/dwc/terms/MaterialSample> .

<https://w3id.org/iadopt/ont/Entity> skos:closeMatch sosa:FeatureOfInterest .

<https://w3id.org/smn/AggregatedMeasurement> a owl:Class ;
    rdfs:label "Aggregated measurement"@en ;
    rdfs:comment "The based-on restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration. The specific constraint — values must be method concepts at or below smn:EnumerationMethod in smn:MethodScheme — is normative and lives in ontology/shapes/method-shapes.ttl (smn:AggregatedMeasurementShape), expressed as a skos:broader* path, since someValuesFrom cannot range over concept individuals."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/smn/basedOn> ;
            owl:someValuesFrom sosa:Procedure ],
        <https://w3id.org/smn/Measurement> .

<https://w3id.org/smn/BodyShape> a owl:Class ;
    rdfs:label "Body shape"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/Characteristic> .

<https://w3id.org/smn/CountStatisticalModifier> a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "The reported value is the number of summarized observations or individuals, as counted rather than estimated."@en ;
    skos:inScheme <https://w3id.org/smn/StatisticalModifierScheme> ;
    skos:prefLabel "Count"@en ;
    skos:topConceptOf <https://w3id.org/smn/StatisticalModifierScheme> .

<https://w3id.org/smn/EnumerationMethod> a skos:Concept,
        sosa:Procedure ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:EnumerationMethod."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "A method used to enumerate or count salmon in the field."@en ;
    skos:inScheme <https://w3id.org/smn/MethodScheme> ;
    skos:prefLabel "Enumeration method"@en ;
    skos:topConceptOf <https://w3id.org/smn/MethodScheme> .

<https://w3id.org/smn/ExploitationRate> a owl:Class ;
    rdfs:label "Exploitation rate"@en ;
    obo:IAO_0000115 "The proportion of returning adult salmon removed by fishing activity over a defined period."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html."@en ;
    dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/TargetOrLimitRateOrAbundance> .

<https://w3id.org/smn/FishForkLengthMeasurementMethod> a skos:Concept,
        sosa:Procedure ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/FishLengthMeasurementMethod> ;
    skos:inScheme <https://w3id.org/smn/MethodScheme> ;
    skos:prefLabel "Fish fork-length measurement method"@en .

<https://w3id.org/smn/FishingType> a owl:Class ;
    rdfs:label "Fishing type"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/EventType> .

<https://w3id.org/smn/GeographicFeature> a owl:Class ;
    rdfs:label "Geographic feature"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf geo:Feature .

<https://w3id.org/smn/Life-HistoryCharacteristic> a owl:Class ;
    rdfs:label "Life-history characteristic"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/Characteristic> .

<https://w3id.org/smn/MaximumStatisticalModifier> a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/maximum> ;
    skos:definition "The reported value is the maximum of the summarized observations."@en ;
    skos:inScheme <https://w3id.org/smn/StatisticalModifierScheme> ;
    skos:prefLabel "Maximum"@en ;
    skos:topConceptOf <https://w3id.org/smn/StatisticalModifierScheme> .

<https://w3id.org/smn/MeanStatisticalModifier> a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/average> ;
    skos:definition "The reported value is the arithmetic mean of the summarized observations."@en ;
    skos:inScheme <https://w3id.org/smn/StatisticalModifierScheme> ;
    skos:prefLabel "Mean"@en ;
    skos:topConceptOf <https://w3id.org/smn/StatisticalModifierScheme> .

<https://w3id.org/smn/MedianStatisticalModifier> a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/median> ;
    skos:definition "The reported value is the median of the summarized observations."@en ;
    skos:inScheme <https://w3id.org/smn/StatisticalModifierScheme> ;
    skos:prefLabel "Median"@en ;
    skos:topConceptOf <https://w3id.org/smn/StatisticalModifierScheme> .

<https://w3id.org/smn/MinimumStatisticalModifier> a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/minimum> ;
    skos:definition "The reported value is the minimum of the summarized observations."@en ;
    skos:inScheme <https://w3id.org/smn/StatisticalModifierScheme> ;
    skos:prefLabel "Minimum"@en ;
    skos:topConceptOf <https://w3id.org/smn/StatisticalModifierScheme> .

<https://w3id.org/smn/Observation> a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf sosa:Observation .

<https://w3id.org/smn/PeakStatisticalModifier> a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "The reported value is the peak (highest single observation event) across the summarized series, such as a peak live count in a spawner survey."@en ;
    skos:inScheme <https://w3id.org/smn/StatisticalModifierScheme> ;
    skos:prefLabel "Peak"@en ;
    skos:topConceptOf <https://w3id.org/smn/StatisticalModifierScheme> .

<https://w3id.org/smn/ReferencePoint> a owl:Class ;
    rdfs:label "Reference point"@en ;
    obo:IAO_0000115 "A target or limit used to guide management actions."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. Introduction to Stock Assessment - Glossary. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000030 ;
    skos:closeMatch <https://w3id.org/iadopt/ont/Constraint> .

<https://w3id.org/smn/SalmonLifeStage> a owl:Class ;
    rdfs:label "Salmon life stage"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/Characteristic> .

<https://w3id.org/smn/SamplingEvent> a owl:Class ;
    rdfs:label "Sampling event"@en ;
    obo:IAO_0000115 "A sampling activity that targets a geographic feature, yields a sample, and records a time."@en ;
    rdfs:comment "A sampling activity that targets a geographic feature, yields a sample, and records a time."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:hasFeatureOfInterest ;
            owl:someValuesFrom geo:Feature ],
        [ a owl:Restriction ;
            owl:onProperty sosa:hasResult ;
            owl:someValuesFrom sosa:Sample ],
        [ a owl:Restriction ;
            owl:onProperty sosa:resultTime ;
            owl:someValuesFrom time:Instant ],
        sosa:Sampling .

<https://w3id.org/smn/SurveyEvent> a owl:Class ;
    rdfs:label "Survey event"@en ;
    obo:IAO_0000115 "A field event that collects information about fish populations to evaluate status and support management decisions."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. About the Sustainability Survey for Fisheries. https://www.dfo-mpo.gc.ca/reports-rapports/regs/sff-cpd/survey-sondage/about-propos-en.html."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/reports-rapports/regs/sff-cpd/survey-sondage/about-propos-en.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <http://rs.tdwg.org/dwc/terms/Event> ;
    skos:closeMatch sosa:Sampling .

<https://w3id.org/smn/TargetOrLimitRateOrAbundance> a owl:Class ;
    rdfs:label "Target or limit rate or abundance"@en ;
    obo:IAO_0000115 "A value specification representing a policy- or model-defined target or limit, such as TAC, UMSY, or reference points."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:TargetOrLimitRateOrAbundance."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000109 .

<https://w3id.org/smn/TotalStatisticalModifier> a skos:Concept,
        <https://w3id.org/iadopt/ont/StatisticalModifier> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:closeMatch <http://vocabulary.odm2.org/aggregationstatistic/cumulative> ;
    skos:definition "The reported value is the sum or cumulative total of the summarized observations, such as an annual total catch or cumulative escapement."@en ;
    skos:inScheme <https://w3id.org/smn/StatisticalModifierScheme> ;
    skos:prefLabel "Total"@en ;
    skos:topConceptOf <https://w3id.org/smn/StatisticalModifierScheme> .

<https://w3id.org/smn/basedOn> a owl:ObjectProperty ;
    rdfs:label "based on"@en ;
    rdfs:domain <https://w3id.org/smn/AggregatedMeasurement> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range sosa:Procedure .

<https://w3id.org/smn/broodYear> a qb:DimensionProperty,
        owl:DatatypeProperty ;
    rdfs:label "brood year"@en ;
    obo:IAO_0000115 "Relates a data record or observation to the calendar year that identifies a salmon cohort by the spawning year of its parents."@en ;
    obo:IAO_0000119 "Adapted from the Government of Canada Pacific Salmon Glossary definition of brood year."@en ;
    dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
    qb:concept <https://w3id.org/smn/BroodYearBasis> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range xsd:gYear ;
    rdfs:seeAlso time:inXSDgYear,
        <https://w3id.org/smn/BroodYearBasis> .

<https://w3id.org/smn/catchYear> a qb:DimensionProperty,
        owl:DatatypeProperty ;
    rdfs:label "catch year"@en ;
    obo:IAO_0000115 "Relates a data record or observation to the calendar year in which the represented fishery catch occurred."@en ;
    obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology term gcdfo:CatchYear."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    qb:concept <https://w3id.org/smn/CatchYearBasis> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range xsd:gYear ;
    rdfs:seeAlso time:inXSDgYear,
        <https://w3id.org/smn/CatchYearBasis> .

<https://w3id.org/smn/forkLength> a owl:Class ;
    rdfs:label "Fork length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/FishLength> .

<https://w3id.org/smn/hasDeme> a owl:ObjectProperty ;
    rdfs:label "has deme"@en ;
    obo:IAO_0000115 "Relates a population to one of its constituent demes."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:hasDeme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:domain <https://w3id.org/smn/Population> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range <https://w3id.org/smn/Deme> ;
    rdfs:subPropertyOf obo:RO_0002351 .

<https://w3id.org/smn/hasPopulation> a owl:ObjectProperty ;
    rdfs:label "has population"@en ;
    obo:IAO_0000115 "Relates a reporting or management stratum to one of its constituent populations."@en ;
    rdfs:domain <https://w3id.org/smn/ReportingOrManagementStratum> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range <https://w3id.org/smn/Population> ;
    rdfs:subPropertyOf obo:RO_0002351 .

<https://w3id.org/smn/returnYear> a qb:DimensionProperty,
        owl:DatatypeProperty ;
    rdfs:label "return year"@en ;
    obo:IAO_0000115 "Relates a data record or observation to the calendar year in which members of a salmon cohort make the adult return relevant to the dataset's declared location or event."@en ;
    obo:IAO_0000119 "Pacific Salmon Commission Fraser River Sockeye Salmon Stock-Recruitment Data."@en ;
    dcterms:source <https://www.psc.org/publications/data/fraser-sockeye-stock-recruit-dataset/> ;
    qb:concept <https://w3id.org/smn/ReturnYearBasis> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:range xsd:gYear ;
    rdfs:seeAlso time:inXSDgYear,
        <https://w3id.org/smn/ReturnYearBasis> .

obo:NCBITaxon_8018 rdfs:subClassOf obo:NCBITaxon_8015 .

geo:Feature rdfs:subClassOf sosa:FeatureOfInterest .

<https://w3id.org/smn/Abundance> a owl:Class ;
    rdfs:label "Abundance"@en ;
    obo:IAO_0000115 "A characteristic representing the quantity of salmon or other organisms associated with a defined entity, place, and time."@en ;
    dcterms:source <http://qudt.org/vocab/quantitykind/Population> ;
    rdfs:comment "Use units, statistical modifiers, measurement context, and procedures to distinguish absolute counts, relative indices, estimates, expansions, and other representations. Those qualifiers do not change the reusable characteristic into a compound OWL class."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <http://rs.tdwg.org/dwc/terms/individualCount> ;
    rdfs:subClassOf <https://w3id.org/smn/Characteristic> ;
    skos:broadMatch <http://qudt.org/vocab/quantitykind/Count> ;
    skos:closeMatch <http://qudt.org/vocab/quantitykind/Population> .

<https://w3id.org/smn/Deme> a owl:Class ;
    rdfs:label "Deme"@en ;
    obo:IAO_0000115 "A local interbreeding group of organisms within a species. In salmon, a deme typically corresponds to a spawning population at a specific site. Demes are the finest biological unit and make up populations."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:Deme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <http://rs.tdwg.org/dwc/terms/Organism> .

<https://w3id.org/smn/EventType> a owl:Class ;
    rdfs:label "Event type"@en ;
    obo:IAO_0000115 "A class used to categorize fisheries or survey event instances by operational type."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> .

<https://w3id.org/smn/FishLengthMeasurementMethod> a skos:Concept,
        sosa:Procedure ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:inScheme <https://w3id.org/smn/MethodScheme> ;
    skos:prefLabel "Fish length measurement method"@en ;
    skos:topConceptOf <https://w3id.org/smn/MethodScheme> .

<https://w3id.org/smn/ForkLengthMeasurementMethod> a skos:Concept,
        sosa:Procedure ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/FishForkLengthMeasurementMethod> ;
    skos:inScheme <https://w3id.org/smn/MethodScheme> ;
    skos:prefLabel "Fork-length measurement method"@en .

<https://w3id.org/smn/MorphologicalCharacteristic> a owl:Class ;
    rdfs:label "Morphological characteristic"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/Characteristic> .

<https://w3id.org/smn/ObservedRateOrAbundance> a owl:Class ;
    rdfs:label "Observed rate or abundance"@en ;
    obo:IAO_0000115 "A measurement datum representing an empirically observed rate, count, or abundance derived from monitoring or survey data."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:ObservedRateOrAbundance."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000109 .

<https://w3id.org/smn/SalmonGroup> a owl:Class ;
    rdfs:label "Salmon group"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/Entity> .

sosa:Observation skos:closeMatch <http://rs.tdwg.org/dwc/terms/Occurrence> .

sosa:Sampling skos:broadMatch <http://rs.tdwg.org/dwc/terms/Event> .

<https://w3id.org/smn/AgeNotation> a skos:Concept ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeNotation."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeNotation> ;
    skos:definition "A notation system used to encode salmon age values in stock-assessment data."@en ;
    skos:inScheme <https://w3id.org/smn/AgeNotationScheme> ;
    skos:prefLabel "Age notation"@en .

<https://w3id.org/smn/AgeNotationScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeNotationScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/gcdfo/salmon#AgeNotationScheme> ;
    skos:definition "Controlled vocabulary for notation systems used to encode salmon age values."@en ;
    skos:hasTopConcept <https://w3id.org/smn/AgeNotation> ;
    skos:prefLabel "Age notation scheme"@en .

<https://w3id.org/smn/BroodYearBasis> a skos:Concept ;
    obo:IAO_0000119 "Adapted from the Government of Canada Pacific Salmon Glossary definition of brood year."@en ;
    dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/YearBasis> ;
    skos:closeMatch <http://purl.dataone.org/odo/SALMON_00000520>,
        <https://w3id.org/gcdfo/salmon#BroodYear> ;
    skos:definition "A year-reference basis in which a calendar year identifies a salmon cohort by the spawning year of its parents."@en ;
    skos:inScheme <https://w3id.org/smn/YearBasisScheme> ;
    skos:prefLabel "Brood-year basis"@en ;
    skos:scopeNote "Use smn:broodYear for the xsd:gYear coordinate. The basis concept is not the coordinate value."@en .

<https://w3id.org/smn/CatchYearBasis> a skos:Concept ;
    obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology release 0.0.8 term gcdfo:CatchYear, modeled there as a SKOS concept."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/YearBasis> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#CatchYear> ;
    skos:definition "A year-reference basis in which a calendar year identifies when the represented fishery catch occurred."@en ;
    skos:inScheme <https://w3id.org/smn/YearBasisScheme> ;
    skos:prefLabel "Catch-year basis"@en ;
    skos:scopeNote "Use smn:catchYear for the xsd:gYear coordinate. A catch year is not interchangeable with the return year of the fish."@en .

<https://w3id.org/smn/CycleLine> a skos:Concept ;
    obo:IAO_0000119 "The construct, and the invariance condition it depends on, are the broodline of Holtby, L.B. and Ciruna, K.A. 2007, Conservation Units for Pacific Salmon under the Wild Salmon Policy, DFO Canadian Science Advisory Secretariat Research Document 2007/070, glossary: in a semelparous species, if the age of reproduction is fixed or nearly so, the fish spawning in sequential generations are called broodlines, and in Pink Salmon there are even-year and odd-year broodlines in most rivers. That document treats the two as separate races for establishing Conservation Units. The name cycle line is this vocabulary's, not that document's, which uses broodline throughout; see the scope note on smn:CycleLine."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:altLabel "Broodline"@en ;
    skos:definition "One year series of a salmon population's returns, comprising the years congruent to one another modulo the population's cycle period under a declared year basis."@en ;
    skos:inScheme <https://w3id.org/smn/CycleLineScheme> ;
    skos:prefLabel "Cycle line"@en ;
    skos:scopeNote "Naming caution, recorded because it is unresolved: cycle line is this vocabulary's coinage. Holtby and Ciruna (2007), the framework this scheme draws on, says broodline and never says cycle line, and in Fraser Sockeye practice a cycle line is one of the four lines of the cyclic-dominance model — which is the model this concept defers. The term therefore currently names a construct in a scheme that excludes it. Cyclic dominance is a separate, deferred model and is not represented here: whether a line is dominant, subdominant, or off-cycle is a time-scoped status a line holds in one system, not the identity of the line. Its successor is named rather than left open — DFO's three Conservation Unit fields Cyclic (a boolean of the CU), Cyc_Dom, and Cyc_Dom_Year (which line, for that CU, in that period), whose values are dominant, subdominant, and off-cycle. Modelling those retires this deferral."@en ;
    skos:topConceptOf <https://w3id.org/smn/CycleLineScheme> .

<https://w3id.org/smn/FishLengthMeasurementType> a owl:Class ;
    rdfs:label "Fish length measurement type"@en ;
    rdfs:comment "The used-procedure restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration: the specific length-method concepts are individuals in module 07's smn:MethodScheme, and someValuesFrom needs a class."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:observedProperty ;
            owl:someValuesFrom <https://w3id.org/smn/FishLength> ],
        [ a owl:Restriction ;
            owl:onProperty sosa:usedProcedure ;
            owl:someValuesFrom sosa:Procedure ],
        <https://w3id.org/smn/Measurement> .

<https://w3id.org/smn/ReportingOrManagementStratum> a owl:Class ;
    rdfs:label "Reporting or management stratum"@en ;
    obo:IAO_0000115 "An information-defined grouping of fish populations used for reporting, conservation assessment, or management purposes. Examples include Conservation Units (CUs), Stock Management Units (MUs), and Designatable Units (DUs)."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:ReportingOrManagementStratum."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:IAO_0000030 ;
    skos:closeMatch sosa:FeatureOfInterest .

<https://w3id.org/smn/SalmonOrigin> a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:SalmonOrigin."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Origin category describing whether salmon are naturally produced, hatchery produced, or mixed-origin."@en ;
    skos:inScheme <https://w3id.org/smn/SalmonOriginScheme> ;
    skos:prefLabel "Salmon origin"@en .

<https://w3id.org/smn/SalmonOriginScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:SalmonOriginScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for describing the origin of individual salmon (e.g., natural-origin, hatchery-origin, mixed-origin)."@en ;
    skos:hasTopConcept <https://w3id.org/smn/SalmonOrigin> ;
    skos:prefLabel "Salmon origin scheme"@en .

<https://w3id.org/smn/AgeBasis> a skos:Concept ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeBasis."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeBasis> ;
    skos:definition "The reference event or life-history point at which a salmon age value applies."@en ;
    skos:inScheme <https://w3id.org/smn/AgeBasisScheme> ;
    skos:prefLabel "Age basis"@en .

<https://w3id.org/smn/AgeBasisScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeBasisScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/gcdfo/salmon#AgeBasisScheme> ;
    skos:definition "Controlled vocabulary for the reference event or life-history point at which a salmon age applies."@en ;
    skos:hasTopConcept <https://w3id.org/smn/AgeBasis> ;
    skos:prefLabel "Age basis scheme"@en .

<https://w3id.org/smn/AgeDimension> a skos:Concept ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeDimension."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeDimension> ;
    skos:definition "The component of salmon age represented by a value."@en ;
    skos:inScheme <https://w3id.org/smn/AgeDimensionScheme> ;
    skos:prefLabel "Age dimension"@en .

<https://w3id.org/smn/AgeDimensionScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "Migrated from GC DFO Salmon Ontology term gcdfo:AgeDimensionScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/gcdfo/salmon#AgeDimensionScheme> ;
    skos:definition "Controlled vocabulary for the component of salmon age represented by a value."@en ;
    skos:hasTopConcept <https://w3id.org/smn/AgeDimension> ;
    skos:prefLabel "Age dimension scheme"@en .

<https://w3id.org/smn/Entity> a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf sosa:FeatureOfInterest,
        <https://w3id.org/iadopt/ont/Entity> .

<https://w3id.org/smn/Population> a owl:Class ;
    rdfs:label "Population"@en ;
    obo:IAO_0000115 "A group of organisms of the same species occupying a defined area that interbreed and share a gene pool. In salmon, populations are composed of one or more demes and form the biological basis for Conservation Units."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:Population."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <http://rs.tdwg.org/dwc/terms/Organism> .

<https://w3id.org/smn/ReturnYearBasis> a skos:Concept ;
    obo:IAO_0000119 "Pacific Salmon Commission Fraser River Sockeye Salmon Stock-Recruitment Data."@en ;
    dcterms:source <https://www.psc.org/publications/data/fraser-sockeye-stock-recruit-dataset/> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:broader <https://w3id.org/smn/YearBasis> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#ReturnYear> ;
    skos:definition "A year-reference basis in which a calendar year identifies when members of a salmon cohort make the adult return relevant to the dataset's declared location or event."@en ;
    skos:inScheme <https://w3id.org/smn/YearBasisScheme> ;
    skos:prefLabel "Return-year basis"@en ;
    skos:scopeNote "Return year and catch year are distinct. Document the location or event at which return is defined separately; use smn:returnYear for the xsd:gYear coordinate."@en .

<https://w3id.org/smn/YearBasis> a skos:Concept ;
    obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology release 0.0.8 term gcdfo:YearBasis, modeled there as a SKOS concept."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:comment "A fixed year basis may qualify a standalone I-ADOPT variable, while row-varying year coordinates remain Data Cube dimensions."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#YearBasis> ;
    skos:definition "The biological, assessment, or fishery reference role used to interpret a calendar-year coordinate."@en ;
    skos:inScheme <https://w3id.org/smn/YearBasisScheme> ;
    skos:prefLabel "Year basis"@en .

<https://w3id.org/smn/YearBasisScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "Adapted from the GC DFO Salmon Ontology release 0.0.8 SKOS year-basis vocabulary."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for the biological, assessment, or fishery role that gives meaning to a calendar-year coordinate."@en ;
    skos:hasTopConcept <https://w3id.org/smn/YearBasis> ;
    skos:prefLabel "Year basis scheme"@en ;
    skos:scopeNote "Calendar representation is not itself a year basis. Use a separate datatype property with an xsd:gYear value for the coordinate."@en .

<https://w3id.org/smn/FishLength> a owl:Class ;
    rdfs:label "Fish length"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf <https://w3id.org/smn/MorphologicalCharacteristic> .

<https://w3id.org/smn/LifePhase> a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:LifePhase."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "A phase or segment used to stratify salmon measurements by where or when they apply (e.g., ocean phase, terminal phase)."@en ;
    skos:inScheme <https://w3id.org/smn/LifePhaseScheme> ;
    skos:prefLabel "Life phase"@en .

<https://w3id.org/smn/LifePhaseScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:LifePhaseScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for life-phase or fishery/migration segment qualifiers used to stratify measurements (e.g., ocean, terminal, mainstem)."@en ;
    skos:hasTopConcept <https://w3id.org/smn/LifePhase> ;
    skos:prefLabel "Life phase scheme"@en .

<https://w3id.org/smn/Measurement> a owl:Class ;
    rdfs:label "Measurement"@en ;
    obo:IAO_0000115 "A salmon-domain observation focused on one feature of interest and one characteristic."@en ;
    rdfs:comment "A salmon-domain observation focused on one feature of interest and one characteristic."@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sosa:hasFeatureOfInterest ;
            owl:someValuesFrom <https://w3id.org/smn/Entity> ],
        [ a owl:Restriction ;
            owl:onProperty sosa:observedProperty ;
            owl:someValuesFrom <https://w3id.org/smn/Characteristic> ],
        <https://w3id.org/smn/Observation> .

<https://w3id.org/smn/MeasurementContext> a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:MeasurementContext."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "A context qualifier used to disambiguate the interpretation of a measurement column."@en ;
    skos:inScheme <https://w3id.org/smn/MeasurementContextScheme> ;
    skos:prefLabel "Measurement context"@en .

<https://w3id.org/smn/MeasurementContextScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:MeasurementContextScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for compositional measurement context qualifiers (for example, catch context, run context)."@en ;
    skos:hasTopConcept <https://w3id.org/smn/MeasurementContext> ;
    skos:prefLabel "Measurement context scheme"@en .

<https://w3id.org/smn/Characteristic> a owl:Class ;
    rdfs:label "Characteristic"@en ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf sosa:Property .

<https://w3id.org/smn/CycleLineScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "The construct, and the invariance condition it depends on, are the broodline of Holtby, L.B. and Ciruna, K.A. 2007, Conservation Units for Pacific Salmon under the Wild Salmon Policy, DFO Canadian Science Advisory Secretariat Research Document 2007/070, glossary: in a semelparous species, if the age of reproduction is fixed or nearly so, the fish spawning in sequential generations are called broodlines, and in Pink Salmon there are even-year and odd-year broodlines in most rivers. That document treats the two as separate races for establishing Conservation Units. The name cycle line is this vocabulary's, not that document's, which uses broodline throughout; see the scope note on smn:CycleLine."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary for cycle lines: the year series a population's returns fall into when the years are partitioned modulo the population's cycle period, under a declared year basis."@en ;
    skos:hasTopConcept <https://w3id.org/smn/CycleLine> ;
    skos:prefLabel "Cycle line scheme"@en ;
    skos:scopeNote "The construct is a year series, not a lineage. Reproductive independence is an additional claim that holds only where age at return is invariant, and it is asserted with smn:hasCycleLine rather than built into these definitions. Pink Salmon return at age 2 invariantly, so the brood-year and return-year partitions coincide and each line is closed under reproduction. Fraser Sockeye are the counter-case: more than 92 percent return at age 4 (Peterman and Dorner 2011) but real age-3 and age-5 components exist, so a fish spawned on one line can return on another, the class is not closed, and the brood-year and return-year partitions of the same fish are not equivalent. Declaring a year basis from smn:YearBasisScheme therefore selects which assertion is being made; it does not reconcile the two."@en .

<https://w3id.org/iadopt/ont/Constraint> a owl:Class .

<https://w3id.org/iadopt/ont/StatisticalModifier> a owl:Class .

<https://w3id.org/smn/AgeClassValue> a skos:Concept ;
    obo:IAO_0000119 "Adapted and relabeled from GC DFO Salmon Ontology term gcdfo:AgeClassValue."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/iadopt/ont/Constraint> ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeClassValue> ;
    skos:definition "An integer-like coordinate used to represent one declared component of salmon age."@en ;
    skos:inScheme <https://w3id.org/smn/AgeClassValueScheme> ;
    skos:prefLabel "Age-class value"@en ;
    skos:scopeNote "This concept and its narrower values do not identify a brood cohort or year class."@en .

<https://w3id.org/smn/AgeClassValueScheme> a skos:ConceptScheme ;
    obo:IAO_0000119 "Migrated and relabeled from GC DFO Salmon Ontology term gcdfo:AgeClassValueScheme."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:seeAlso <https://w3id.org/gcdfo/salmon#AgeClassValueScheme> ;
    skos:definition "Open controlled vocabulary for evidenced integer-like salmon age-component values."@en ;
    skos:hasTopConcept <https://w3id.org/smn/AgeClassValue> ;
    skos:prefLabel "Age-class value scheme"@en ;
    skos:scopeNote "An age-class value is an age coordinate, not a cohort or year class. Mint additional values only when supported by a use case."@en .

<https://w3id.org/smn/MethodScheme> a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary of shared, policy-neutral salmon observation and measurement methods. Organization- or program-specific method taxonomies remain profile-scoped (CONVENTIONS section 11)."@en ;
    skos:hasTopConcept <https://w3id.org/smn/EnumerationMethod>,
        <https://w3id.org/smn/FishLengthMeasurementMethod> ;
    skos:prefLabel "Method scheme"@en .

sosa:Procedure skos:closeMatch <https://rs.tdwg.org/dwc/dp/terms/Protocol> .

<https://w3id.org/smn/StatisticalModifierScheme> a skos:ConceptScheme ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:definition "Controlled vocabulary of statistical modifiers stating what a reported value represents across the observations it summarizes (mean, median, minimum, maximum, total, count, peak). A statistical modifier is part of variable identity — daily mean and daily maximum temperature are different variables — unlike a method, which describes the act of measuring."@en ;
    skos:hasTopConcept <https://w3id.org/smn/CountStatisticalModifier>,
        <https://w3id.org/smn/MaximumStatisticalModifier>,
        <https://w3id.org/smn/MeanStatisticalModifier>,
        <https://w3id.org/smn/MedianStatisticalModifier>,
        <https://w3id.org/smn/MinimumStatisticalModifier>,
        <https://w3id.org/smn/PeakStatisticalModifier>,
        <https://w3id.org/smn/TotalStatisticalModifier> ;
    skos:prefLabel "Statistical modifier scheme"@en .

<https://w3id.org/smn> a owl:Ontology ;
    rdfs:label "Salmon Domain Ontology (modular build)"@en ;
    dcterms:modified "2026-08-14"^^xsd:date ;
    rdfs:comment "Primary modular import graph for reusable salmon-domain concepts and cross-ontology alignments. Phase-1/2/3 scaffold and migration baseline."@en ;
    owl:priorVersion <https://w3id.org/smn/0.0.3> ;
    owl:versionIRI <https://w3id.org/smn/0.0.3> ;
    owl:versionInfo "0.0.3" .

