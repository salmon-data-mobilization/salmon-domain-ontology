    skos:broader smn:AgeNotation ;
    skos:closeMatch <https://w3id.org/gcdfo/salmon#EuropeanAgeNotation> ;
    skos:definition "Salmon age notation that records the freshwater-age component followed by the ocean-age component, commonly separated by a period."@en ;
    skos:inScheme smn:AgeNotationScheme ;
    skos:notation "European"^^xsd:string ;
    skos:prefLabel "European age notation"@en ;
    skos:scopeNote "For example, 1.2 represents freshwater-age value 1 and ocean-age value 2 when the source declares European notation."@en .

smn:EvenYearCycleLine a skos:Concept ;
    obo:IAO_0000119 "The construct, and the invariance condition it depends on, are the broodline of Holtby, L.B. and Ciruna, K.A. 2007, Conservation Units for Pacific Salmon under the Wild Salmon Policy, DFO Canadian Science Advisory Secretariat Research Document 2007/070, glossary: in a semelparous species, if the age of reproduction is fixed or nearly so, the fish spawning in sequential generations are called broodlines, and in Pink Salmon there are even-year and odd-year broodlines in most rivers. That document treats the two as separate races for establishing Conservation Units. The name cycle line is this vocabulary's, not that document's, which uses broodline throughout; see the scope note on smn:CycleLine."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    skos:altLabel "Even Year"@en ;
    skos:broader smn:CycleLine ;
    skos:definition "The cycle line of a two-year-cycle population whose years, under the declared year basis, are even-numbered."@en ;
    skos:inScheme smn:CycleLineScheme ;
    skos:prefLabel "Even-year cycle line"@en ;
    skos:scopeNote "One half of the composite DFO Conservation Unit species code PKE, Pink-Even. Minted from the source code list rather than from observed data: DFO maintains even-year Pink Conservation Units, and a dataset holding only odd-year rows is a property of that dataset, not of the vocabulary."@en .

