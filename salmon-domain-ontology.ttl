    skos:altLabel "Fish stock"@en ;
    skos:closeMatch sosa:FeatureOfInterest .

smn:StockAssessment a owl:Class ;
    rdfs:label "Stock assessment"@en ;
    obo:IAO_0000115 "The scientific process of analyzing data to estimate abundance and productivity across time."@en ;
    obo:IAO_0000119 "Fisheries and Oceans Canada. Introduction to Stock Assessment. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/module-1/09-eng.html."@en ;
    dcterms:source <https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/module-1/09-eng.html> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
    rdfs:subClassOf obo:BFO_0000015 .

smn:SurvivalOrMortalityContext a skos:Concept ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:SurvivalOrMortalityContext."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:isDefinedBy <https://w3id.org/smn> ;
