smn:demeOf a owl:ObjectProperty ;
    rdfs:label "deme of"@en ;
    obo:IAO_0000115 "Relates a deme to the population it belongs to."@en ;
    obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:demeOf."@en ;
    dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
    rdfs:domain smn:Deme ;
