        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Salmon life stage</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/SalmonPopulationGroup -->

    <owl:Class rdf:about="https://w3id.org/smn/SalmonPopulationGroup">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/SalmonGroup"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Salmon population group</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/SalmonStockUnit -->

    <owl:Class rdf:about="https://w3id.org/smn/SalmonStockUnit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/SalmonGroup"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Salmon stock unit</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/SamplingEvent -->

    <owl:Class rdf:about="https://w3id.org/smn/SamplingEvent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasFeatureOfInterest"/>
                <owl:someValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasResult"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/resultTime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2006/time#Instant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A sampling activity that targets a geographic feature, yields a sample, and records a time.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A sampling activity that targets a geographic feature, yields a sample, and records a time.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Sampling event</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/StandardLengthMeasurement -->

    <owl:Class rdf:about="https://w3id.org/smn/StandardLengthMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/FishLengthMeasurementType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Standard length measurement</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/Stock -->

    <owl:Class rdf:about="https://w3id.org/smn/Stock">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/ReportingOrManagementStratum"/>
        <obo:IAO_0000115 xml:lang="en">An operationally defined grouping of salmon used for assessment and management purposes.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. Introduction to Stock Assessment - Glossary. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Stock</rdfs:label>
        <skos:altLabel xml:lang="en">Fish stock</skos:altLabel>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    </owl:Class>



    <!-- https://w3id.org/smn/StockAssessment -->

    <owl:Class rdf:about="https://w3id.org/smn/StockAssessment">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">The scientific process of analyzing data to estimate abundance and productivity across time.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. Introduction to Stock Assessment. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/module-1/09-eng.html.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/module-1/09-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Stock assessment</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/SurveyEvent -->

    <owl:Class rdf:about="https://w3id.org/smn/SurveyEvent">
        <rdfs:subClassOf rdf:resource="http://rs.tdwg.org/dwc/terms/Event"/>
        <obo:IAO_0000115 xml:lang="en">A field event that collects information about fish populations to evaluate status and support management decisions.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. About the Sustainability Survey for Fisheries. https://www.dfo-mpo.gc.ca/reports-rapports/regs/sff-cpd/survey-sondage/about-propos-en.html.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/reports-rapports/regs/sff-cpd/survey-sondage/about-propos-en.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Survey event</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    </owl:Class>



    <!-- https://w3id.org/smn/TargetOrLimitRateOrAbundance -->

    <owl:Class rdf:about="https://w3id.org/smn/TargetOrLimitRateOrAbundance">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">A value specification representing a policy- or model-defined target or limit, such as TAC, UMSY, or reference points.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.2, term gcdfo:TargetOrLimitRateOrAbundance.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Target or limit rate or abundance</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/TotalExploitationRate -->

    <owl:Class rdf:about="https://w3id.org/smn/TotalExploitationRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/ExploitationRate"/>
        <obo:IAO_0000115 xml:lang="en">The overall proportion of the total return of adult salmon removed by all fisheries over a defined period, aggregating across gear or fishery components.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.2, term gcdfo:TotalExploitationRate.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Total exploitation rate</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/TotalLengthMeasurement -->

