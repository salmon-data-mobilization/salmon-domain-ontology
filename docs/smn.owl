    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/usedProcedure"/>



    <!-- https://w3id.org/smn/basedOn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/basedOn">
        <rdfs:domain rdf:resource="https://w3id.org/smn/AggregatedMeasurement"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">based on</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/characteristicFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/characteristicFor">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">characteristic for</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/demeOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/demeOf">
        <owl:inverseOf rdf:resource="https://w3id.org/smn/hasDeme"/>
        <rdfs:domain rdf:resource="https://w3id.org/smn/Deme"/>
        <rdfs:range rdf:resource="https://w3id.org/smn/Population"/>
        <obo:IAO_0000115 xml:lang="en">Relates a deme to the population it belongs to.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:demeOf.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">deme of</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/hasCycleLine -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/hasCycleLine">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000115 xml:lang="en">Relates a Conservation Unit, population, or stock whose age at return is invariant to the cycle line that constitutes it as a reproductive lineage.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">This property makes the strong claim: the year series is closed under reproduction, so the line is a lineage and not merely a stratification. It is valid only where age at return is invariant — Pink Salmon, which return at age 2. Assigning a line to an individual fish is likewise only valid under that same invariance. Where age at return varies, as in Fraser Sockeye, use smn:stratifiedByCycleLine on the return-year record instead; a fish spawned on one line can return on another, so the class is not closed and the claim would be false.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">has cycle line</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/CycleLineScheme"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/hasDeme -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/hasDeme">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
        <rdfs:domain rdf:resource="https://w3id.org/smn/Population"/>
        <rdfs:range rdf:resource="https://w3id.org/smn/Deme"/>
        <obo:IAO_0000115 xml:lang="en">Relates a population to one of its constituent demes.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:hasDeme.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">has deme</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/hasEventType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/hasEventType">
        <rdfs:domain rdf:resource="https://w3id.org/smn/SamplingEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/smn/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">has event type</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/hasJuvenileFreshwaterResidenceDuration -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/hasJuvenileFreshwaterResidenceDuration">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000115 xml:lang="en">Relates a named life-history type to its value on the juvenile freshwater residence duration axis: how long juveniles remain in fresh water between emergence and seaward migration.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A vocabulary-structure property: its subject is a concept in smn:LifeHistoryTypeScheme, and it records the decomposition that defines that named type rather than an observation about any fish. Domain is omitted rather than asserted as skos:Concept, which would be true of every concept in module 07 and therefore say nothing. The name carries &quot;duration&quot; because without it the property reads as whether the group has a freshwater residence at all, which is true of every anadromous salmon and therefore says nothing; it carries &quot;juvenile&quot; because adults also reside in fresh water, on a migration this axis does not measure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">has juvenile freshwater residence duration</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/hasJuvenileRearingHabitat -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/hasJuvenileRearingHabitat">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000115 xml:lang="en">Relates a named life-history type to its value on the juvenile rearing habitat axis: the kind of fresh water in which juveniles rear before migrating to sea.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A vocabulary-structure property, like smn:hasJuvenileFreshwaterResidenceDuration. The value is a kind of water, never a named water body: smn:hasJuvenileRearingHabitat asserts lake-versus-flowing-water, and the unqualified name a future property relating a population to an actual lake or river would want is deliberately left free. &quot;Rearing&quot; rather than &quot;nursery&quot; because rearing habitat is the settled term for the juvenile freshwater growth phase in the Pacific salmon literature, while nursery area carries a distinct, largely marine and estuarine sense. A named type may carry no value on this axis: smn:SockeyeSeaTypeLifeHistory does not.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">has juvenile rearing habitat</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/JuvenileRearingHabitatScheme"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/hasLifeHistory -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/hasLifeHistory">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000115 xml:lang="en">Relates a Conservation Unit, population, or stock to a named life-history type from smn:LifeHistoryTypeScheme.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">One of the three life-history properties (Brett Johnson, 2026-08-24): this one assigns a named type, and smn:hasJuvenileFreshwaterResidenceDuration and smn:hasJuvenileRearingHabitat decompose what that type means. No generic axis-value property is minted. Assertion is at Conservation Unit, population, or stock level, not for an individual fish (Brett Johnson, 2026-08-17). The range is skos:Concept because the values are SKOS concepts; take them from smn:LifeHistoryTypeScheme, whose members are species-scoped.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">has life history</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/LifeHistoryTypeScheme"/>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/hasMeasurement -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/hasMeasurement">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:range rdf:resource="https://w3id.org/smn/Measurement"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">has measurement</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/hasPopulation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/hasPopulation">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
        <owl:inverseOf rdf:resource="https://w3id.org/smn/populationOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/smn/ReportingOrManagementStratum"/>
        <rdfs:range rdf:resource="https://w3id.org/smn/Population"/>
        <obo:IAO_0000115 xml:lang="en">Relates a reporting or management stratum to one of its constituent populations.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">has population</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/observedTaxonFamily -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/observedTaxonFamily">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_8015"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">observed taxon family</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/observedTaxonSpecies -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/observedTaxonSpecies">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_8018"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">observed taxon species</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/populationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/populationOf">
        <rdfs:domain rdf:resource="https://w3id.org/smn/Population"/>
        <rdfs:range rdf:resource="https://w3id.org/smn/ReportingOrManagementStratum"/>
        <obo:IAO_0000115 xml:lang="en">Relates a population to the reporting or management stratum it belongs to.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">population of</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/smn/stratifiedByCycleLine -->

    <owl:ObjectProperty rdf:about="https://w3id.org/smn/stratifiedByCycleLine">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000115 xml:lang="en">Relates a data record or observation carrying a return year to the cycle line that year falls in, as a stratification of the year series only.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">The weak, always-safe claim: the subject year belongs to that residue class under the declared year basis. It asserts nothing about reproductive independence and nothing about the fish, which is why it is the correct property for a population with variable age at return such as Fraser Sockeye. Use smn:hasCycleLine, on the population rather than the record, where age at return is invariant and the line really is a lineage. Domain is deliberately omitted for the same reason as on smn:broodYear: the subject may be an observation or a table row.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">stratified by cycle line</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/CycleLineScheme"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/ReturnYearBasis"/>
    </owl:ObjectProperty>



