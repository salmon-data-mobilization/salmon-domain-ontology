    <owl:Ontology rdf:about="https://w3id.org/smn">
        <owl:versionIRI rdf:resource="https://w3id.org/smn/0.0.3"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-14</dcterms:modified>
        <rdfs:comment xml:lang="en">Primary modular import graph for reusable salmon-domain concepts and cross-ontology alignments. Phase-1/2/3 scaffold and migration baseline.</rdfs:comment>
        <rdfs:label xml:lang="en">Salmon Domain Ontology (modular build)</rdfs:label>
        <owl:priorVersion rdf:resource="https://w3id.org/smn/0.0.3"/>
        <owl:versionInfo>0.0.3</owl:versionInfo>
    </owl:Ontology>



