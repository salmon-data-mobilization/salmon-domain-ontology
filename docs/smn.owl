        <skos:closeMatch rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
    </owl:Class>



    <!-- https://w3id.org/smn/Abundance -->

    <owl:Class rdf:about="https://w3id.org/smn/Abundance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Characteristic"/>
        <obo:IAO_0000115 xml:lang="en">A characteristic representing the quantity of salmon or other organisms associated with a defined entity, place, and time.</obo:IAO_0000115>
        <dcterms:source rdf:resource="http://qudt.org/vocab/quantitykind/Population"/>
        <rdfs:comment xml:lang="en">Use units, statistical modifiers, measurement context, and procedures to distinguish absolute counts, relative indices, estimates, expansions, and other representations. Those qualifiers do not change the reusable characteristic into a compound OWL class.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Abundance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://rs.tdwg.org/dwc/terms/individualCount"/>
        <skos:broadMatch rdf:resource="http://qudt.org/vocab/quantitykind/Count"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/Population"/>
    </owl:Class>



    <!-- https://w3id.org/smn/AggregatedMeasurement -->

    <owl:Class rdf:about="https://w3id.org/smn/AggregatedMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Measurement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/smn/basedOn"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The based-on restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration. The specific constraint — values must be method concepts at or below smn:EnumerationMethod in smn:MethodScheme — is normative and lives in ontology/shapes/method-shapes.ttl (smn:AggregatedMeasurementShape), expressed as a skos:broader* path, since someValuesFrom cannot range over concept individuals.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Aggregated measurement</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/BodyShape -->

    <owl:Class rdf:about="https://w3id.org/smn/BodyShape">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Characteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Body shape</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/CatchAbundance -->

    <owl:Class rdf:about="https://w3id.org/smn/CatchAbundance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/ObservedRateOrAbundance"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum recording the number of salmon represented in fishery catch for a defined fishery, place, time, or stock context.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Catch abundance</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/Abundance"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/CatchYearBasis"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/catchYear"/>
    </owl:Class>



    <!-- https://w3id.org/smn/Characteristic -->

    <owl:Class rdf:about="https://w3id.org/smn/Characteristic">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Characteristic</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/DataQualityAssessment -->

    <owl:Class rdf:about="https://w3id.org/smn/DataQualityAssessment">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An assessment artifact describing confidence, uncertainty, and quality constraints for a salmon data product or metric.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Data quality assessment</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/Deme -->

    <owl:Class rdf:about="https://w3id.org/smn/Deme">
        <rdfs:subClassOf rdf:resource="http://rs.tdwg.org/dwc/terms/Organism"/>
        <obo:IAO_0000115 xml:lang="en">A local interbreeding group of organisms within a species. In salmon, a deme typically corresponds to a spawning population at a specific site. Demes are the finest biological unit and make up populations.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:Deme.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Deme</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/Entity -->

    <owl:Class rdf:about="https://w3id.org/smn/Entity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iadopt/ont/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Entity</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/Escapement -->

    <owl:Class rdf:about="https://w3id.org/smn/Escapement">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">The number of mature salmon that pass through (or escape) fisheries and return to fresh water to spawn.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. 2005. Canada&apos;s Policy for Conservation of Wild Pacific Salmon. https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/315577.pdf.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/315577.pdf"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Escapement</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/EscapementEstimate -->

    <owl:Class rdf:about="https://w3id.org/smn/EscapementEstimate">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">A measurement or estimate of escapement tied to a stock and a survey event.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.2, term gcdfo:EscapementMeasurement.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl"/>
        <rdfs:comment xml:lang="en">A datum (IAO measurement datum), not an activity: the corresponding survey activity is smn:EscapementSurveyEvent. Renamed from smn:EscapementMeasurement on 2026-08-13 (alignment pass, finding F6) because every other *Measurement class in this module is a subclass of the activity smn:Measurement, and this one is not — the name was the defect, inherited verbatim from gcdfo:EscapementMeasurement, whose hyponym family should be coordinated in the boundary pass.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Escapement estimate</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/sosa/Result"/>
    </owl:Class>



    <!-- https://w3id.org/smn/EscapementSurveyEvent -->

    <owl:Class rdf:about="https://w3id.org/smn/EscapementSurveyEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/SurveyEvent"/>
        <obo:IAO_0000115 xml:lang="en">A survey event specifically for estimating escapement.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.2, term gcdfo:EscapementSurveyEvent.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Escapement survey event</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    </owl:Class>



    <!-- https://w3id.org/smn/EventType -->

    <owl:Class rdf:about="https://w3id.org/smn/EventType">
        <obo:IAO_0000115 xml:lang="en">A class used to categorize fisheries or survey event instances by operational type.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Event type</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/ExploitationRate -->

    <owl:Class rdf:about="https://w3id.org/smn/ExploitationRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/TargetOrLimitRateOrAbundance"/>
        <obo:IAO_0000115 xml:lang="en">The proportion of returning adult salmon removed by fishing activity over a defined period.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Exploitation rate</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/FishLength -->

    <owl:Class rdf:about="https://w3id.org/smn/FishLength">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/MorphologicalCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Fish length</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/FishLengthMeasurementType -->

    <owl:Class rdf:about="https://w3id.org/smn/FishLengthMeasurementType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Measurement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/smn/FishLength"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/usedProcedure"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The used-procedure restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration: the specific length-method concepts are individuals in module 07&apos;s smn:MethodScheme, and someValuesFrom needs a class.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Fish length measurement type</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/FishWeight -->

    <owl:Class rdf:about="https://w3id.org/smn/FishWeight">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/MorphologicalCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Fish weight</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/FishingType -->

    <owl:Class rdf:about="https://w3id.org/smn/FishingType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/EventType"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Fishing type</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/ForkLengthMeasurement -->

    <owl:Class rdf:about="https://w3id.org/smn/ForkLengthMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/FishLengthMeasurementType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/smn/forkLength"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Fork-length measurement</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/GeographicFeature -->

    <owl:Class rdf:about="https://w3id.org/smn/GeographicFeature">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Geographic feature</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/HabitatUnit -->

    <owl:Class rdf:about="https://w3id.org/smn/HabitatUnit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Entity"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Habitat unit</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/IndicatorRiver -->

    <owl:Class rdf:about="https://w3id.org/smn/IndicatorRiver">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/GeographicFeature"/>
        <obo:IAO_0000115 xml:lang="en">A river or stream used as a relatively reliable abundance index for nearby salmon returns due to survey intensity and method quality.</obo:IAO_0000115>
        <dcterms:source rdf:resource="https://www.salmonexplorer.ca/methods/glossary.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Indicator river</rdfs:label>
        <skos:altLabel xml:lang="en">Indicator stream</skos:altLabel>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    </owl:Class>



    <!-- https://w3id.org/smn/IndividualMeasurement -->

    <owl:Class rdf:about="https://w3id.org/smn/IndividualMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Measurement"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Individual measurement</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/Life-HistoryCharacteristic -->

    <owl:Class rdf:about="https://w3id.org/smn/Life-HistoryCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Characteristic"/>
        <rdfs:comment xml:lang="en">A characteristic that can be observed, not a controlled value. Do not use this IRI as the vocabulary identifier for a coded life-history column: the values belong to module 07&apos;s smn:LifeHistoryTypeScheme and its two axis schemes, smn:JuvenileFreshwaterResidenceDurationScheme and smn:JuvenileRearingHabitatScheme, and a code list needs a skos:ConceptScheme, not an owl:Class (CONVENTIONS sections 3 and 4).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Life-history characteristic</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/LimitReferencePoint -->

    <owl:Class rdf:about="https://w3id.org/smn/LimitReferencePoint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/ReferencePoint"/>
        <obo:IAO_0000115 xml:lang="en">A lower threshold indicating stock status where stronger mitigation or rebuilding action is triggered.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. Introduction to Stock Assessment - Glossary. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Limit reference point</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/Measurement -->

    <owl:Class rdf:about="https://w3id.org/smn/Measurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/hasFeatureOfInterest"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/smn/Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/smn/Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A salmon-domain observation focused on one feature of interest and one characteristic.</obo:IAO_0000115>
        <rdfs:comment xml:lang="en">A salmon-domain observation focused on one feature of interest and one characteristic.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Measurement</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/MethodDocumentation -->

    <owl:Class rdf:about="https://w3id.org/smn/MethodDocumentation">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A documented method description linked to how a salmon metric or estimate was produced.</obo:IAO_0000115>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Method documentation</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/MetricBenchmark -->

    <owl:Class rdf:about="https://w3id.org/smn/MetricBenchmark">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">Benchmark value for a metric used to delineate status categories.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Pestal, G., MacDonald, B.L., Grant, S.C.H., and Holt, C.A. 2023. State of the salmon: rapid status assessment approach for Pacific salmon under Canada&apos;s Wild Salmon Policy. Canadian Technical Report of Fisheries and Aquatic Sciences 3570.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://publications.gc.ca/site/eng/9.928944/publication.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Metric benchmark</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/ModelMeasurement -->

    <owl:Class rdf:about="https://w3id.org/smn/ModelMeasurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Measurement"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Model measurement</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/MorphologicalCharacteristic -->

    <owl:Class rdf:about="https://w3id.org/smn/MorphologicalCharacteristic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Characteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Morphological characteristic</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/NCBITaxon_8018 -->

    <owl:Class rdf:about="https://w3id.org/smn/NCBITaxon_8018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_8018"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Oncorhynchus keta proxy class</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/Observation -->

    <owl:Class rdf:about="https://w3id.org/smn/Observation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Observation</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/ObservedRateOrAbundance -->

    <owl:Class rdf:about="https://w3id.org/smn/ObservedRateOrAbundance">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum representing an empirically observed rate, count, or abundance derived from monitoring or survey data.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.2, term gcdfo:ObservedRateOrAbundance.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Observed rate or abundance</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/Population -->

    <owl:Class rdf:about="https://w3id.org/smn/Population">
        <rdfs:subClassOf rdf:resource="http://rs.tdwg.org/dwc/terms/Organism"/>
        <obo:IAO_0000115 xml:lang="en">A group of organisms of the same species occupying a defined area that interbreed and share a gene pool. In salmon, populations are composed of one or more demes and form the biological basis for Conservation Units.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:Population.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Population</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/smn/RecruitAbundance -->

    <owl:Class rdf:about="https://w3id.org/smn/RecruitAbundance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/ObservedRateOrAbundance"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum recording the abundance of recruits contributing to a salmon stock, population, or indicator return series.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html"/>
        <rdfs:comment xml:lang="en">Represent the measured characteristic with smn:Abundance. Use smn:broodYear and smn:returnYear for row-varying xsd:gYear coordinates, and use the separate SKOS basis concepts when a standalone variable description needs the corresponding fixed semantic qualifier.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Recruit abundance</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/Abundance"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/BroodYearBasis"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/ReturnYearBasis"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/broodYear"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/returnYear"/>
    </owl:Class>



    <!-- https://w3id.org/smn/ReferencePoint -->

    <owl:Class rdf:about="https://w3id.org/smn/ReferencePoint">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A target or limit used to guide management actions.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. Introduction to Stock Assessment - Glossary. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Reference point</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/iadopt/ont/Constraint"/>
    </owl:Class>



    <!-- https://w3id.org/smn/ReportingOrManagementStratum -->

    <owl:Class rdf:about="https://w3id.org/smn/ReportingOrManagementStratum">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information-defined grouping of fish populations used for reporting, conservation assessment, or management purposes. Examples include Conservation Units (CUs), Stock Management Units (MUs), and Designatable Units (DUs).</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.2, term gcdfo:ReportingOrManagementStratum.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Reporting or management stratum</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
    </owl:Class>



    <!-- https://w3id.org/smn/Run -->

    <owl:Class rdf:about="https://w3id.org/smn/Run">
        <rdfs:subClassOf rdf:resource="https://w3id.org/smn/Life-HistoryCharacteristic"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">Run</rdfs:label>
    </owl:Class>



