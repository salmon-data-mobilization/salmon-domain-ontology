    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/FreshwaterAgeDimension -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/FreshwaterAgeDimension">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology term gcdfo:FreshwaterAgeDimension.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/AgeDimension"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#FreshwaterAgeDimension"/>
        <skos:definition xml:lang="en">Age dimension whose value represents the freshwater component of salmon age under the declared age convention.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeDimensionScheme"/>
        <skos:prefLabel xml:lang="en">Freshwater-age dimension</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/GilbertRichAgeNotation -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/GilbertRichAgeNotation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology term gcdfo:GilbertRichAgeNotation.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.pac.dfo-mpo.gc.ca/fm-gp/fraser/docs/archiv-reports-rapports/indigenous-autochtone/2010FrasRvrChkInformDoc.htm"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:altLabel xml:lang="en">GR age notation</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/AgeNotation"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#GilbertRichAgeNotation"/>
        <skos:definition xml:lang="en">Salmon age notation in which total age is annotated with the freshwater-age component as a subscript-like suffix.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeNotationScheme"/>
        <skos:notation>Gilbert-Rich</skos:notation>
        <skos:prefLabel xml:lang="en">Gilbert-Rich age notation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">For example, an encoded value 42 may decompose to total-age value 4 and freshwater-age value 2 only when the source declares Gilbert-Rich notation. Do not infer that decomposition from a two-digit string alone.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/HatcheryOrigin -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/HatcheryOrigin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. 2018. Review of genetically based targets for enhanced contributions to Canadian Pacific Chinook Salmon populations. DFO Canadian Science Advisory Secretariat Science Advisory Report 2018/001 (Erratum: October 2023).</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/csas-sccs/Publications/SAR-AS/2018/2018_001-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/SalmonOrigin"/>
        <skos:definition xml:lang="en">Individuals that were born or reared in a hatchery facility.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/SalmonOriginScheme"/>
        <skos:prefLabel xml:lang="en">Hatchery-origin</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/InRiverPhase -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/InRiverPhase">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:InRiverPhase.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/LifePhase"/>
        <skos:definition xml:lang="en">Freshwater in-river phase (migration and/or residence) outside the marine environment.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifePhaseScheme"/>
        <skos:prefLabel xml:lang="en">In-river phase</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/JuvenileFreshwaterResidenceDuration -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/JuvenileFreshwaterResidenceDuration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">The duration axis is the original scale-reading distinction of Gilbert, C.H. 1913, Age at maturity of the Pacific coast salmon of the genus Oncorhynchus, Bulletin of the United States Bureau of Fisheries 32:1-22. Its modern statement for Sockeye Salmon, in freshwater-annulus terms, is Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">The length of time juveniles of a salmon group remain in fresh water between emergence and seaward migration, expressed as a controlled value.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme"/>
        <skos:prefLabel xml:lang="en">Juvenile freshwater residence duration</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <obo:IAO_0000119 xml:lang="en">The duration axis is the original scale-reading distinction of Gilbert, C.H. 1913, Age at maturity of the Pacific coast salmon of the genus Oncorhynchus, Bulletin of the United States Bureau of Fisheries 32:1-22, whose sea type and stream type separate fish by whether the scale nucleus records a freshwater winter. Its modern statement for Sockeye Salmon, in freshwater-annulus terms, is Beacham, T.D. and Withler, R.E. 2017, Population structure of sea-type and lake-type sockeye salmon and kokanee in the Fraser River and Columbia River drainages, PLOS ONE 12(9):e0183713.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary for the duration axis of juvenile salmon life history: how long juveniles remain in fresh water between emergence and seaward migration.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/JuvenileFreshwaterResidenceDuration"/>
        <skos:prefLabel xml:lang="en">Juvenile freshwater residence duration scheme</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Species-neutral by construction. This is an axis a named life-history type is defined from, not a life-history type itself: a value here carries no claim about where juveniles reared, how adults behave, or what genetic structure the group has. It is also not age at maturity, which Healey (1991) treats as tactical variation within a race rather than as race-defining. The scheme is deliberately coarse — a two-valued cut at the first freshwater winter — because that cut is what a scale reader can actually determine: a fish that overwinters in fresh water lays down a freshwater annulus and one that does not, does not.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/JuvenileRearingHabitat -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/JuvenileRearingHabitat">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">The lake-versus-riverine rearing distinction in Sockeye Salmon is stated by Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">The kind of rearing environment in which juveniles of a salmon group grow before migrating to sea, expressed as a controlled value.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/JuvenileRearingHabitatScheme"/>
        <skos:prefLabel xml:lang="en">Juvenile rearing habitat</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/JuvenileRearingHabitatScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/JuvenileRearingHabitatScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/JuvenileRearingHabitatScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <obo:IAO_0000119 xml:lang="en">The lake-versus-riverine rearing distinction in Sockeye Salmon is stated by Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, which groups the river-type and sea-type forms together on the ground that neither rears in lakes. It is also the cut DFO itself makes: the glossary of Holtby, L.B. and Ciruna, K.A. 2007, DFO Can. Sci. Advis. Sec. Res. Doc. 2007/070, defines the river/ocean-types of sockeye as juveniles adapted to rearing in flowing water instead of lakes.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary for the habitat axis of juvenile salmon life history: the kind of rearing environment juveniles occupy between emergence and seaward migration.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/JuvenileRearingHabitat"/>
        <skos:prefLabel xml:lang="en">Juvenile rearing habitat scheme</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Species-neutral by construction, and independent of the duration axis: the same kind of rearing habitat is used by groups that leave in their first year and by groups that stay a year or more, which is why the two axes cross-classify rather than nest. Values are kinds of water, never named water bodies; a property relating a population to an actual lake or river is a different property and is not minted here. Do not populate this scheme with the potamodromous vocabulary adfluvial / fluvial / lacustrine (Rieman and McIntyre 1993), despite lacustrine resembling lake and fluvial resembling river. That vocabulary classifies migration patterns completed within fresh water and treats anadromy as a separate category alongside them, so calling an anadromous Sockeye population adfluvial is a category error. Applying it to non-anadromous Oncorhynchus nerka (kokanee) is defensible and would be a different scheme.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/LakeRearingHabitat -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/LakeRearingHabitat">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, whose lake-type Sockeye Salmon rear in nursery lakes.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/JuvenileRearingHabitat"/>
        <skos:definition xml:lang="en">Rearing habitat in which juveniles grow in a lake, typically a nursery lake associated with the spawning tributary.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/JuvenileRearingHabitatScheme"/>
        <skos:prefLabel xml:lang="en">Lake rearing habitat</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/LifeHistoryType -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/LifeHistoryType">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Life history is one of the three primary characteristics used to delimit Pacific salmon Conservation Units, alongside ecotypology and genetics. Holtby, L.B. and Ciruna, K.A. 2007. Conservation Units for Pacific Salmon under the Wild Salmon Policy. DFO Canadian Science Advisory Secretariat Research Document 2007/070.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">A named, recurring pattern of habitat use and life-cycle timing that distinguishes one group of salmon from another within a single species.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifeHistoryTypeScheme"/>
        <skos:prefLabel xml:lang="en">Life-history type</skos:prefLabel>
        <skos:scopeNote xml:lang="en">An open vocabulary; the minted narrower concepts cover Sockeye Salmon only, and they are asserted as flat siblings pending a ruling on whether the sea-type and river-type forms should instead be grouped against lake-type. Chinook ocean-type and stream-type are deliberately not minted: the bundle they name is not stable across the species range (Waples et al. 2004 report a deep interior-Columbia division alongside within-basin run-type divergence an order of magnitude smaller, and Moran et al. 2013 find the two-race model does not hold coast-wide), and Healey (1991) states he cannot classify the Sacramento winter run, which pairs stream-type adult behaviour with ocean-type juvenile behaviour. The axis schemes exist so that such a group can be described exactly, one axis at a time, without forcing a named type that does not fit. Run timing is modelled separately as the OWL class smn:Run.</skos:scopeNote>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/LifeHistoryTypeScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/LifeHistoryTypeScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/LifeHistoryTypeScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <obo:IAO_0000119 xml:lang="en">Life history is one of the three primary characteristics used to delimit Pacific salmon Conservation Units, alongside ecotypology and genetics. Holtby, L.B. and Ciruna, K.A. 2007. Conservation Units for Pacific Salmon under the Wild Salmon Policy. DFO Canadian Science Advisory Secretariat Research Document 2007/070.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary of named salmon life-history types. Each concept is scoped to a single species and is defined as a combination of values from the life-history axis schemes rather than as a primitive.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/LifeHistoryType"/>
        <skos:prefLabel xml:lang="en">Life-history type scheme</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Every named type in this scheme is species-scoped, and a type from one species is never assumed to mean a type from another: sockeye river-type is not chinook stream-type despite the near-identical English. Species is carried on each concept as a dwc:scientificName literal plus a WoRMS dwc:scientificNameID, not as an smn: species concept, and no smn: species concept or class exists to point at (Brett Johnson, 2026-08-24). A flat cross-species enumeration of these names is the failure mode this scheme is shaped to prevent, because the strings are similar enough to merge automatically and wrong to merge. Assertion is at Conservation Unit, population, or stock level, never for an individual fish (Brett Johnson, 2026-08-17), using smn:hasLifeHistory. Cycle line has its own vocabulary, smn:CycleLineScheme; do not add cycle-line values here.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/LifePhase -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/LifePhase">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:LifePhase.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">A phase or segment used to stratify salmon measurements by where or when they apply (e.g., ocean phase, terminal phase).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifePhaseScheme"/>
        <skos:prefLabel xml:lang="en">Life phase</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/LifePhaseScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/LifePhaseScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:LifePhaseScheme.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary for life-phase or fishery/migration segment qualifiers used to stratify measurements (e.g., ocean, terminal, mainstem).</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/LifePhase"/>
        <skos:prefLabel xml:lang="en">Life phase scheme</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/MainstemPhase -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/MainstemPhase">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:MainstemPhase.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/LifePhase"/>
        <skos:definition xml:lang="en">Freshwater mainstem migration phase in a river system (often corresponding to mainstem in-river fisheries or monitoring segments).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifePhaseScheme"/>
        <skos:prefLabel xml:lang="en">Mainstem phase</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/MaximumStatisticalModifier -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/MaximumStatisticalModifier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/iadopt/ont/StatisticalModifier"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/maximum"/>
        <skos:definition xml:lang="en">The reported value is the maximum of the summarized observations.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
        <skos:prefLabel xml:lang="en">Maximum</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/MeanStatisticalModifier -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/MeanStatisticalModifier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/iadopt/ont/StatisticalModifier"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/average"/>
        <skos:definition xml:lang="en">The reported value is the arithmetic mean of the summarized observations.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
        <skos:prefLabel xml:lang="en">Mean</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/MeasurementContext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/MeasurementContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:MeasurementContext.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">A context qualifier used to disambiguate the interpretation of a measurement column.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/MeasurementContextScheme"/>
        <skos:prefLabel xml:lang="en">Measurement context</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/MeasurementContextScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/MeasurementContextScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:MeasurementContextScheme.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary for compositional measurement context qualifiers (for example, catch context, run context).</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/MeasurementContext"/>
        <skos:prefLabel xml:lang="en">Measurement context scheme</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/MedianStatisticalModifier -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/MedianStatisticalModifier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/iadopt/ont/StatisticalModifier"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/median"/>
        <skos:definition xml:lang="en">The reported value is the median of the summarized observations.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
        <skos:prefLabel xml:lang="en">Median</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/MethodScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/MethodScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary of shared, policy-neutral salmon observation and measurement methods. Organization- or program-specific method taxonomies remain profile-scoped (CONVENTIONS section 11).</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/EnumerationMethod"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/FishLengthMeasurementMethod"/>
        <skos:prefLabel xml:lang="en">Method scheme</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/MinimumStatisticalModifier -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/MinimumStatisticalModifier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/iadopt/ont/StatisticalModifier"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/minimum"/>
        <skos:definition xml:lang="en">The reported value is the minimum of the summarized observations.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
        <skos:prefLabel xml:lang="en">Minimum</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/NaturalOrigin -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/NaturalOrigin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Fisheries and Oceans Canada. 2018. Review of genetically based targets for enhanced contributions to Canadian Pacific Chinook Salmon populations. DFO Canadian Science Advisory Secretariat Science Advisory Report 2018/001 (Erratum: October 2023).</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/csas-sccs/Publications/SAR-AS/2018/2018_001-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/SalmonOrigin"/>
        <skos:definition xml:lang="en">Individuals that are born and reared in the wild (natural environment).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/SalmonOriginScheme"/>
        <skos:prefLabel xml:lang="en">Natural-origin</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/OceanAgeDimension -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/OceanAgeDimension">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology term gcdfo:OceanAgeDimension.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:altLabel xml:lang="en">Marine-age dimension</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/AgeDimension"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#OceanAgeDimension"/>
        <skos:definition xml:lang="en">Age dimension whose value represents the marine component of salmon age under the declared age convention.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeDimensionScheme"/>
        <skos:prefLabel xml:lang="en">Ocean-age dimension</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/OceanPhase -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/OceanPhase">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:OceanPhase.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:altLabel xml:lang="en">Marine phase</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/LifePhase"/>
        <skos:definition xml:lang="en">Phase of the salmon life cycle or assessment period occurring in the marine environment.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifePhaseScheme"/>
        <skos:prefLabel xml:lang="en">Ocean phase</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/OddYearCycleLine -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/OddYearCycleLine">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">The construct, and the invariance condition it depends on, are the broodline of Holtby, L.B. and Ciruna, K.A. 2007, Conservation Units for Pacific Salmon under the Wild Salmon Policy, DFO Canadian Science Advisory Secretariat Research Document 2007/070, glossary: in a semelparous species, if the age of reproduction is fixed or nearly so, the fish spawning in sequential generations are called broodlines, and in Pink Salmon there are even-year and odd-year broodlines in most rivers. That document treats the two as separate races for establishing Conservation Units. The name cycle line is this vocabulary&apos;s, not that document&apos;s, which uses broodline throughout; see the scope note on smn:CycleLine.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:altLabel xml:lang="en">Odd Year</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/CycleLine"/>
        <skos:definition xml:lang="en">The cycle line of a two-year-cycle population whose years, under the declared year basis, are odd-numbered.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/CycleLineScheme"/>
        <skos:prefLabel xml:lang="en">Odd-year cycle line</skos:prefLabel>
        <skos:scopeNote xml:lang="en">One half of the composite DFO Conservation Unit species code PKO, Pink-Odd, whose other half is the species. Scoped to two-year-cycle populations because that is the case in which the odd-year series is also closed under reproduction; for a longer or variable cycle period the parity of a year is not a lineage.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/PeakStatisticalModifier -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/PeakStatisticalModifier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/iadopt/ont/StatisticalModifier"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">The reported value is the peak (highest single observation event) across the summarized series, such as a peak live count in a spawner survey.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
        <skos:prefLabel xml:lang="en">Peak</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/ReturnYearBasis -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/ReturnYearBasis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Pacific Salmon Commission Fraser River Sockeye Salmon Stock-Recruitment Data.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.psc.org/publications/data/fraser-sockeye-stock-recruit-dataset/"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/YearBasis"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#ReturnYear"/>
        <skos:definition xml:lang="en">A year-reference basis in which a calendar year identifies when members of a salmon cohort make the adult return relevant to the dataset&apos;s declared location or event.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/YearBasisScheme"/>
        <skos:prefLabel xml:lang="en">Return-year basis</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Return year and catch year are distinct. Document the location or event at which return is defined separately; use smn:returnYear for the xsd:gYear coordinate.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/RiverineRearingHabitat -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/RiverineRearingHabitat">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, whose sea-type and river-type Sockeye Salmon both rear in river habitats, with sea-type juveniles rearing for several months in estuarine waters.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/JuvenileRearingHabitat"/>
        <skos:definition xml:lang="en">Rearing habitat in which juveniles grow in flowing water, or in an associated slough or estuary, rather than in a lake.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/JuvenileRearingHabitatScheme"/>
        <skos:prefLabel xml:lang="en">Riverine rearing habitat</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Deliberately spans the river-slough-estuary continuum rather than cutting it, because the Sockeye Salmon groups that use it are reported across that whole range and the distinction that separates those groups is duration, not position along the continuum. Where an estuarine-versus-fluvial distinction is itself the subject, model it as a narrower concept rather than by reinterpreting this one.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/RunContext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/RunContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:RunContext.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/MeasurementContext"/>
        <skos:definition xml:lang="en">Measurement context indicating values refer to run size or returning run composition.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/MeasurementContextScheme"/>
        <skos:prefLabel xml:lang="en">Run context</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/SalmonOrigin -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/SalmonOrigin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:SalmonOrigin.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Origin category describing whether salmon are naturally produced, hatchery produced, or mixed-origin.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/SalmonOriginScheme"/>
        <skos:prefLabel xml:lang="en">Salmon origin</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/SalmonOriginScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/SalmonOriginScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.2, term gcdfo:SalmonOriginScheme.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary for describing the origin of individual salmon (e.g., natural-origin, hatchery-origin, mixed-origin).</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/SalmonOrigin"/>
        <skos:prefLabel xml:lang="en">Salmon origin scheme</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/SockeyeLakeTypeLifeHistory -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/SockeyeLakeTypeLifeHistory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <smn:hasJuvenileFreshwaterResidenceDuration rdf:resource="https://w3id.org/smn/YearlingFreshwaterResidence"/>
        <smn:hasJuvenileRearingHabitat rdf:resource="https://w3id.org/smn/LakeRearingHabitat"/>
        <obo:IAO_0000119 xml:lang="en">Beacham, T.D. and Withler, R.E. 2017, Population structure of sea-type and lake-type sockeye salmon and kokanee in the Fraser River and Columbia River drainages, PLOS ONE 12(9):e0183713. Used as a Conservation Unit delimiting axis by Holtby, L.B. and Ciruna, K.A. 2007, DFO Can. Sci. Advis. Sec. Res. Doc. 2007/070. Burgner, R.L. 1991, Life history of sockeye salmon (Oncorhynchus nerka), in Groot, C. and Margolis, L. (eds.), Pacific Salmon Life Histories, UBC Press, pages 3-117, is the customary citation for the lake-type form specifically; it is recorded here rather than relied on, because the chapter could not be read.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <dwc:scientificName>Oncorhynchus nerka</dwc:scientificName>
        <dwc:scientificNameID>urn:lsid:marinespecies.org:taxname:254569</dwc:scientificNameID>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:seeAlso rdf:resource="https://www.marinespecies.org/aphia.php?p=taxdetails&amp;id=254569"/>
        <skos:altLabel xml:lang="en">Lake Type</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/LifeHistoryType"/>
        <skos:definition xml:lang="en">Life-history type of Sockeye Salmon in which juveniles rear in a nursery lake for at least one year before migrating to sea: yearling-or-older freshwater residence combined with lake rearing habitat.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifeHistoryTypeScheme"/>
        <skos:prefLabel xml:lang="en">Lake-type Sockeye life history</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is the one Sockeye type whose DFO Conservation Unit code is unambiguous: SEL decomposes into this concept plus the species, and nothing else. Its sibling code SER does not — see smn:SockeyeRiverTypeLifeHistory. The altLabel is the bare string used in source data; outside the SEL context that string does not name a species, which is why the concept does.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/SockeyeRiverTypeLifeHistory -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/SockeyeRiverTypeLifeHistory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <smn:hasJuvenileFreshwaterResidenceDuration rdf:resource="https://w3id.org/smn/YearlingFreshwaterResidence"/>
        <smn:hasJuvenileRearingHabitat rdf:resource="https://w3id.org/smn/RiverineRearingHabitat"/>
        <obo:IAO_0000119 xml:lang="en">The label river-type sockeye traces to Semko 1954, per Wood, C.C., Riddell, B.E., and Rutherford, D.T. 1987, Can. Spec. Publ. Fish. Aquat. Sci. 96:12-24, and Wood, C.C., Bickham, J.W., Nelson, R.J., Foote, C.J., and Patton, J.C. 2008, Recurrent evolution of life history ecotypes in sockeye salmon, Evolutionary Applications 1:207-221. The one-to-two-year riverine rearing sense: DFO Can. Sci. Advis. Sec. Sci. Advis. Rep. 2022/003, Recovery Potential Assessment for Fraser River Sockeye Salmon, Nine Designatable Units, Part 2. The breadth of DFO&apos;s SER code is from the Conservation Unit data dictionary published with the Pacific salmon Conservation Unit datasets, verified 2026-08-25. Attribution caution: Pavey et al. 2010 inverts the Semko and Gilbert credits between river-type and sea-type; Wood et al. 1987 is earlier and is followed here.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1111/j.1752-4571.2008.00028.x"/>
        <dwc:scientificName>Oncorhynchus nerka</dwc:scientificName>
        <dwc:scientificNameID>urn:lsid:marinespecies.org:taxname:254569</dwc:scientificNameID>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:seeAlso rdf:resource="https://www.marinespecies.org/aphia.php?p=taxdetails&amp;id=254569"/>
        <skos:altLabel xml:lang="en">River Type</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/LifeHistoryType"/>
        <skos:definition xml:lang="en">Life-history type of Sockeye Salmon in which juveniles rear for one to two years in flowing water, or an associated slough, rather than in a lake, and so carry at least one freshwater annulus: yearling-or-older freshwater residence combined with riverine rearing habitat.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifeHistoryTypeScheme"/>
        <skos:prefLabel xml:lang="en">River-type Sockeye life history</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This concept is NOT the whole of the DFO Conservation Unit species code SER, and mapping SER onto it alone is wrong. DFO&apos;s Conservation Unit data dictionary glosses SER as &quot;River or Ocean Type Sockeye Salmon&quot; (French: &quot;saumon rouge de type riviere ou ocean&quot;), so the code&apos;s non-species half is a disjunction of this concept and smn:SockeyeSeaTypeLifeHistory, which take opposite values on the freshwater residence duration axis. DFO&apos;s Conservation Unit lookup renders the same code with the shorter label RIVER TYPE SOCKEYE SALMON and files under it both WIDGEON (SER-02) and HARRISON RIVER (SER-03), which are the two populations the Sockeye literature identifies as sea-type; DFO CSAS Science Advisory Report 2022/003 states of designatable unit DU24, Widgeon-RT, that &quot;it is not a true river-type population; these fish migrate to sea in their first year and do not overwinter in freshwater stream habitat&quot;, and calls it the only ocean-type population in that assessment. The breadth is deliberate and traceable rather than a slip: Holtby and Ciruna (2007), the framework DFO cites for its Conservation Units, names the second Sockeye life-history type the &quot;ocean-, stream- or river-type&quot;, says its juveniles rear in flowing water and may smolt soon after emergence, and glosses it in the document glossary as juveniles adapted to rearing in flowing water instead of lakes. DFO&apos;s category is therefore cut on the rearing habitat axis, where this concept and smn:SockeyeSeaTypeLifeHistory agree, and not on the duration axis, where they differ. A SER row cannot be resolved to a life-history type without population-level knowledge; the honest mapping of the code is to the species plus smn:RiverineRearingHabitat, which is what SER actually asserts, and not to this concept. This concept is also not chinook stream-type: the English is near-identical, the species differs, and the chinook term additionally carries an adult behavioural syndrome that this concept does not assert.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/SockeyeSeaTypeLifeHistory -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/SockeyeSeaTypeLifeHistory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <smn:hasJuvenileFreshwaterResidenceDuration rdf:resource="https://w3id.org/smn/SubyearlingFreshwaterResidence"/>
        <smn:hasJuvenileRearingHabitat rdf:resource="https://w3id.org/smn/RiverineRearingHabitat"/>
        <obo:IAO_0000119 xml:lang="en">The ecotype label sea-type sockeye salmon: Wood, C.C., Riddell, B.E., and Rutherford, D.T. 1987, Can. Spec. Publ. Fish. Aquat. Sci. 96:12-24. The underlying scale-reading term sea type, and the phrase itself: Gilbert, C.H. 1913, Age at maturity of the Pacific coast salmon of the genus Oncorhynchus, Bulletin of the United States Bureau of Fisheries 32:1-22, page 8, in the Sockeye section. The freshwater-annulus discriminator, and the identification of Harrison River and Widgeon Slough as the sea-type populations: Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713. The chinook rename that created the ocean-type ambiguity: Healey, M.C. 1991, Life history of chinook salmon (Oncorhynchus tshawytscha), in Groot, C. and Margolis, L. (eds.), Pacific Salmon Life Histories, UBC Press, page 314. Not Burgner 1991, which the 2026-08-17 draft cited here and which the citation record attaches to lake-type rather than to this concept.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <dwc:scientificName>Oncorhynchus nerka</dwc:scientificName>
        <dwc:scientificNameID>urn:lsid:marinespecies.org:taxname:254569</dwc:scientificNameID>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:seeAlso rdf:resource="https://www.marinespecies.org/aphia.php?p=taxdetails&amp;id=254569"/>
        <skos:altLabel xml:lang="en">Ocean Type</skos:altLabel>
        <skos:altLabel xml:lang="en">Sea Type</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/LifeHistoryType"/>
        <skos:definition xml:lang="en">Life-history type of Sockeye Salmon in which juveniles migrate seaward during their first year, rearing for weeks to months in flowing water, sloughs, or the estuary without overwintering in fresh water, and so carry no freshwater annulus: subyearling freshwater residence combined with riverine rearing habitat.</skos:definition>
        <skos:historyNote xml:lang="en">The 2026-08-17 draft of this concept asserted the opposite history, that sea-type was Gilbert&apos;s name for chinook and had been taken over by Sockeye Salmon. That is backwards and was replaced on 2026-08-25 after Gilbert (1913) was read: the term is introduced at page 8, inside the Sockeye section, and the chinook section at page 13 defines its types by reference to the Sockeye ones. The draft also asserted that this type has no rearing habitat worth naming; Beacham and Withler (2017) report that sea-type and river-type juveniles both rear in river habitats, so a habitat value is now asserted.</skos:historyNote>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifeHistoryTypeScheme"/>
        <skos:prefLabel xml:lang="en">Sea-type Sockeye life history</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The discriminator is the freshwater annulus, not the label. Match on the definition, not on either string, because both strings are unsafe in different ways. &quot;Ocean Type&quot; is carried as an altLabel because DFO uses it for this concept, but it is AMBIGUOUS and must not be used as a matching key: DFO CSAS Res. Doc. 2017/074 declares river-type synonymous with ocean-type, which makes ocean-type the complement of lake-type and therefore broader than this concept, while DFO CSAS Res. Doc. 2023/003 uses ocean-type in exactly this concept&apos;s narrow sense and opposes it to river-type. Both are current. &quot;Sea-type&quot; is the older and more stable name: Gilbert (1913) coined sea type in his Sockeye Salmon section and applied it across five species, against a contrasting stream type, and the Sockeye sense has been continuous since. It was chinook that renamed — Healey (1991) designates the chinook form ocean-type, glossing it as Gilbert&apos;s sea-type — so a chinook ocean-type concept, if ever minted, must be a separate species-scoped IRI and is not a synonym of this one.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/SpawnerStageContext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/SpawnerStageContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:SpawnerStageContext.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/MeasurementContext"/>
        <skos:definition xml:lang="en">Measurement context indicating values refer to spawners or spawning-stage fish.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/MeasurementContextScheme"/>
        <skos:prefLabel xml:lang="en">Spawner stage context</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/StatisticalModifierScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/StatisticalModifierScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary of statistical modifiers stating what a reported value represents across the observations it summarizes (mean, median, minimum, maximum, total, count, peak). A statistical modifier is part of variable identity — daily mean and daily maximum temperature are different variables — unlike a method, which describes the act of measuring.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/CountStatisticalModifier"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/MaximumStatisticalModifier"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/MeanStatisticalModifier"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/MedianStatisticalModifier"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/MinimumStatisticalModifier"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/PeakStatisticalModifier"/>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/TotalStatisticalModifier"/>
        <skos:prefLabel xml:lang="en">Statistical modifier scheme</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/SubyearlingFreshwaterResidence -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/SubyearlingFreshwaterResidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Beacham, T.D. and Withler, R.E. 2017, Population structure of sea-type and lake-type sockeye salmon and kokanee in the Fraser River and Columbia River drainages, PLOS ONE 12(9):e0183713, which states that sea-type juveniles do not spend a winter in fresh water and thus lack a freshwater annulus.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:altLabel xml:lang="en">Subyearling migrant</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/JuvenileFreshwaterResidenceDuration"/>
        <skos:definition xml:lang="en">Juvenile freshwater residence of less than one year: juveniles migrate seaward during their first year, without overwintering in fresh water, and therefore carry no freshwater annulus on the scale.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme"/>
        <skos:prefLabel xml:lang="en">Subyearling freshwater residence</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The freshwater annulus is the operational test, and it is the reason this axis is cut here rather than at some other duration. Two boundaries are easy to get wrong. The incubation winter spent in the gravel as egg and alevin lays down no annulus and does not count against this value. And this value means no freshwater WINTER, not no freshwater rearing: a subyearling migrant may spend weeks or months in flowing water, sloughs, or the estuary first, which is why it can and does carry a value on the rearing habitat axis. A dataset that keys its equivalent category on residency duration rather than on the annulus is therefore measuring something adjacent, not the same thing, and the two usually but not always agree.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/SurvivalOrMortalityContext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/SurvivalOrMortalityContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:SurvivalOrMortalityContext.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/MeasurementContext"/>
        <skos:definition xml:lang="en">Measurement context indicating values represent survival, mortality, or related rates.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/MeasurementContextScheme"/>
        <skos:prefLabel xml:lang="en">Survival or mortality context</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/TerminalPhase -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/TerminalPhase">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:TerminalPhase.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/LifePhase"/>
        <skos:definition xml:lang="en">Phase occurring in terminal areas near river mouths or spawning areas (often including terminal fisheries and local migration to spawning sites).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/LifePhaseScheme"/>
        <skos:prefLabel xml:lang="en">Terminal phase</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/TotalAgeDimension -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/TotalAgeDimension">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology term gcdfo:TotalAgeDimension.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/AgeDimension"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#TotalAgeDimension"/>
        <skos:definition xml:lang="en">Age dimension whose value represents total salmon age under the declared age convention.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeDimensionScheme"/>
        <skos:prefLabel xml:lang="en">Total-age dimension</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/TotalStatisticalModifier -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/TotalStatisticalModifier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://w3id.org/iadopt/ont/StatisticalModifier"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:closeMatch rdf:resource="http://vocabulary.odm2.org/aggregationstatistic/cumulative"/>
        <skos:definition xml:lang="en">The reported value is the sum or cumulative total of the summarized observations, such as an annual total catch or cumulative escapement.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
        <skos:prefLabel xml:lang="en">Total</skos:prefLabel>
        <skos:topConceptOf rdf:resource="https://w3id.org/smn/StatisticalModifierScheme"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/YearBasis -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/YearBasis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology release 0.0.8 term gcdfo:YearBasis, modeled there as a SKOS concept.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:comment xml:lang="en">A fixed year basis may qualify a standalone I-ADOPT variable, while row-varying year coordinates remain Data Cube dimensions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/iadopt/ont/Constraint"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#YearBasis"/>
        <skos:definition xml:lang="en">The biological, assessment, or fishery reference role used to interpret a calendar-year coordinate.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/YearBasisScheme"/>
        <skos:prefLabel xml:lang="en">Year basis</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/YearBasisScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/YearBasisScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from the GC DFO Salmon Ontology release 0.0.8 SKOS year-basis vocabulary.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:definition xml:lang="en">Controlled vocabulary for the biological, assessment, or fishery role that gives meaning to a calendar-year coordinate.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/YearBasis"/>
        <skos:prefLabel xml:lang="en">Year basis scheme</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Calendar representation is not itself a year basis. Use a separate datatype property with an xsd:gYear value for the coordinate.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/YearlingFreshwaterResidence -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/YearlingFreshwaterResidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, whose lake-type juveniles rear in nursery lakes for at least one year and whose river-type juveniles rear in riverine habitat for one to two years.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://doi.org/10.1371/journal.pone.0183713"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:altLabel xml:lang="en">Yearling migrant</skos:altLabel>
        <skos:broader rdf:resource="https://w3id.org/smn/JuvenileFreshwaterResidenceDuration"/>
        <skos:definition xml:lang="en">Juvenile freshwater residence of one year or more: juveniles overwinter at least once in fresh water before migrating seaward, and therefore carry at least one freshwater annulus on the scale.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme"/>
        <skos:prefLabel xml:lang="en">Yearling or older freshwater residence</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/broodYear -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/broodYear">
        <rdf:type rdf:resource="http://purl.org/linked-data/cube#DimensionProperty"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/catchYear -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/catchYear">
        <rdf:type rdf:resource="http://purl.org/linked-data/cube#DimensionProperty"/>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/returnYear -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/returnYear">
        <rdf:type rdf:resource="http://purl.org/linked-data/cube#DimensionProperty"/>
    </owl:NamedIndividual>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/ObservingProcedure">
        <rdfs:comment xml:lang="en">Documentation-level bridge only: in salmon data exchange this usually points to a Darwin Core protocol value or a DwC-DP Protocol record, not to an OWL-equivalent class.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://rs.tdwg.org/dwc/terms/protocol"/>
        <rdfs:seeAlso rdf:resource="https://rs.tdwg.org/dwc/dp/terms/Protocol"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/gcdfo/salmon#FisheriesReferencePointLower">
        <skos:closeMatch rdf:resource="https://w3id.org/iadopt/ont/Constraint"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/iadopt/ont/Property">
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/sosa/Property"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/smn/broodYear">
        <obo:IAO_0000115 xml:lang="en">Relates a data record or observation to the calendar year that identifies a salmon cohort by the spawning year of its parents.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Adapted from the Government of Canada Pacific Salmon Glossary definition of brood year.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html"/>
        <qb:concept rdf:resource="https://w3id.org/smn/BroodYearBasis"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">brood year</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#inXSDgYear"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/BroodYearBasis"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/smn/catchYear">
        <obo:IAO_0000115 xml:lang="en">Relates a data record or observation to the calendar year in which the represented fishery catch occurred.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology term gcdfo:CatchYear.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <qb:concept rdf:resource="https://w3id.org/smn/CatchYearBasis"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:label xml:lang="en">catch year</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/2006/time#inXSDgYear"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/smn/CatchYearBasis"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/smn/returnYear">
        <obo:IAO_0000115 xml:lang="en">Relates a data record or observation to the calendar year in which members of a salmon cohort make the adult return relevant to the dataset&apos;s declared location or event.</obo:IAO_0000115>
        <obo:IAO_0000119 xml:lang="en">Pacific Salmon Commission Fraser River Sockeye Salmon Stock-Recruitment Data.</obo:IAO_0000119>
