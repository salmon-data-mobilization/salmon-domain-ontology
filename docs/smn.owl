     -->




    <!-- https://w3id.org/smn/AgeAtMaturityBasis -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/AgeAtMaturityBasis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology term gcdfo:AgeAtMaturityBasis.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/AgeBasis"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#AgeAtMaturityBasis"/>
        <skos:definition xml:lang="en">Age evaluated at biological maturity.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeBasisScheme"/>
        <skos:prefLabel xml:lang="en">Age-at-maturity basis</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/AgeAtReturnBasis -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/AgeAtReturnBasis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology term gcdfo:AgeAtReturnBasis.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/AgeBasis"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#AgeAtReturnBasis"/>
        <skos:definition xml:lang="en">Age evaluated at the adult return event relevant to the dataset.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeBasisScheme"/>
        <skos:prefLabel xml:lang="en">Age-at-return basis</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Document the return location or event separately when it affects interpretation.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/AgeAtSamplingBasis -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/AgeAtSamplingBasis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from GC DFO Salmon Ontology term gcdfo:AgeAtSamplingBasis.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/AgeBasis"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#AgeAtSamplingBasis"/>
        <skos:definition xml:lang="en">Age evaluated at the time of sampling or observation.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeBasisScheme"/>
        <skos:prefLabel xml:lang="en">Age-at-sampling basis</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/AgeBasis -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/AgeBasis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Migrated from GC DFO Salmon Ontology term gcdfo:AgeBasis.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/iadopt/ont/Constraint"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#AgeBasis"/>
        <skos:definition xml:lang="en">The reference event or life-history point at which a salmon age value applies.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeBasisScheme"/>
        <skos:prefLabel xml:lang="en">Age basis</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/AgeBasisScheme -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/AgeBasisScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <obo:IAO_0000119 xml:lang="en">Migrated from GC DFO Salmon Ontology term gcdfo:AgeBasisScheme.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/gcdfo/salmon#AgeBasisScheme"/>
        <skos:definition xml:lang="en">Controlled vocabulary for the reference event or life-history point at which a salmon age applies.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://w3id.org/smn/AgeBasis"/>
        <skos:prefLabel xml:lang="en">Age basis scheme</skos:prefLabel>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/AgeClassValue -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/AgeClassValue">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted and relabeled from GC DFO Salmon Ontology term gcdfo:AgeClassValue.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <rdfs:seeAlso rdf:resource="https://w3id.org/iadopt/ont/Constraint"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#AgeClassValue"/>
        <skos:definition xml:lang="en">An integer-like coordinate used to represent one declared component of salmon age.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/AgeClassValueScheme"/>
        <skos:prefLabel xml:lang="en">Age-class value</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This concept and its narrower values do not identify a brood cohort or year class.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/AgeClassValue1 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/AgeClassValue1">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Migrated and relabeled from GC DFO Salmon Ontology term gcdfo:Age1YearClass.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl"/>
