    <!-- https://w3id.org/smn/BroodYearBasis -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/BroodYearBasis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">Adapted from the Government of Canada Pacific Salmon Glossary definition of brood year.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/smn"/>
        <skos:broader rdf:resource="https://w3id.org/smn/YearBasis"/>
        <skos:closeMatch rdf:resource="http://purl.dataone.org/odo/SALMON_00000520"/>
        <skos:closeMatch rdf:resource="https://w3id.org/gcdfo/salmon#BroodYear"/>
        <skos:definition xml:lang="en">A year-reference basis in which a calendar year identifies a salmon cohort by the spawning year of its parents.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/smn/YearBasisScheme"/>
        <skos:prefLabel xml:lang="en">Brood-year basis</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use smn:broodYear for the xsd:gYear coordinate. The basis concept is not the coordinate value.</skos:scopeNote>
    </owl:NamedIndividual>



    <!-- https://w3id.org/smn/CatchContext -->

    <owl:NamedIndividual rdf:about="https://w3id.org/smn/CatchContext">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <obo:IAO_0000119 xml:lang="en">GC DFO Salmon Ontology release 0.0.8, term smn:CatchContext.</obo:IAO_0000119>
        <dcterms:source rdf:resource="https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"/>
