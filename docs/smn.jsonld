  {
    "@id": "https://w3id.org/smn/StockAssessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000115": [
      {
        "@language": "en",
        "@value": "The scientific process of analyzing data to estimate abundance and productivity across time."
      }
    ],
