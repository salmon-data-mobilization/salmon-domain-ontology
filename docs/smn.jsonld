    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "Pacific Salmon Commission Fraser River Sockeye Salmon Stock-Recruitment Data."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.psc.org/publications/data/fraser-sockeye-stock-recruit-dataset/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
