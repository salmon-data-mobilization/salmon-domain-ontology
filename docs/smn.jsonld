      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/JuvenileFreshwaterResidenceDuration",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "The duration axis is the original scale-reading distinction of Gilbert, C.H. 1913, Age at maturity of the Pacific coast salmon of the genus Oncorhynchus, Bulletin of the United States Bureau of Fisheries 32:1-22. Its modern statement for Sockeye Salmon, in freshwater-annulus terms, is Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://doi.org/10.1371/journal.pone.0183713"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The length of time juveniles of a salmon group remain in fresh water between emergence and seaward migration, expressed as a controlled value."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Juvenile freshwater residence duration"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "The duration axis is the original scale-reading distinction of Gilbert, C.H. 1913, Age at maturity of the Pacific coast salmon of the genus Oncorhynchus, Bulletin of the United States Bureau of Fisheries 32:1-22, whose sea type and stream type separate fish by whether the scale nucleus records a freshwater winter. Its modern statement for Sockeye Salmon, in freshwater-annulus terms, is Beacham, T.D. and Withler, R.E. 2017, Population structure of sea-type and lake-type sockeye salmon and kokanee in the Fraser River and Columbia River drainages, PLOS ONE 12(9):e0183713."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://doi.org/10.1371/journal.pone.0183713"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Controlled vocabulary for the duration axis of juvenile salmon life history: how long juveniles remain in fresh water between emergence and seaward migration."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/smn/JuvenileFreshwaterResidenceDuration"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Juvenile freshwater residence duration scheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Species-neutral by construction. This is an axis a named life-history type is defined from, not a life-history type itself: a value here carries no claim about where juveniles reared, how adults behave, or what genetic structure the group has. It is also not age at maturity, which Healey (1991) treats as tactical variation within a race rather than as race-defining. The scheme is deliberately coarse — a two-valued cut at the first freshwater winter — because that cut is what a scale reader can actually determine: a fish that overwinters in fresh water lays down a freshwater annulus and one that does not, does not."
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/JuvenileRearingHabitat",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "The lake-versus-riverine rearing distinction in Sockeye Salmon is stated by Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://doi.org/10.1371/journal.pone.0183713"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The kind of rearing environment in which juveniles of a salmon group grow before migrating to sea, expressed as a controlled value."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/smn/JuvenileRearingHabitatScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Juvenile rearing habitat"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/smn/JuvenileRearingHabitatScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/JuvenileRearingHabitatScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "The lake-versus-riverine rearing distinction in Sockeye Salmon is stated by Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, which groups the river-type and sea-type forms together on the ground that neither rears in lakes. It is also the cut DFO itself makes: the glossary of Holtby, L.B. and Ciruna, K.A. 2007, DFO Can. Sci. Advis. Sec. Res. Doc. 2007/070, defines the river/ocean-types of sockeye as juveniles adapted to rearing in flowing water instead of lakes."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://doi.org/10.1371/journal.pone.0183713"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Controlled vocabulary for the habitat axis of juvenile salmon life history: the kind of rearing environment juveniles occupy between emergence and seaward migration."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/smn/JuvenileRearingHabitat"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Juvenile rearing habitat scheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Species-neutral by construction, and independent of the duration axis: the same kind of rearing habitat is used by groups that leave in their first year and by groups that stay a year or more, which is why the two axes cross-classify rather than nest. Values are kinds of water, never named water bodies; a property relating a population to an actual lake or river is a different property and is not minted here. Do not populate this scheme with the potamodromous vocabulary adfluvial / fluvial / lacustrine (Rieman and McIntyre 1993), despite lacustrine resembling lake and fluvial resembling river. That vocabulary classifies migration patterns completed within fresh water and treats anadromy as a separate category alongside them, so calling an anadromous Sockeye population adfluvial is a category error. Applying it to non-anadromous Oncorhynchus nerka (kokanee) is defensible and would be a different scheme."
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/LakeRearingHabitat",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, whose lake-type Sockeye Salmon rear in nursery lakes."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://doi.org/10.1371/journal.pone.0183713"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://w3id.org/smn/JuvenileRearingHabitat"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Rearing habitat in which juveniles grow in a lake, typically a nursery lake associated with the spawning tributary."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/smn/JuvenileRearingHabitatScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Lake rearing habitat"
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/Life-HistoryCharacteristic",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A characteristic that can be observed, not a controlled value. Do not use this IRI as the vocabulary identifier for a coded life-history column: the values belong to module 07's smn:LifeHistoryTypeScheme and its two axis schemes, smn:JuvenileFreshwaterResidenceDurationScheme and smn:JuvenileRearingHabitatScheme, and a code list needs a skos:ConceptScheme, not an owl:Class (CONVENTIONS sections 3 and 4)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Life-history characteristic"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/smn/Characteristic"
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/LifeHistoryType",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "Life history is one of the three primary characteristics used to delimit Pacific salmon Conservation Units, alongside ecotypology and genetics. Holtby, L.B. and Ciruna, K.A. 2007. Conservation Units for Pacific Salmon under the Wild Salmon Policy. DFO Canadian Science Advisory Secretariat Research Document 2007/070."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A named, recurring pattern of habitat use and life-cycle timing that distinguishes one group of salmon from another within a single species."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/smn/LifeHistoryTypeScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Life-history type"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "An open vocabulary; the minted narrower concepts cover Sockeye Salmon only, and they are asserted as flat siblings pending a ruling on whether the sea-type and river-type forms should instead be grouped against lake-type. Chinook ocean-type and stream-type are deliberately not minted: the bundle they name is not stable across the species range (Waples et al. 2004 report a deep interior-Columbia division alongside within-basin run-type divergence an order of magnitude smaller, and Moran et al. 2013 find the two-race model does not hold coast-wide), and Healey (1991) states he cannot classify the Sacramento winter run, which pairs stream-type adult behaviour with ocean-type juvenile behaviour. The axis schemes exist so that such a group can be described exactly, one axis at a time, without forcing a named type that does not fit. Run timing is modelled separately as the OWL class smn:Run."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "https://w3id.org/smn/LifeHistoryTypeScheme"
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/LifeHistoryTypeScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "Life history is one of the three primary characteristics used to delimit Pacific salmon Conservation Units, alongside ecotypology and genetics. Holtby, L.B. and Ciruna, K.A. 2007. Conservation Units for Pacific Salmon under the Wild Salmon Policy. DFO Canadian Science Advisory Secretariat Research Document 2007/070."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.dfo-mpo.gc.ca/csas-sccs/publications/resdocs-docrech/2007/2007_070-eng.htm"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Controlled vocabulary of named salmon life-history types. Each concept is scoped to a single species and is defined as a combination of values from the life-history axis schemes rather than as a primitive."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/smn/LifeHistoryType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Life-history type scheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Every named type in this scheme is species-scoped, and a type from one species is never assumed to mean a type from another: sockeye river-type is not chinook stream-type despite the near-identical English. Species is carried on each concept as a dwc:scientificName literal plus a WoRMS dwc:scientificNameID, not as an smn: species concept, and no smn: species concept or class exists to point at (Brett Johnson, 2026-08-24). A flat cross-species enumeration of these names is the failure mode this scheme is shaped to prevent, because the strings are similar enough to merge automatically and wrong to merge. Assertion is at Conservation Unit, population, or stock level, never for an individual fish (Brett Johnson, 2026-08-17), using smn:hasLifeHistory. Cycle line has its own vocabulary, smn:CycleLineScheme; do not add cycle-line values here."
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/LifePhase",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "GC DFO Salmon Ontology release 0.0.8, term smn:LifePhase."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A phase or segment used to stratify salmon measurements by where or when they apply (e.g., ocean phase, terminal phase)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://w3id.org/smn/LifePhaseScheme"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Life phase"
      }
    ]
  },
  {
    "@id": "https://w3id.org/smn/LifePhaseScheme",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000119": [
      {
        "@language": "en",
        "@value": "GC DFO Salmon Ontology release 0.0.8, term smn:LifePhaseScheme."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Controlled vocabulary for life-phase or fishery/migration segment qualifiers used to stratify measurements (e.g., ocean, terminal, mainstem)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "https://w3id.org/smn/LifePhase"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
