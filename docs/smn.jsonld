      },
      {
        "@id": "https://w3id.org/smn/TotalStatisticalModifier"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Statistical modifier scheme"
      }
    ]
  },
