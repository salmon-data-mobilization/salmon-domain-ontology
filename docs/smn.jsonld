      {
        "@language": "en",
        "@value": "A river or stream used as a relatively reliable abundance index for nearby salmon returns due to survey intensity and method quality."
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://www.salmonexplorer.ca/methods/glossary.html"
      }
    ],
