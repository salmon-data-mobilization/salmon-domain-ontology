  {
    "@id": "https://w3id.org/smn/stratifiedByCycleLine",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://purl.obolibrary.org/obo/IAO_0000115": [
      {
        "@language": "en",
        "@value": "Relates a data record or observation carrying a return year to the cycle line that year falls in, as a stratification of the year series only."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The weak, always-safe claim: the subject year belongs to that residue class under the declared year basis. It asserts nothing about reproductive independence and nothing about the fish, which is why it is the correct property for a population with variable age at return such as Fraser Sockeye. Use smn:hasCycleLine, on the population rather than the record, where age at return is invariant and the line really is a lineage. Domain is deliberately omitted for the same reason as on smn:broodYear: the subject may be an observation or a table row."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://w3id.org/smn"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "stratified by cycle line"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://w3id.org/smn/CycleLineScheme"
      },
      {
        "@id": "https://w3id.org/smn/ReturnYearBasis"
      }
    ]
  },
