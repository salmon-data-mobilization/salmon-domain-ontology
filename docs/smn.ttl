###  https://w3id.org/smn/YearlingFreshwaterResidence
smn:YearlingFreshwaterResidence rdf:type owl:NamedIndividual ,
                                         skos:Concept ;
                                obo:IAO_0000119 "Beacham, T.D. and Withler, R.E. 2017, PLOS ONE 12(9):e0183713, whose lake-type juveniles rear in nursery lakes for at least one year and whose river-type juveniles rear in riverine habitat for one to two years."@en ;
                                dcterms:source <https://doi.org/10.1371/journal.pone.0183713> ;
                                rdfs:isDefinedBy <https://w3id.org/smn> ;
                                skos:altLabel "Yearling migrant"@en ;
