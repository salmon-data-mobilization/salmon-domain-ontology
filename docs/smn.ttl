                           skos:altLabel "GR age notation"@en ;
                           skos:broader smn:AgeNotation ;
                           skos:closeMatch <https://w3id.org/gcdfo/salmon#GilbertRichAgeNotation> ;
                           skos:definition "Salmon age notation in which total age is annotated with the freshwater-age component as a subscript-like suffix."@en ;
                           skos:inScheme smn:AgeNotationScheme ;
                           skos:notation "Gilbert-Rich" ;
                           skos:prefLabel "Gilbert-Rich age notation"@en ;
                           skos:scopeNote "For example, an encoded value 42 may decompose to total-age value 4 and freshwater-age value 2 only when the source declares Gilbert-Rich notation. Do not infer that decomposition from a two-digit string alone."@en .


