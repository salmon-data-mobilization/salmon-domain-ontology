@prefix : <https://w3id.org/smn#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/smn> .

<https://w3id.org/smn> rdf:type owl:Ontology ;
                        owl:versionIRI <https://w3id.org/smn/0.0.3> ;
                        dcterms:modified "2026-08-14"^^xsd:date ;
                        rdfs:comment "Primary modular import graph for reusable salmon-domain concepts and cross-ontology alignments. Phase-1/2/3 scaffold and migration baseline."@en ;
                        rdfs:label "Salmon Domain Ontology (modular build)"@en ;
                        owl:priorVersion <https://w3id.org/smn/0.0.3> ;
                        owl:versionInfo "0.0.3" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.obolibrary.org/obo/IAO_0000115
obo:IAO_0000115 rdf:type owl:AnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000119
obo:IAO_0000119 rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://purl.org/linked-data/cube#concept
qb:concept rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#hasTopConcept
skos:hasTopConcept rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#notation
skos:notation rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
skos:topConceptOf rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/RO_0002351
obo:RO_0002351 rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
sosa:hasFeatureOfInterest rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/hasResult
sosa:hasResult rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/observedProperty
sosa:observedProperty rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/resultTime
sosa:resultTime rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/usedProcedure
sosa:usedProcedure rdf:type owl:ObjectProperty .


###  https://w3id.org/smn/basedOn
<https://w3id.org/smn/basedOn> rdf:type owl:ObjectProperty ;
                               rdfs:domain <https://w3id.org/smn/AggregatedMeasurement> ;
                               rdfs:range sosa:Procedure ;
                               rdfs:isDefinedBy <https://w3id.org/smn> ;
                               rdfs:label "based on"@en .


###  https://w3id.org/smn/characteristicFor
<https://w3id.org/smn/characteristicFor> rdf:type owl:ObjectProperty ;
                                         rdfs:domain sosa:Property ;
                                         rdfs:range sosa:FeatureOfInterest ;
                                         rdfs:isDefinedBy <https://w3id.org/smn> ;
                                         rdfs:label "characteristic for"@en .


###  https://w3id.org/smn/demeOf
<https://w3id.org/smn/demeOf> rdf:type owl:ObjectProperty ;
                              owl:inverseOf <https://w3id.org/smn/hasDeme> ;
                              rdfs:domain <https://w3id.org/smn/Deme> ;
                              rdfs:range <https://w3id.org/smn/Population> ;
                              obo:IAO_0000115 "Relates a deme to the population it belongs to."@en ;
                              obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:demeOf."@en ;
                              dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
                              rdfs:isDefinedBy <https://w3id.org/smn> ;
                              rdfs:label "deme of"@en .


###  https://w3id.org/smn/hasDeme
<https://w3id.org/smn/hasDeme> rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf obo:RO_0002351 ;
                               rdfs:domain <https://w3id.org/smn/Population> ;
                               rdfs:range <https://w3id.org/smn/Deme> ;
                               obo:IAO_0000115 "Relates a population to one of its constituent demes."@en ;
                               obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:hasDeme."@en ;
                               dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
                               rdfs:isDefinedBy <https://w3id.org/smn> ;
                               rdfs:label "has deme"@en .


###  https://w3id.org/smn/hasEventType
<https://w3id.org/smn/hasEventType> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://w3id.org/smn/SamplingEvent> ;
                                    rdfs:range <https://w3id.org/smn/EventType> ;
                                    rdfs:isDefinedBy <https://w3id.org/smn> ;
                                    rdfs:label "has event type"@en .


###  https://w3id.org/smn/hasJuvenileFreshwaterResidenceDuration
<https://w3id.org/smn/hasJuvenileFreshwaterResidenceDuration> rdf:type owl:ObjectProperty ;
                                                              rdfs:range skos:Concept ;
                                                              obo:IAO_0000115 "Relates a named life-history type to its value on the juvenile freshwater residence duration axis: how long juveniles remain in fresh water between emergence and seaward migration."@en ;
                                                              rdfs:comment "A vocabulary-structure property: it records the decomposition that defines that named type rather than an observation about any fish. Domain is omitted rather than asserted as skos:Concept, which would be true of every concept in module 07 and therefore say nothing. The name carries \"duration\" because without it the property reads as whether the group has a freshwater residence at all, which is true of every anadromous salmon and therefore says nothing; it carries \"juvenile\" because adults also reside in fresh water, on a migration this axis does not measure."@en ;
                                                              rdfs:isDefinedBy <https://w3id.org/smn> ;
                                                              rdfs:label "has juvenile freshwater residence duration"@en ;
                                                              rdfs:seeAlso <https://w3id.org/smn/JuvenileFreshwaterResidenceDurationScheme> .


###  https://w3id.org/smn/hasJuvenileRearingHabitat
<https://w3id.org/smn/hasJuvenileRearingHabitat> rdf:type owl:ObjectProperty ;
                                                 rdfs:range skos:Concept ;
                                                 obo:IAO_0000115 "Relates a named life-history type to its value on the juvenile rearing habitat axis: the kind of rearing environment in which juveniles grow before migrating to sea."@en ;
                                                 rdfs:comment "A vocabulary-structure property, like smn:hasJuvenileFreshwaterResidenceDuration. The value is a kind of water, never a named water body: smn:hasJuvenileRearingHabitat asserts lake-versus-flowing-water, and the unqualified name a future property relating a population to an actual lake or river would want is deliberately left free. \"Rearing\" rather than \"nursery\" because the salmon literature applies \"nursery\" to freshwater lakes and to estuaries alike, so the word does not say which kind of water is meant."@en ;
                                                 rdfs:isDefinedBy <https://w3id.org/smn> ;
                                                 rdfs:label "has juvenile rearing habitat"@en ;
                                                 rdfs:seeAlso <https://w3id.org/smn/JuvenileRearingHabitatScheme> .


###  https://w3id.org/smn/hasMeasurement
<https://w3id.org/smn/hasMeasurement> rdf:type owl:ObjectProperty ;
                                      rdfs:domain sosa:FeatureOfInterest ;
                                      rdfs:range <https://w3id.org/smn/Measurement> ;
                                      rdfs:isDefinedBy <https://w3id.org/smn> ;
                                      rdfs:label "has measurement"@en .


###  https://w3id.org/smn/hasPopulation
<https://w3id.org/smn/hasPopulation> rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf obo:RO_0002351 ;
                                     owl:inverseOf <https://w3id.org/smn/populationOf> ;
                                     rdfs:domain <https://w3id.org/smn/ReportingOrManagementStratum> ;
                                     rdfs:range <https://w3id.org/smn/Population> ;
                                     obo:IAO_0000115 "Relates a reporting or management stratum to one of its constituent populations."@en ;
                                     rdfs:isDefinedBy <https://w3id.org/smn> ;
                                     rdfs:label "has population"@en .


###  https://w3id.org/smn/observedTaxonFamily
<https://w3id.org/smn/observedTaxonFamily> rdf:type owl:ObjectProperty ;
                                           rdfs:domain sosa:Observation ;
                                           rdfs:range obo:NCBITaxon_8015 ;
                                           rdfs:isDefinedBy <https://w3id.org/smn> ;
                                           rdfs:label "observed taxon family"@en .


###  https://w3id.org/smn/observedTaxonSpecies
<https://w3id.org/smn/observedTaxonSpecies> rdf:type owl:ObjectProperty ;
                                            rdfs:domain sosa:Observation ;
                                            rdfs:range obo:NCBITaxon_8018 ;
                                            rdfs:isDefinedBy <https://w3id.org/smn> ;
                                            rdfs:label "observed taxon species"@en .


###  https://w3id.org/smn/populationOf
<https://w3id.org/smn/populationOf> rdf:type owl:ObjectProperty ;
                                    rdfs:domain <https://w3id.org/smn/Population> ;
                                    rdfs:range <https://w3id.org/smn/ReportingOrManagementStratum> ;
                                    obo:IAO_0000115 "Relates a population to the reporting or management stratum it belongs to."@en ;
                                    rdfs:isDefinedBy <https://w3id.org/smn> ;
                                    rdfs:label "population of"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/smn/broodYear
<https://w3id.org/smn/broodYear> rdf:type owl:DatatypeProperty ;
                                 rdfs:range xsd:gYear .


###  https://w3id.org/smn/catchYear
<https://w3id.org/smn/catchYear> rdf:type owl:DatatypeProperty ;
                                 rdfs:range xsd:gYear .


###  https://w3id.org/smn/returnYear
<https://w3id.org/smn/returnYear> rdf:type owl:DatatypeProperty ;
                                  rdfs:range xsd:gYear .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000015
obo:BFO_0000015 rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/IAO_0000030
obo:IAO_0000030 rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/IAO_0000109
obo:IAO_0000109 rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/NCBITaxon_8015
obo:NCBITaxon_8015 rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/NCBITaxon_8018
obo:NCBITaxon_8018 rdf:type owl:Class ;
                   rdfs:subClassOf obo:NCBITaxon_8015 .


###  http://purl.org/linked-data/cube#DimensionProperty
qb:DimensionProperty rdf:type owl:Class .


###  http://rs.tdwg.org/dwc/terms/Event
<http://rs.tdwg.org/dwc/terms/Event> rdf:type owl:Class .


###  http://rs.tdwg.org/dwc/terms/Organism
<http://rs.tdwg.org/dwc/terms/Organism> rdf:type owl:Class .


###  http://www.opengis.net/ont/geosparql#Feature
geo:Feature rdf:type owl:Class ;
            rdfs:subClassOf sosa:FeatureOfInterest .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class .


###  http://www.w3.org/2006/time#Instant
time:Instant rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/FeatureOfInterest
sosa:FeatureOfInterest rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Observation
sosa:Observation rdf:type owl:Class ;
                 skos:closeMatch <http://rs.tdwg.org/dwc/terms/Occurrence> .


###  http://www.w3.org/ns/sosa/Procedure
sosa:Procedure rdf:type owl:Class ;
               skos:closeMatch <https://rs.tdwg.org/dwc/dp/terms/Protocol> .


###  http://www.w3.org/ns/sosa/Property
sosa:Property rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Sample
sosa:Sample rdf:type owl:Class ;
            skos:closeMatch <http://rs.tdwg.org/dwc/terms/MaterialEntity> ,
                            <http://rs.tdwg.org/dwc/terms/MaterialSample> .


###  http://www.w3.org/ns/sosa/Sampling
sosa:Sampling rdf:type owl:Class ;
              skos:broadMatch <http://rs.tdwg.org/dwc/terms/Event> .


###  https://w3id.org/iadopt/ont/Constraint
<https://w3id.org/iadopt/ont/Constraint> rdf:type owl:Class .


###  https://w3id.org/iadopt/ont/Entity
<https://w3id.org/iadopt/ont/Entity> rdf:type owl:Class ;
                                     skos:closeMatch sosa:FeatureOfInterest .


###  https://w3id.org/iadopt/ont/StatisticalModifier
<https://w3id.org/iadopt/ont/StatisticalModifier> rdf:type owl:Class .


###  https://w3id.org/iadopt/ont/Variable
<https://w3id.org/iadopt/ont/Variable> rdf:type owl:Class ;
                                       skos:closeMatch sosa:ObservableProperty .


###  https://w3id.org/smn/Abundance
<https://w3id.org/smn/Abundance> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/smn/Characteristic> ;
                                 obo:IAO_0000115 "A characteristic representing the quantity of salmon or other organisms associated with a defined entity, place, and time."@en ;
                                 dcterms:source <http://qudt.org/vocab/quantitykind/Population> ;
                                 rdfs:comment "Use units, statistical modifiers, measurement context, and procedures to distinguish absolute counts, relative indices, estimates, expansions, and other representations. Those qualifiers do not change the reusable characteristic into a compound OWL class."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/smn> ;
                                 rdfs:label "Abundance"@en ;
                                 rdfs:seeAlso <http://rs.tdwg.org/dwc/terms/individualCount> ;
                                 skos:broadMatch <http://qudt.org/vocab/quantitykind/Count> ;
                                 skos:closeMatch <http://qudt.org/vocab/quantitykind/Population> .


###  https://w3id.org/smn/AggregatedMeasurement
<https://w3id.org/smn/AggregatedMeasurement> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/smn/Measurement> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://w3id.org/smn/basedOn> ;
                                                               owl:someValuesFrom sosa:Procedure
                                                             ] ;
                                             rdfs:comment "The based-on restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration. The specific constraint — values must be method concepts at or below smn:EnumerationMethod in smn:MethodScheme — is normative and lives in ontology/shapes/method-shapes.ttl (smn:AggregatedMeasurementShape), expressed as a skos:broader* path, since someValuesFrom cannot range over concept individuals."@en ;
                                             rdfs:isDefinedBy <https://w3id.org/smn> ;
                                             rdfs:label "Aggregated measurement"@en .


###  https://w3id.org/smn/BodyShape
<https://w3id.org/smn/BodyShape> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/smn/Characteristic> ;
                                 rdfs:isDefinedBy <https://w3id.org/smn> ;
                                 rdfs:label "Body shape"@en .


###  https://w3id.org/smn/CatchAbundance
<https://w3id.org/smn/CatchAbundance> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/smn/ObservedRateOrAbundance> ;
                                      obo:IAO_0000115 "A measurement datum recording the number of salmon represented in fishery catch for a defined fishery, place, time, or stock context."@en ;
                                      obo:IAO_0000119 "Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html."@en ;
                                      dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
                                      rdfs:isDefinedBy <https://w3id.org/smn> ;
                                      rdfs:label "Catch abundance"@en ;
                                      rdfs:seeAlso <https://w3id.org/smn/Abundance> ,
                                                   <https://w3id.org/smn/CatchYearBasis> ,
                                                   <https://w3id.org/smn/catchYear> .


###  https://w3id.org/smn/Characteristic
<https://w3id.org/smn/Characteristic> rdf:type owl:Class ;
                                      rdfs:subClassOf sosa:Property ;
                                      rdfs:isDefinedBy <https://w3id.org/smn> ;
                                      rdfs:label "Characteristic"@en .


###  https://w3id.org/smn/DataQualityAssessment
<https://w3id.org/smn/DataQualityAssessment> rdf:type owl:Class ;
                                             rdfs:subClassOf obo:IAO_0000030 ;
                                             obo:IAO_0000115 "An assessment artifact describing confidence, uncertainty, and quality constraints for a salmon data product or metric."@en ;
                                             rdfs:isDefinedBy <https://w3id.org/smn> ;
                                             rdfs:label "Data quality assessment"@en .


###  https://w3id.org/smn/Deme
<https://w3id.org/smn/Deme> rdf:type owl:Class ;
                            rdfs:subClassOf <http://rs.tdwg.org/dwc/terms/Organism> ;
                            obo:IAO_0000115 "A local interbreeding group of organisms within a species. In salmon, a deme typically corresponds to a spawning population at a specific site. Demes are the finest biological unit and make up populations."@en ;
                            obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:Deme."@en ;
                            dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
                            rdfs:isDefinedBy <https://w3id.org/smn> ;
                            rdfs:label "Deme"@en .


###  https://w3id.org/smn/Entity
<https://w3id.org/smn/Entity> rdf:type owl:Class ;
                              rdfs:subClassOf sosa:FeatureOfInterest ,
                                              <https://w3id.org/iadopt/ont/Entity> ;
                              rdfs:isDefinedBy <https://w3id.org/smn> ;
                              rdfs:label "Entity"@en .


###  https://w3id.org/smn/Escapement
<https://w3id.org/smn/Escapement> rdf:type owl:Class ;
                                  rdfs:subClassOf obo:BFO_0000015 ;
                                  obo:IAO_0000115 "The number of mature salmon that pass through (or escape) fisheries and return to fresh water to spawn."@en ;
                                  obo:IAO_0000119 "Fisheries and Oceans Canada. 2005. Canada's Policy for Conservation of Wild Pacific Salmon. https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/315577.pdf."@en ;
                                  dcterms:source <https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/315577.pdf> ;
                                  rdfs:isDefinedBy <https://w3id.org/smn> ;
                                  rdfs:label "Escapement"@en .


###  https://w3id.org/smn/EscapementEstimate
<https://w3id.org/smn/EscapementEstimate> rdf:type owl:Class ;
                                          rdfs:subClassOf obo:IAO_0000109 ;
                                          obo:IAO_0000115 "A measurement or estimate of escapement tied to a stock and a survey event."@en ;
                                          obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:EscapementMeasurement."@en ;
                                          dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
                                          rdfs:comment "A datum (IAO measurement datum), not an activity: the corresponding survey activity is smn:EscapementSurveyEvent. Renamed from smn:EscapementMeasurement on 2026-08-13 (alignment pass, finding F6) because every other *Measurement class in this module is a subclass of the activity smn:Measurement, and this one is not — the name was the defect, inherited verbatim from gcdfo:EscapementMeasurement, whose hyponym family should be coordinated in the boundary pass."@en ;
                                          rdfs:isDefinedBy <https://w3id.org/smn> ;
                                          rdfs:label "Escapement estimate"@en ;
                                          skos:closeMatch sosa:Result .


###  https://w3id.org/smn/EscapementSurveyEvent
<https://w3id.org/smn/EscapementSurveyEvent> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/smn/SurveyEvent> ;
                                             obo:IAO_0000115 "A survey event specifically for estimating escapement."@en ;
                                             obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:EscapementSurveyEvent."@en ;
                                             dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
                                             rdfs:isDefinedBy <https://w3id.org/smn> ;
                                             rdfs:label "Escapement survey event"@en ;
                                             skos:closeMatch sosa:Sampling .


###  https://w3id.org/smn/EventType
<https://w3id.org/smn/EventType> rdf:type owl:Class ;
                                 obo:IAO_0000115 "A class used to categorize fisheries or survey event instances by operational type."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/smn> ;
                                 rdfs:label "Event type"@en .


###  https://w3id.org/smn/ExploitationRate
<https://w3id.org/smn/ExploitationRate> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/smn/TargetOrLimitRateOrAbundance> ;
                                        obo:IAO_0000115 "The proportion of returning adult salmon removed by fishing activity over a defined period."@en ;
                                        obo:IAO_0000119 "Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html."@en ;
                                        dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
                                        rdfs:isDefinedBy <https://w3id.org/smn> ;
                                        rdfs:label "Exploitation rate"@en .


###  https://w3id.org/smn/FishLength
