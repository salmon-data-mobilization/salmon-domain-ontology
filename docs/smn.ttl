#################################################################
#    Individuals
#################################################################

###  https://w3id.org/smn/AgeAtMaturityBasis
smn:AgeAtMaturityBasis rdf:type owl:NamedIndividual ,
                                skos:Concept ;
                       obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology term gcdfo:AgeAtMaturityBasis."@en ;
                       dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
                       rdfs:isDefinedBy <https://w3id.org/smn> ;
                       skos:broader smn:AgeBasis ;
                       skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeAtMaturityBasis> ;
                       skos:definition "Age evaluated at biological maturity."@en ;
                       skos:inScheme smn:AgeBasisScheme ;
                       skos:prefLabel "Age-at-maturity basis"@en .


###  https://w3id.org/smn/AgeAtReturnBasis
smn:AgeAtReturnBasis rdf:type owl:NamedIndividual ,
                              skos:Concept ;
                     obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology term gcdfo:AgeAtReturnBasis."@en ;
                     dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
                     rdfs:isDefinedBy <https://w3id.org/smn> ;
                     skos:broader smn:AgeBasis ;
                     skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeAtReturnBasis> ;
                     skos:definition "Age evaluated at the adult return event relevant to the dataset."@en ;
                     skos:inScheme smn:AgeBasisScheme ;
                     skos:prefLabel "Age-at-return basis"@en ;
                     skos:scopeNote "Document the return location or event separately when it affects interpretation."@en .


###  https://w3id.org/smn/AgeAtSamplingBasis
smn:AgeAtSamplingBasis rdf:type owl:NamedIndividual ,
                                skos:Concept ;
                       obo:IAO_0000119 "Adapted from GC DFO Salmon Ontology term gcdfo:AgeAtSamplingBasis."@en ;
                       dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> ;
                       rdfs:isDefinedBy <https://w3id.org/smn> ;
                       skos:broader smn:AgeBasis ;
                       skos:closeMatch <https://w3id.org/gcdfo/salmon#AgeAtSamplingBasis> ;
                       skos:definition "Age evaluated at the time of sampling or observation."@en ;
