@prefix : <https://w3id.org/smn#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix dwc: <http://rs.tdwg.org/dwc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix smn: <https://w3id.org/smn/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://w3id.org/smn> .

<https://w3id.org/smn> rdf:type owl:Ontology ;
                        owl:versionIRI <https://w3id.org/smn/0.0.3> ;
                        dcterms:modified "2026-08-14"^^xsd:date ;
                        rdfs:comment "Primary modular import graph for reusable salmon-domain concepts and cross-ontology alignments. Phase-1/2/3 scaffold and migration baseline."@en ;
                        rdfs:label "Salmon Domain Ontology (modular build)"@en ;
                        owl:priorVersion <https://w3id.org/smn/0.0.3> ;
                        owl:versionInfo "0.0.3" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.obolibrary.org/obo/IAO_0000115
obo:IAO_0000115 rdf:type owl:AnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000119
obo:IAO_0000119 rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://purl.org/linked-data/cube#concept
qb:concept rdf:type owl:AnnotationProperty .


###  http://rs.tdwg.org/dwc/terms/scientificName
dwc:scientificName rdf:type owl:AnnotationProperty .


###  http://rs.tdwg.org/dwc/terms/scientificNameID
dwc:scientificNameID rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#hasTopConcept
skos:hasTopConcept rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#historyNote
skos:historyNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#notation
skos:notation rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
skos:topConceptOf rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/RO_0002351
obo:RO_0002351 rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
sosa:hasFeatureOfInterest rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/hasResult
sosa:hasResult rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/observedProperty
sosa:observedProperty rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/resultTime
sosa:resultTime rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/usedProcedure
sosa:usedProcedure rdf:type owl:ObjectProperty .


###  https://w3id.org/smn/basedOn
smn:basedOn rdf:type owl:ObjectProperty ;
            rdfs:domain smn:AggregatedMeasurement ;
            rdfs:range sosa:Procedure ;
            rdfs:isDefinedBy <https://w3id.org/smn> ;
            rdfs:label "based on"@en .


###  https://w3id.org/smn/characteristicFor
smn:characteristicFor rdf:type owl:ObjectProperty ;
                      rdfs:domain sosa:Property ;
                      rdfs:range sosa:FeatureOfInterest ;
                      rdfs:isDefinedBy <https://w3id.org/smn> ;
                      rdfs:label "characteristic for"@en .


###  https://w3id.org/smn/demeOf
smn:demeOf rdf:type owl:ObjectProperty ;
           owl:inverseOf smn:hasDeme ;
           rdfs:domain smn:Deme ;
           rdfs:range smn:Population ;
           obo:IAO_0000115 "Relates a deme to the population it belongs to."@en ;
           obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:demeOf."@en ;
           dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
           rdfs:isDefinedBy <https://w3id.org/smn> ;
           rdfs:label "deme of"@en .


###  https://w3id.org/smn/hasCycleLine
smn:hasCycleLine rdf:type owl:ObjectProperty ;
                 rdfs:range skos:Concept ;
                 obo:IAO_0000115 "Relates a Conservation Unit, population, or stock whose age at return is invariant to the cycle line that constitutes it as a reproductive lineage."@en ;
                 rdfs:comment "This property makes the strong claim: the year series is closed under reproduction, so the line is a lineage and not merely a stratification. It is valid only where age at return is invariant — Pink Salmon, which return at age 2. Assigning a line to an individual fish is likewise only valid under that same invariance. Where age at return varies, as in Fraser Sockeye, use smn:stratifiedByCycleLine on the return-year record instead; a fish spawned on one line can return on another, so the class is not closed and the claim would be false."@en ;
                 rdfs:isDefinedBy <https://w3id.org/smn> ;
                 rdfs:label "has cycle line"@en ;
                 rdfs:seeAlso smn:CycleLineScheme .


###  https://w3id.org/smn/hasDeme
smn:hasDeme rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf obo:RO_0002351 ;
            rdfs:domain smn:Population ;
            rdfs:range smn:Deme ;
            obo:IAO_0000115 "Relates a population to one of its constituent demes."@en ;
            obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:hasDeme."@en ;
            dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
            rdfs:isDefinedBy <https://w3id.org/smn> ;
            rdfs:label "has deme"@en .


###  https://w3id.org/smn/hasEventType
smn:hasEventType rdf:type owl:ObjectProperty ;
                 rdfs:domain smn:SamplingEvent ;
                 rdfs:range smn:EventType ;
                 rdfs:isDefinedBy <https://w3id.org/smn> ;
                 rdfs:label "has event type"@en .


###  https://w3id.org/smn/hasJuvenileFreshwaterResidenceDuration
smn:hasJuvenileFreshwaterResidenceDuration rdf:type owl:ObjectProperty ;
                                           rdfs:range skos:Concept ;
                                           obo:IAO_0000115 "Relates a named life-history type to its value on the juvenile freshwater residence duration axis: how long juveniles remain in fresh water between emergence and seaward migration."@en ;
                                           rdfs:comment "A vocabulary-structure property: its subject is a concept in smn:LifeHistoryTypeScheme, and it records the decomposition that defines that named type rather than an observation about any fish. Domain is omitted rather than asserted as skos:Concept, which would be true of every concept in module 07 and therefore say nothing. The name carries \"duration\" because without it the property reads as whether the group has a freshwater residence at all, which is true of every anadromous salmon and therefore says nothing; it carries \"juvenile\" because adults also reside in fresh water, on a migration this axis does not measure."@en ;
                                           rdfs:isDefinedBy <https://w3id.org/smn> ;
                                           rdfs:label "has juvenile freshwater residence duration"@en ;
                                           rdfs:seeAlso smn:JuvenileFreshwaterResidenceDurationScheme .


###  https://w3id.org/smn/hasJuvenileRearingHabitat
smn:hasJuvenileRearingHabitat rdf:type owl:ObjectProperty ;
                              rdfs:range skos:Concept ;
                              obo:IAO_0000115 "Relates a named life-history type to its value on the juvenile rearing habitat axis: the kind of fresh water in which juveniles rear before migrating to sea."@en ;
                              rdfs:comment "A vocabulary-structure property, like smn:hasJuvenileFreshwaterResidenceDuration. The value is a kind of water, never a named water body: smn:hasJuvenileRearingHabitat asserts lake-versus-flowing-water, and the unqualified name a future property relating a population to an actual lake or river would want is deliberately left free. \"Rearing\" rather than \"nursery\" because rearing habitat is the settled term for the juvenile freshwater growth phase in the Pacific salmon literature, while nursery area carries a distinct, largely marine and estuarine sense. A named type may carry no value on this axis: smn:SockeyeSeaTypeLifeHistory does not."@en ;
                              rdfs:isDefinedBy <https://w3id.org/smn> ;
                              rdfs:label "has juvenile rearing habitat"@en ;
                              rdfs:seeAlso smn:JuvenileRearingHabitatScheme .


###  https://w3id.org/smn/hasLifeHistory
smn:hasLifeHistory rdf:type owl:ObjectProperty ;
                   rdfs:range skos:Concept ;
                   obo:IAO_0000115 "Relates a Conservation Unit, population, or stock to a named life-history type from smn:LifeHistoryTypeScheme."@en ;
                   rdfs:comment "One of the three life-history properties (Brett Johnson, 2026-08-24): this one assigns a named type, and smn:hasJuvenileFreshwaterResidenceDuration and smn:hasJuvenileRearingHabitat decompose what that type means. No generic axis-value property is minted. Assertion is at Conservation Unit, population, or stock level, not for an individual fish (Brett Johnson, 2026-08-17). The range is skos:Concept because the values are SKOS concepts; take them from smn:LifeHistoryTypeScheme, whose members are species-scoped."@en ;
                   rdfs:isDefinedBy <https://w3id.org/smn> ;
                   rdfs:label "has life history"@en ;
                   rdfs:seeAlso smn:LifeHistoryTypeScheme .


###  https://w3id.org/smn/hasMeasurement
smn:hasMeasurement rdf:type owl:ObjectProperty ;
                   rdfs:domain sosa:FeatureOfInterest ;
                   rdfs:range smn:Measurement ;
                   rdfs:isDefinedBy <https://w3id.org/smn> ;
                   rdfs:label "has measurement"@en .


###  https://w3id.org/smn/hasPopulation
smn:hasPopulation rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf obo:RO_0002351 ;
                  owl:inverseOf smn:populationOf ;
                  rdfs:domain smn:ReportingOrManagementStratum ;
                  rdfs:range smn:Population ;
                  obo:IAO_0000115 "Relates a reporting or management stratum to one of its constituent populations."@en ;
                  rdfs:isDefinedBy <https://w3id.org/smn> ;
                  rdfs:label "has population"@en .


###  https://w3id.org/smn/observedTaxonFamily
smn:observedTaxonFamily rdf:type owl:ObjectProperty ;
                        rdfs:domain sosa:Observation ;
                        rdfs:range obo:NCBITaxon_8015 ;
                        rdfs:isDefinedBy <https://w3id.org/smn> ;
                        rdfs:label "observed taxon family"@en .


###  https://w3id.org/smn/observedTaxonSpecies
smn:observedTaxonSpecies rdf:type owl:ObjectProperty ;
                         rdfs:domain sosa:Observation ;
                         rdfs:range obo:NCBITaxon_8018 ;
                         rdfs:isDefinedBy <https://w3id.org/smn> ;
                         rdfs:label "observed taxon species"@en .


###  https://w3id.org/smn/populationOf
smn:populationOf rdf:type owl:ObjectProperty ;
                 rdfs:domain smn:Population ;
                 rdfs:range smn:ReportingOrManagementStratum ;
                 obo:IAO_0000115 "Relates a population to the reporting or management stratum it belongs to."@en ;
                 rdfs:isDefinedBy <https://w3id.org/smn> ;
                 rdfs:label "population of"@en .


###  https://w3id.org/smn/stratifiedByCycleLine
smn:stratifiedByCycleLine rdf:type owl:ObjectProperty ;
                          rdfs:range skos:Concept ;
                          obo:IAO_0000115 "Relates a data record or observation carrying a return year to the cycle line that year falls in, as a stratification of the year series only."@en ;
                          rdfs:comment "The weak, always-safe claim: the subject year belongs to that residue class under the declared year basis. It asserts nothing about reproductive independence and nothing about the fish, which is why it is the correct property for a population with variable age at return such as Fraser Sockeye. Use smn:hasCycleLine, on the population rather than the record, where age at return is invariant and the line really is a lineage. Domain is deliberately omitted for the same reason as on smn:broodYear: the subject may be an observation or a table row."@en ;
                          rdfs:isDefinedBy <https://w3id.org/smn> ;
                          rdfs:label "stratified by cycle line"@en ;
                          rdfs:seeAlso smn:CycleLineScheme ,
                                       smn:ReturnYearBasis .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/smn/broodYear
smn:broodYear rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:gYear .


###  https://w3id.org/smn/catchYear
smn:catchYear rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:gYear .


###  https://w3id.org/smn/returnYear
smn:returnYear rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:gYear .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000015
obo:BFO_0000015 rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/IAO_0000030
obo:IAO_0000030 rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/IAO_0000109
obo:IAO_0000109 rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/NCBITaxon_8015
obo:NCBITaxon_8015 rdf:type owl:Class .


###  http://purl.obolibrary.org/obo/NCBITaxon_8018
obo:NCBITaxon_8018 rdf:type owl:Class ;
                   rdfs:subClassOf obo:NCBITaxon_8015 .


###  http://purl.org/linked-data/cube#DimensionProperty
qb:DimensionProperty rdf:type owl:Class .


###  http://rs.tdwg.org/dwc/terms/Event
dwc:Event rdf:type owl:Class .


###  http://rs.tdwg.org/dwc/terms/Organism
dwc:Organism rdf:type owl:Class .


###  http://www.opengis.net/ont/geosparql#Feature
geo:Feature rdf:type owl:Class ;
            rdfs:subClassOf sosa:FeatureOfInterest .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class .


###  http://www.w3.org/2006/time#Instant
time:Instant rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/FeatureOfInterest
sosa:FeatureOfInterest rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Observation
sosa:Observation rdf:type owl:Class ;
                 skos:closeMatch dwc:Occurrence .


###  http://www.w3.org/ns/sosa/Procedure
sosa:Procedure rdf:type owl:Class ;
               skos:closeMatch <https://rs.tdwg.org/dwc/dp/terms/Protocol> .


###  http://www.w3.org/ns/sosa/Property
sosa:Property rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Sample
sosa:Sample rdf:type owl:Class ;
            skos:closeMatch dwc:MaterialEntity ,
                            dwc:MaterialSample .


###  http://www.w3.org/ns/sosa/Sampling
sosa:Sampling rdf:type owl:Class ;
              skos:broadMatch dwc:Event .


###  https://w3id.org/iadopt/ont/Constraint
<https://w3id.org/iadopt/ont/Constraint> rdf:type owl:Class .


###  https://w3id.org/iadopt/ont/Entity
<https://w3id.org/iadopt/ont/Entity> rdf:type owl:Class ;
                                     skos:closeMatch sosa:FeatureOfInterest .


###  https://w3id.org/iadopt/ont/StatisticalModifier
<https://w3id.org/iadopt/ont/StatisticalModifier> rdf:type owl:Class .


###  https://w3id.org/iadopt/ont/Variable
<https://w3id.org/iadopt/ont/Variable> rdf:type owl:Class ;
                                       skos:closeMatch sosa:ObservableProperty .


###  https://w3id.org/smn/Abundance
smn:Abundance rdf:type owl:Class ;
              rdfs:subClassOf smn:Characteristic ;
              obo:IAO_0000115 "A characteristic representing the quantity of salmon or other organisms associated with a defined entity, place, and time."@en ;
              dcterms:source <http://qudt.org/vocab/quantitykind/Population> ;
              rdfs:comment "Use units, statistical modifiers, measurement context, and procedures to distinguish absolute counts, relative indices, estimates, expansions, and other representations. Those qualifiers do not change the reusable characteristic into a compound OWL class."@en ;
              rdfs:isDefinedBy <https://w3id.org/smn> ;
              rdfs:label "Abundance"@en ;
              rdfs:seeAlso dwc:individualCount ;
              skos:broadMatch <http://qudt.org/vocab/quantitykind/Count> ;
              skos:closeMatch <http://qudt.org/vocab/quantitykind/Population> .


###  https://w3id.org/smn/AggregatedMeasurement
smn:AggregatedMeasurement rdf:type owl:Class ;
                          rdfs:subClassOf smn:Measurement ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty smn:basedOn ;
                                            owl:someValuesFrom sosa:Procedure
                                          ] ;
                          rdfs:comment "The based-on restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration. The specific constraint — values must be method concepts at or below smn:EnumerationMethod in smn:MethodScheme — is normative and lives in ontology/shapes/method-shapes.ttl (smn:AggregatedMeasurementShape), expressed as a skos:broader* path, since someValuesFrom cannot range over concept individuals."@en ;
                          rdfs:isDefinedBy <https://w3id.org/smn> ;
                          rdfs:label "Aggregated measurement"@en .


###  https://w3id.org/smn/BodyShape
smn:BodyShape rdf:type owl:Class ;
              rdfs:subClassOf smn:Characteristic ;
              rdfs:isDefinedBy <https://w3id.org/smn> ;
              rdfs:label "Body shape"@en .


###  https://w3id.org/smn/CatchAbundance
smn:CatchAbundance rdf:type owl:Class ;
                   rdfs:subClassOf smn:ObservedRateOrAbundance ;
                   obo:IAO_0000115 "A measurement datum recording the number of salmon represented in fishery catch for a defined fishery, place, time, or stock context."@en ;
                   obo:IAO_0000119 "Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html."@en ;
                   dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
                   rdfs:isDefinedBy <https://w3id.org/smn> ;
                   rdfs:label "Catch abundance"@en ;
                   rdfs:seeAlso smn:Abundance ,
                                smn:CatchYearBasis ,
                                smn:catchYear .


###  https://w3id.org/smn/Characteristic
smn:Characteristic rdf:type owl:Class ;
                   rdfs:subClassOf sosa:Property ;
                   rdfs:isDefinedBy <https://w3id.org/smn> ;
                   rdfs:label "Characteristic"@en .


###  https://w3id.org/smn/DataQualityAssessment
smn:DataQualityAssessment rdf:type owl:Class ;
                          rdfs:subClassOf obo:IAO_0000030 ;
                          obo:IAO_0000115 "An assessment artifact describing confidence, uncertainty, and quality constraints for a salmon data product or metric."@en ;
                          rdfs:isDefinedBy <https://w3id.org/smn> ;
                          rdfs:label "Data quality assessment"@en .


###  https://w3id.org/smn/Deme
smn:Deme rdf:type owl:Class ;
         rdfs:subClassOf dwc:Organism ;
         obo:IAO_0000115 "A local interbreeding group of organisms within a species. In salmon, a deme typically corresponds to a spawning population at a specific site. Demes are the finest biological unit and make up populations."@en ;
         obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:Deme."@en ;
         dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
         rdfs:isDefinedBy <https://w3id.org/smn> ;
         rdfs:label "Deme"@en .


###  https://w3id.org/smn/Entity
smn:Entity rdf:type owl:Class ;
           rdfs:subClassOf sosa:FeatureOfInterest ,
                           <https://w3id.org/iadopt/ont/Entity> ;
           rdfs:isDefinedBy <https://w3id.org/smn> ;
           rdfs:label "Entity"@en .


###  https://w3id.org/smn/Escapement
smn:Escapement rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000015 ;
               obo:IAO_0000115 "The number of mature salmon that pass through (or escape) fisheries and return to fresh water to spawn."@en ;
               obo:IAO_0000119 "Fisheries and Oceans Canada. 2005. Canada's Policy for Conservation of Wild Pacific Salmon. https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/315577.pdf."@en ;
               dcterms:source <https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/315577.pdf> ;
               rdfs:isDefinedBy <https://w3id.org/smn> ;
               rdfs:label "Escapement"@en .


###  https://w3id.org/smn/EscapementEstimate
smn:EscapementEstimate rdf:type owl:Class ;
                       rdfs:subClassOf obo:IAO_0000109 ;
                       obo:IAO_0000115 "A measurement or estimate of escapement tied to a stock and a survey event."@en ;
                       obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:EscapementMeasurement."@en ;
                       dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
                       rdfs:comment "A datum (IAO measurement datum), not an activity: the corresponding survey activity is smn:EscapementSurveyEvent. Renamed from smn:EscapementMeasurement on 2026-08-13 (alignment pass, finding F6) because every other *Measurement class in this module is a subclass of the activity smn:Measurement, and this one is not — the name was the defect, inherited verbatim from gcdfo:EscapementMeasurement, whose hyponym family should be coordinated in the boundary pass."@en ;
                       rdfs:isDefinedBy <https://w3id.org/smn> ;
                       rdfs:label "Escapement estimate"@en ;
                       skos:closeMatch sosa:Result .


###  https://w3id.org/smn/EscapementSurveyEvent
smn:EscapementSurveyEvent rdf:type owl:Class ;
                          rdfs:subClassOf smn:SurveyEvent ;
                          obo:IAO_0000115 "A survey event specifically for estimating escapement."@en ;
                          obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:EscapementSurveyEvent."@en ;
                          dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
                          rdfs:isDefinedBy <https://w3id.org/smn> ;
                          rdfs:label "Escapement survey event"@en ;
                          skos:closeMatch sosa:Sampling .


###  https://w3id.org/smn/EventType
smn:EventType rdf:type owl:Class ;
              obo:IAO_0000115 "A class used to categorize fisheries or survey event instances by operational type."@en ;
              rdfs:isDefinedBy <https://w3id.org/smn> ;
              rdfs:label "Event type"@en .


###  https://w3id.org/smn/ExploitationRate
smn:ExploitationRate rdf:type owl:Class ;
                     rdfs:subClassOf smn:TargetOrLimitRateOrAbundance ;
                     obo:IAO_0000115 "The proportion of returning adult salmon removed by fishing activity over a defined period."@en ;
                     obo:IAO_0000119 "Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html."@en ;
                     dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
                     rdfs:isDefinedBy <https://w3id.org/smn> ;
                     rdfs:label "Exploitation rate"@en .


###  https://w3id.org/smn/FishLength
smn:FishLength rdf:type owl:Class ;
               rdfs:subClassOf smn:MorphologicalCharacteristic ;
               rdfs:isDefinedBy <https://w3id.org/smn> ;
               rdfs:label "Fish length"@en .


###  https://w3id.org/smn/FishLengthMeasurementType
smn:FishLengthMeasurementType rdf:type owl:Class ;
                              rdfs:subClassOf smn:Measurement ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty sosa:observedProperty ;
                                                owl:someValuesFrom smn:FishLength
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty sosa:usedProcedure ;
                                                owl:someValuesFrom sosa:Procedure
                                              ] ;
                              rdfs:comment "The used-procedure restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration: the specific length-method concepts are individuals in module 07's smn:MethodScheme, and someValuesFrom needs a class."@en ;
                              rdfs:isDefinedBy <https://w3id.org/smn> ;
                              rdfs:label "Fish length measurement type"@en .


###  https://w3id.org/smn/FishWeight
smn:FishWeight rdf:type owl:Class ;
               rdfs:subClassOf smn:MorphologicalCharacteristic ;
               rdfs:isDefinedBy <https://w3id.org/smn> ;
               rdfs:label "Fish weight"@en .


###  https://w3id.org/smn/FishingType
smn:FishingType rdf:type owl:Class ;
                rdfs:subClassOf smn:EventType ;
                rdfs:isDefinedBy <https://w3id.org/smn> ;
                rdfs:label "Fishing type"@en .


###  https://w3id.org/smn/ForkLengthMeasurement
smn:ForkLengthMeasurement rdf:type owl:Class ;
                          rdfs:subClassOf smn:FishLengthMeasurementType ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty sosa:observedProperty ;
                                            owl:someValuesFrom smn:forkLength
                                          ] ;
                          rdfs:isDefinedBy <https://w3id.org/smn> ;
                          rdfs:label "Fork-length measurement"@en .


###  https://w3id.org/smn/GeographicFeature
smn:GeographicFeature rdf:type owl:Class ;
                      rdfs:subClassOf geo:Feature ;
                      rdfs:isDefinedBy <https://w3id.org/smn> ;
                      rdfs:label "Geographic feature"@en .


###  https://w3id.org/smn/HabitatUnit
smn:HabitatUnit rdf:type owl:Class ;
                rdfs:subClassOf smn:Entity ;
                rdfs:isDefinedBy <https://w3id.org/smn> ;
                rdfs:label "Habitat unit"@en .


###  https://w3id.org/smn/IndicatorRiver
smn:IndicatorRiver rdf:type owl:Class ;
                   rdfs:subClassOf smn:GeographicFeature ;
                   obo:IAO_0000115 "A river or stream used as a relatively reliable abundance index for nearby salmon returns due to survey intensity and method quality."@en ;
                   dcterms:source <https://www.salmonexplorer.ca/methods/glossary.html> ;
                   rdfs:isDefinedBy <https://w3id.org/smn> ;
                   rdfs:label "Indicator river"@en ;
                   skos:altLabel "Indicator stream"@en ;
                   skos:closeMatch sosa:FeatureOfInterest .


###  https://w3id.org/smn/IndividualMeasurement
smn:IndividualMeasurement rdf:type owl:Class ;
                          rdfs:subClassOf smn:Measurement ;
                          rdfs:isDefinedBy <https://w3id.org/smn> ;
                          rdfs:label "Individual measurement"@en .


###  https://w3id.org/smn/Life-HistoryCharacteristic
smn:Life-HistoryCharacteristic rdf:type owl:Class ;
                               rdfs:subClassOf smn:Characteristic ;
                               rdfs:comment "A characteristic that can be observed, not a controlled value. Do not use this IRI as the vocabulary identifier for a coded life-history column: the values belong to module 07's smn:LifeHistoryTypeScheme and its two axis schemes, smn:JuvenileFreshwaterResidenceDurationScheme and smn:JuvenileRearingHabitatScheme, and a code list needs a skos:ConceptScheme, not an owl:Class (CONVENTIONS sections 3 and 4)."@en ;
                               rdfs:isDefinedBy <https://w3id.org/smn> ;
                               rdfs:label "Life-history characteristic"@en .


###  https://w3id.org/smn/LimitReferencePoint
smn:LimitReferencePoint rdf:type owl:Class ;
                        rdfs:subClassOf smn:ReferencePoint ;
                        obo:IAO_0000115 "A lower threshold indicating stock status where stronger mitigation or rebuilding action is triggered."@en ;
                        obo:IAO_0000119 "Fisheries and Oceans Canada. Introduction to Stock Assessment - Glossary. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html."@en ;
                        dcterms:source <https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html> ;
                        rdfs:isDefinedBy <https://w3id.org/smn> ;
                        rdfs:label "Limit reference point"@en .


###  https://w3id.org/smn/Measurement
smn:Measurement rdf:type owl:Class ;
                rdfs:subClassOf smn:Observation ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty sosa:hasFeatureOfInterest ;
                                  owl:someValuesFrom smn:Entity
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty sosa:observedProperty ;
                                  owl:someValuesFrom smn:Characteristic
                                ] ;
                obo:IAO_0000115 "A salmon-domain observation focused on one feature of interest and one characteristic."@en ;
                rdfs:comment "A salmon-domain observation focused on one feature of interest and one characteristic."@en ;
                rdfs:isDefinedBy <https://w3id.org/smn> ;
                rdfs:label "Measurement"@en .


###  https://w3id.org/smn/MethodDocumentation
smn:MethodDocumentation rdf:type owl:Class ;
                        rdfs:subClassOf obo:IAO_0000030 ;
                        obo:IAO_0000115 "A documented method description linked to how a salmon metric or estimate was produced."@en ;
                        rdfs:isDefinedBy <https://w3id.org/smn> ;
                        rdfs:label "Method documentation"@en .


###  https://w3id.org/smn/MetricBenchmark
smn:MetricBenchmark rdf:type owl:Class ;
                    rdfs:subClassOf obo:IAO_0000030 ;
                    obo:IAO_0000115 "Benchmark value for a metric used to delineate status categories."@en ;
                    obo:IAO_0000119 "Pestal, G., MacDonald, B.L., Grant, S.C.H., and Holt, C.A. 2023. State of the salmon: rapid status assessment approach for Pacific salmon under Canada's Wild Salmon Policy. Canadian Technical Report of Fisheries and Aquatic Sciences 3570."@en ;
                    dcterms:source <https://publications.gc.ca/site/eng/9.928944/publication.html> ;
                    rdfs:isDefinedBy <https://w3id.org/smn> ;
                    rdfs:label "Metric benchmark"@en .


###  https://w3id.org/smn/ModelMeasurement
smn:ModelMeasurement rdf:type owl:Class ;
                     rdfs:subClassOf smn:Measurement ;
                     rdfs:isDefinedBy <https://w3id.org/smn> ;
                     rdfs:label "Model measurement"@en .


###  https://w3id.org/smn/MorphologicalCharacteristic
smn:MorphologicalCharacteristic rdf:type owl:Class ;
                                rdfs:subClassOf smn:Characteristic ;
                                rdfs:isDefinedBy <https://w3id.org/smn> ;
                                rdfs:label "Morphological characteristic"@en .


###  https://w3id.org/smn/NCBITaxon_8018
smn:NCBITaxon_8018 rdf:type owl:Class ;
                   rdfs:subClassOf obo:NCBITaxon_8018 ;
                   rdfs:isDefinedBy <https://w3id.org/smn> ;
                   rdfs:label "Oncorhynchus keta proxy class"@en .


###  https://w3id.org/smn/Observation
smn:Observation rdf:type owl:Class ;
                rdfs:subClassOf sosa:Observation ;
                rdfs:isDefinedBy <https://w3id.org/smn> ;
                rdfs:label "Observation"@en .


###  https://w3id.org/smn/ObservedRateOrAbundance
smn:ObservedRateOrAbundance rdf:type owl:Class ;
                            rdfs:subClassOf obo:IAO_0000109 ;
                            obo:IAO_0000115 "A measurement datum representing an empirically observed rate, count, or abundance derived from monitoring or survey data."@en ;
                            obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:ObservedRateOrAbundance."@en ;
                            dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
                            rdfs:isDefinedBy <https://w3id.org/smn> ;
                            rdfs:label "Observed rate or abundance"@en .


###  https://w3id.org/smn/Population
smn:Population rdf:type owl:Class ;
               rdfs:subClassOf dwc:Organism ;
               obo:IAO_0000115 "A group of organisms of the same species occupying a defined area that interbreed and share a gene pool. In salmon, populations are composed of one or more demes and form the biological basis for Conservation Units."@en ;
               obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.8, term smn:Population."@en ;
               dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.8/gcdfo.ttl> ;
               rdfs:isDefinedBy <https://w3id.org/smn> ;
               rdfs:label "Population"@en .


###  https://w3id.org/smn/RecruitAbundance
smn:RecruitAbundance rdf:type owl:Class ;
                     rdfs:subClassOf smn:ObservedRateOrAbundance ;
                     obo:IAO_0000115 "A measurement datum recording the abundance of recruits contributing to a salmon stock, population, or indicator return series."@en ;
                     obo:IAO_0000119 "Fisheries and Oceans Canada. Pacific Salmon - Glossary (Pacific Region). https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html."@en ;
                     dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> ;
                     rdfs:comment "Represent the measured characteristic with smn:Abundance. Use smn:broodYear and smn:returnYear for row-varying xsd:gYear coordinates, and use the separate SKOS basis concepts when a standalone variable description needs the corresponding fixed semantic qualifier."@en ;
                     rdfs:isDefinedBy <https://w3id.org/smn> ;
                     rdfs:label "Recruit abundance"@en ;
                     rdfs:seeAlso smn:Abundance ,
                                  smn:BroodYearBasis ,
                                  smn:ReturnYearBasis ,
                                  smn:broodYear ,
                                  smn:returnYear .


###  https://w3id.org/smn/ReferencePoint
smn:ReferencePoint rdf:type owl:Class ;
                   rdfs:subClassOf obo:IAO_0000030 ;
                   obo:IAO_0000115 "A target or limit used to guide management actions."@en ;
                   obo:IAO_0000119 "Fisheries and Oceans Canada. Introduction to Stock Assessment - Glossary. https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html."@en ;
                   dcterms:source <https://www.dfo-mpo.gc.ca/science/species-especes/fisheries-halieutiques/assessment-evaluation/glossary-glossaire/index-eng.html> ;
                   rdfs:isDefinedBy <https://w3id.org/smn> ;
                   rdfs:label "Reference point"@en ;
                   skos:closeMatch <https://w3id.org/iadopt/ont/Constraint> .


###  https://w3id.org/smn/ReportingOrManagementStratum
smn:ReportingOrManagementStratum rdf:type owl:Class ;
                                 rdfs:subClassOf obo:IAO_0000030 ;
                                 obo:IAO_0000115 "An information-defined grouping of fish populations used for reporting, conservation assessment, or management purposes. Examples include Conservation Units (CUs), Stock Management Units (MUs), and Designatable Units (DUs)."@en ;
                                 obo:IAO_0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:ReportingOrManagementStratum."@en ;
                                 dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> ;
                                 rdfs:isDefinedBy <https://w3id.org/smn> ;
                                 rdfs:label "Reporting or management stratum"@en ;
                                 skos:closeMatch sosa:FeatureOfInterest .


###  https://w3id.org/smn/Run
smn:Run rdf:type owl:Class ;
        rdfs:subClassOf smn:Life-HistoryCharacteristic ;
        rdfs:isDefinedBy <https://w3id.org/smn> ;
        rdfs:label "Run"@en .


###  https://w3id.org/smn/SalmonGroup
smn:SalmonGroup rdf:type owl:Class ;
                rdfs:subClassOf smn:Entity ;
                rdfs:isDefinedBy <https://w3id.org/smn> ;
                rdfs:label "Salmon group"@en .


