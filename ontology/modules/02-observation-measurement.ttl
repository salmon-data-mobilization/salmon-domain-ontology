@prefix smn: <https://w3id.org/smn/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix dwc: <http://rs.tdwg.org/dwc/terms/> .
@prefix geosparql: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/smn/modules/02-observation-measurement> a owl:Ontology ;
  rdfs:label "Salmon Domain Ontology Module 02: Observation and measurement"@en ;
  rdfs:comment "Observation and measurement model (SOSA-aligned) with reusable abundance, typed year-coordinate properties, escapement, and survey terms."@en .

#################################################################
# Observation and measurement classes (existing salmon-domain terms)
#################################################################

smn:Observation a owl:Class ;
  rdfs:label "Observation"@en ;
  rdfs:subClassOf sosa:Observation ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:Characteristic a owl:Class ;
  rdfs:label "Characteristic"@en ;
  rdfs:subClassOf sosa:Property ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:Abundance a owl:Class ;
  rdfs:label "Abundance"@en ;
  iao:0000115 "A characteristic representing the quantity of salmon or other organisms associated with a defined entity, place, and time."@en ;
  rdfs:comment "Use units, statistical modifiers, measurement context, and procedures to distinguish absolute counts, relative indices, estimates, expansions, and other representations. Those qualifiers do not change the reusable characteristic into a compound OWL class."@en ;
  rdfs:subClassOf smn:Characteristic ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  dcterms:source <http://qudt.org/vocab/quantitykind/Population> .

smn:MorphologicalCharacteristic a owl:Class ;
  rdfs:label "Morphological characteristic"@en ;
  rdfs:subClassOf smn:Characteristic ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:FishLength a owl:Class ;
  rdfs:label "Fish length"@en ;
  rdfs:subClassOf smn:MorphologicalCharacteristic ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:forkLength a owl:Class ;
  rdfs:label "Fork length"@en ;
  rdfs:subClassOf smn:FishLength ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:standardLength a owl:Class ;
  rdfs:label "Standard length"@en ;
  rdfs:subClassOf smn:FishLength ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:totalLength a owl:Class ;
  rdfs:label "Total length"@en ;
  rdfs:subClassOf smn:FishLength ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:orbitalLength a owl:Class ;
  rdfs:label "Orbital length"@en ;
  rdfs:subClassOf smn:FishLength ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:FishWeight a owl:Class ;
  rdfs:label "Fish weight"@en ;
  rdfs:subClassOf smn:MorphologicalCharacteristic ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:BodyShape a owl:Class ;
  rdfs:label "Body shape"@en ;
  rdfs:subClassOf smn:Characteristic ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:SalmonLifeStage a owl:Class ;
  rdfs:label "Salmon life stage"@en ;
  rdfs:subClassOf smn:Characteristic ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:Life-HistoryCharacteristic a owl:Class ;
  rdfs:label "Life-history characteristic"@en ;
  rdfs:comment "A characteristic that can be observed, not a controlled value. Do not use this IRI as the vocabulary identifier for a coded life-history column: the values belong to module 07's smn:LifeHistoryTypeScheme and its two axis schemes, smn:JuvenileFreshwaterResidenceDurationScheme and smn:JuvenileRearingHabitatScheme, and a code list needs a skos:ConceptScheme, not an owl:Class (CONVENTIONS sections 3 and 4)."@en ;
  rdfs:subClassOf smn:Characteristic ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:fusiform a owl:Class ;
  rdfs:label "Fusiform"@en ;
  rdfs:subClassOf smn:BodyShape ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:alevin a owl:Class ;
  rdfs:label "Alevin"@en ;
  rdfs:subClassOf smn:SalmonLifeStage ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:Run a owl:Class ;
  rdfs:label "Run"@en ;
  rdfs:subClassOf smn:Life-HistoryCharacteristic ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

# The six method OWL classes that lived here (smn:EnumerationMethod and
# the fish-length measurement-method family) migrated to SKOS concepts in
# module 07's smn:MethodScheme on 2026-08-13 (alignment pass step 2,
# ordered by Brett: methods are pick-list concepts, not class hierarchies).
# The IRIs are unchanged; each concept is instance-typed sosa:Procedure so
# sosa:usedProcedure stays type-correct (CONVENTIONS section 3,
# instance-typing rule). This also resolves the live cross-repo pun:
# gcdfo already types smn:EnumerationMethod as a skos:Concept, and the
# PSC vocabulary's stated blocker on mapping to smn was exactly that the
# method anchor here was an owl:Class.

smn:Measurement a owl:Class ;
  rdfs:label "Measurement"@en ;
  rdfs:comment "A salmon-domain observation focused on one feature of interest and one characteristic."@en ;
  rdfs:subClassOf smn:Observation ,
    [ a owl:Restriction ;
      owl:onProperty sosa:hasFeatureOfInterest ;
      owl:someValuesFrom smn:Entity ],
    [ a owl:Restriction ;
      owl:onProperty sosa:observedProperty ;
      owl:someValuesFrom smn:Characteristic ] ;
  iao:0000115 "A salmon-domain observation focused on one feature of interest and one characteristic."@en ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:FishLengthMeasurementType a owl:Class ;
  rdfs:label "Fish length measurement type"@en ;
  rdfs:comment "The used-procedure restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration: the specific length-method concepts are individuals in module 07's smn:MethodScheme, and someValuesFrom needs a class."@en ;
  rdfs:subClassOf smn:Measurement ,
    [ a owl:Restriction ;
      owl:onProperty sosa:observedProperty ;
      owl:someValuesFrom smn:FishLength ],
    [ a owl:Restriction ;
      owl:onProperty sosa:usedProcedure ;
      owl:someValuesFrom sosa:Procedure ] ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:ForkLengthMeasurement a owl:Class ;
  rdfs:label "Fork-length measurement"@en ;
  rdfs:subClassOf smn:FishLengthMeasurementType ,
    [ a owl:Restriction ;
      owl:onProperty sosa:observedProperty ;
      owl:someValuesFrom smn:forkLength ] ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:StandardLengthMeasurement a owl:Class ;
  rdfs:label "Standard length measurement"@en ;
  rdfs:subClassOf smn:FishLengthMeasurementType ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:TotalLengthMeasurement a owl:Class ;
  rdfs:label "Total length measurement"@en ;
  rdfs:subClassOf smn:FishLengthMeasurementType ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:IndividualMeasurement a owl:Class ;
  rdfs:label "Individual measurement"@en ;
  rdfs:subClassOf smn:Measurement ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:ModelMeasurement a owl:Class ;
  rdfs:label "Model measurement"@en ;
  rdfs:subClassOf smn:Measurement ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:AggregatedMeasurement a owl:Class ;
  rdfs:label "Aggregated measurement"@en ;
  rdfs:comment "The based-on restriction targets sosa:Procedure since the 2026-08-13 methods-as-SKOS migration. The specific constraint — values must be method concepts at or below smn:EnumerationMethod in smn:MethodScheme — is normative and lives in ontology/shapes/method-shapes.ttl (smn:AggregatedMeasurementShape), expressed as a skos:broader* path, since someValuesFrom cannot range over concept individuals."@en ;
  rdfs:subClassOf smn:Measurement ,
    [ a owl:Restriction ;
      owl:onProperty smn:basedOn ;
      owl:someValuesFrom sosa:Procedure ] ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:SamplingEvent a owl:Class ;
  rdfs:label "Sampling event"@en ;
  rdfs:comment "A sampling activity that targets a geographic feature, yields a sample, and records a time."@en ;
  rdfs:subClassOf sosa:Sampling ,
    [ a owl:Restriction ;
      owl:onProperty sosa:hasFeatureOfInterest ;
      owl:someValuesFrom geosparql:Feature ],
    [ a owl:Restriction ;
      owl:onProperty sosa:hasResult ;
      owl:someValuesFrom sosa:Sample ],
    [ a owl:Restriction ;
      owl:onProperty sosa:resultTime ;
      owl:someValuesFrom time:Instant ] ;
  iao:0000115 "A sampling activity that targets a geographic feature, yields a sample, and records a time."@en ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

# The two class-level property assertions that used to sit here
# (sosa:FeatureOfInterest sosa:hasSample sosa:Sample; sosa:Sample
# sosa:isResultOf sosa:Sampling) were removed 2026-08-13: legal OWL 2 DL
# punning, but they related the class-individuals and said nothing about
# instances. The intended instance-level semantics already live in the
# smn:SamplingEvent restrictions above.

# MIREOT-style mirror of the upstream NCBITaxon hierarchy (Oncorhynchus
# keta under Salmonidae); byte-faithful to the source, not an smn claim.
obo:NCBITaxon_8018 rdfs:subClassOf obo:NCBITaxon_8015 .

smn:NCBITaxon_8018 a owl:Class ;
  rdfs:label "Oncorhynchus keta proxy class"@en ;
  rdfs:subClassOf obo:NCBITaxon_8018 ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

#################################################################
# Reusable escapement and survey terms (migrated from gcdfo)
#################################################################

smn:Escapement a owl:Class ;
  rdfs:label "Escapement"@en ;
  iao:0000115 "The number of mature salmon that pass through (or escape) fisheries and return to fresh water to spawn."@en ;
  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "Fisheries and Oceans Canada. 2005. Canada's Policy for Conservation of Wild Pacific Salmon. https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/315577.pdf."@en ;
  dcterms:source <https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/315577.pdf> .

smn:SurveyEvent a owl:Class ;
  rdfs:label "Survey event"@en ;
  iao:0000115 "A field event that collects information about fish populations to evaluate status and support management decisions."@en ;
  rdfs:subClassOf dwc:Event ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "Fisheries and Oceans Canada. About the Sustainability Survey for Fisheries. https://www.dfo-mpo.gc.ca/reports-rapports/regs/sff-cpd/survey-sondage/about-propos-en.html."@en ;
  dcterms:source <https://www.dfo-mpo.gc.ca/reports-rapports/regs/sff-cpd/survey-sondage/about-propos-en.html> .

smn:EscapementSurveyEvent a owl:Class ;
  rdfs:label "Escapement survey event"@en ;
  iao:0000115 "A survey event specifically for estimating escapement."@en ;
  rdfs:subClassOf smn:SurveyEvent ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:EscapementSurveyEvent."@en ;
  dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> .

smn:EscapementEstimate a owl:Class ;
  rdfs:label "Escapement estimate"@en ;
  iao:0000115 "A measurement or estimate of escapement tied to a stock and a survey event."@en ;
  rdfs:comment "A datum (IAO measurement datum), not an activity: the corresponding survey activity is smn:EscapementSurveyEvent. Renamed from smn:EscapementMeasurement on 2026-08-13 (alignment pass, finding F6) because every other *Measurement class in this module is a subclass of the activity smn:Measurement, and this one is not — the name was the defect, inherited verbatim from gcdfo:EscapementMeasurement, whose hyponym family should be coordinated in the boundary pass."@en ;
  rdfs:subClassOf iao:0000109 ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "GC DFO Salmon Ontology release 0.0.2, term gcdfo:EscapementMeasurement."@en ;
  dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/c7a54251eb8f673052fed61f9ca2624e557249c7/docs/releases/0.0.2/gcdfo.ttl> .

#################################################################
# Properties used by observations and event models
#################################################################

smn:hasMeasurement a owl:ObjectProperty ;
  rdfs:label "has measurement"@en ;
  rdfs:domain sosa:FeatureOfInterest ;
  rdfs:range smn:Measurement ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:observedTaxonFamily a owl:ObjectProperty ;
  rdfs:label "observed taxon family"@en ;
  rdfs:domain sosa:Observation ;
  rdfs:range obo:NCBITaxon_8015 ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:observedTaxonSpecies a owl:ObjectProperty ;
  rdfs:label "observed taxon species"@en ;
  rdfs:domain sosa:Observation ;
  rdfs:range obo:NCBITaxon_8018 ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:hasEventType a owl:ObjectProperty ;
  rdfs:label "has event type"@en ;
  rdfs:domain smn:SamplingEvent ;
  rdfs:range smn:EventType ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:basedOn a owl:ObjectProperty ;
  rdfs:label "based on"@en ;
  rdfs:domain smn:AggregatedMeasurement ;
  rdfs:range sosa:Procedure ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:characteristicFor a owl:ObjectProperty ;
  rdfs:label "characteristic for"@en ;
  rdfs:domain sosa:Property ;
  rdfs:range sosa:FeatureOfInterest ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

#################################################################
# Typed temporal coordinate properties
#################################################################

smn:broodYear a owl:DatatypeProperty ;
  rdfs:label "brood year"@en ;
  iao:0000115 "Relates a data record or observation to the calendar year that identifies a salmon cohort by the spawning year of its parents."@en ;
  rdfs:range xsd:gYear ;
  rdfs:seeAlso smn:BroodYearBasis ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "Adapted from the Government of Canada Pacific Salmon Glossary definition of brood year."@en ;
  dcterms:source <https://www.pac.dfo-mpo.gc.ca/fm-gp/salmon-saumon/gloss-eng.html> .

smn:returnYear a owl:DatatypeProperty ;
  rdfs:label "return year"@en ;
  iao:0000115 "Relates a data record or observation to the calendar year in which members of a salmon cohort make the adult return relevant to the dataset's declared location or event."@en ;
  rdfs:range xsd:gYear ;
  rdfs:seeAlso smn:ReturnYearBasis ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "Pacific Salmon Commission Fraser River Sockeye Salmon Stock-Recruitment Data."@en ;
  dcterms:source <https://www.psc.org/publications/data/fraser-sockeye-stock-recruit-dataset/> .

smn:catchYear a owl:DatatypeProperty ;
  rdfs:label "catch year"@en ;
  iao:0000115 "Relates a data record or observation to the calendar year in which the represented fishery catch occurred."@en ;
  rdfs:range xsd:gYear ;
  rdfs:seeAlso smn:CatchYearBasis ;
  rdfs:isDefinedBy <https://w3id.org/smn> ;
  iao:0000119 "Adapted from GC DFO Salmon Ontology term gcdfo:CatchYear."@en ;
  dcterms:source <https://github.com/dfo-pacific-science/dfo-salmon-ontology/blob/f08133685563bb89deac9c290266e120f277ec68/ontology/dfo-salmon.ttl> .

#################################################################
# Cycle-line stratification and life-history axis decomposition
# (proposed 2026-08-17, revised 2026-08-25 — see
#  docs/adr/0003-life-history-axes-cycle-lines-no-species.md)
#################################################################

smn:stratifiedByCycleLine a owl:ObjectProperty ;
  rdfs:label "stratified by cycle line"@en ;
  iao:0000115 "Relates a data record or observation carrying a return year to the cycle line that year falls in, as a stratification of the year series only."@en ;
  rdfs:range skos:Concept ;
  rdfs:seeAlso smn:CycleLineScheme , smn:ReturnYearBasis ;
  rdfs:comment "The weak, always-safe claim: the subject year belongs to that residue class under the declared year basis. It asserts nothing about reproductive independence and nothing about the fish, which is why it is the correct property for a population with variable age at return such as Fraser Sockeye. Use smn:hasCycleLine, on the population rather than the record, where age at return is invariant and the line really is a lineage. Domain is deliberately omitted for the same reason as on smn:broodYear: the subject may be an observation or a table row."@en ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:hasJuvenileFreshwaterResidenceDuration a owl:ObjectProperty ;
  rdfs:label "has juvenile freshwater residence duration"@en ;
  iao:0000115 "Relates a named life-history type to its value on the juvenile freshwater residence duration axis: how long juveniles remain in fresh water between emergence and seaward migration."@en ;
  rdfs:range skos:Concept ;
  rdfs:seeAlso smn:JuvenileFreshwaterResidenceDurationScheme ;
  rdfs:comment "A vocabulary-structure property: its subject is a concept in smn:LifeHistoryTypeScheme, and it records the decomposition that defines that named type rather than an observation about any fish. Domain is omitted rather than asserted as skos:Concept, which would be true of every concept in module 07 and therefore say nothing. The name carries \"duration\" because without it the property reads as whether the group has a freshwater residence at all, which is true of every anadromous salmon and therefore says nothing; it carries \"juvenile\" because adults also reside in fresh water, on a migration this axis does not measure."@en ;
  rdfs:isDefinedBy <https://w3id.org/smn> .

smn:hasJuvenileRearingHabitat a owl:ObjectProperty ;
  rdfs:label "has juvenile rearing habitat"@en ;
  iao:0000115 "Relates a named life-history type to its value on the juvenile rearing habitat axis: the kind of fresh water in which juveniles rear before migrating to sea."@en ;
  rdfs:range skos:Concept ;
  rdfs:seeAlso smn:JuvenileRearingHabitatScheme ;
  rdfs:comment "A vocabulary-structure property, like smn:hasJuvenileFreshwaterResidenceDuration. The value is a kind of water, never a named water body: smn:hasJuvenileRearingHabitat asserts lake-versus-flowing-water, and the unqualified name a future property relating a population to an actual lake or river would want is deliberately left free. \"Rearing\" rather than \"nursery\" because rearing habitat is the settled term for the juvenile freshwater growth phase in the Pacific salmon literature, while nursery area carries a distinct, largely marine and estuarine sense. A named type may carry no value on this axis: smn:SockeyeSeaTypeLifeHistory does not."@en ;
  rdfs:isDefinedBy <https://w3id.org/smn> .
